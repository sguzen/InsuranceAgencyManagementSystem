# Local run settings for scripts/run-local.sh — copy to scripts/local.env (gitignored) and fill in.
# Values are passed as environment variables, which override appsettings*.json.
#
# Tenant databases are NOT configured here: the API reads each tenant's connection
# string from the master DB (Tenants.ConnectionString). Those must be reachable from
# this machine (check: SELECT Identifier, ConnectionString FROM Tenants).

# --- Databases (all three apps) ---
ConnectionStrings__MasterConnection="Server=<host>,1433;Database=TenantDb;User Id=<user>;Password=<pw>;TrustServerCertificate=True"
# Fallback/default application DB (API when no tenant context; Admin's identity store)
ConnectionStrings__DefaultConnection="Server=<host>,1433;Database=<AppDbOrIAMS>;User Id=<user>;Password=<pw>;TrustServerCertificate=True"
# Admin has no tenant context: its DefaultConnection is the DB holding the admin users
# (on the server its appsettings points at "IAMS"). Uncomment to use a different DB for Admin.
# ADMIN_DefaultConnection="Server=<host>,1433;Database=IAMS;User Id=<user>;Password=<pw>;TrustServerCertificate=True"
ConnectionStrings__IntegrationConnection="Server=<host>,1433;Database=IntegrationDb;User Id=<user>;Password=<pw>;TrustServerCertificate=True"

# --- API key shared by API <-> Web/Admin (must be identical in all three; no repo default —
#     generate one, e.g. `openssl rand -base64 32`) ---
ApiSettings__ApiKey=""

# --- JWT signing secret for the API (min 32 chars; generate with `openssl rand -base64 48`) ---
JwtSettings__Secret=""

# --- Local ports (plain HTTP so Web/Admin can call the API without dev-cert trust on Linux) ---
API_URL="http://localhost:5175"
WEB_URL="http://localhost:5273"
ADMIN_URL="http://localhost:2554"

# --- Tenant to open in the browser: Web resolves the tenant from the subdomain, so use
#     http://<TENANT>.localhost:5273 (browsers resolve *.localhost to 127.0.0.1). ---
TENANT="test"

# Set to false to stop the API from applying master DB scripts to the remote DB on start.
MasterDb__AutoMigrate="true"
