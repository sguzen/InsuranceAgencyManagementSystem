@page "/"
@rendermode InteractiveServer

@using IAMS.Domain.Enums
@using IAMS.Shared.DTOs.Agency
@inject IAgenciesApiClient AgenciesApi
@inject NavigationManager Navigation

<PageTitle>IAMS Yönetim Paneli</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4">Yönetim Paneli</MudText>

        @if (loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <!-- Stats -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo("agencies"))">
                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Large" />
                                <MudText Typo="Typo.h4">@agencies.Count</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Acenta</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                                <MudText Typo="Typo.h4">@agencies.Count(a => a.Status == AgencyStatus.Active)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Aktif Acenta</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Pause" Color="Color.Warning" Size="Size.Large" />
                                <MudText Typo="Typo.h4">@agencies.Count(a => a.Status == AgencyStatus.Suspended)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Askıda</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudStack AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Large" />
                                <MudText Typo="Typo.h4">@agencies.Count(a => a.IsExpired)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Süresi Dolmuş</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Quick Actions -->
            <MudText Typo="Typo.h6" Class="mt-4">Hızlı İşlemler</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Add"
                               Href="agencies"
                               Size="Size.Large"
                               Class="py-4">
                        Yeni Acenta Ekle
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Security"
                               Href="roles"
                               Size="Size.Large"
                               Class="py-4">
                        Rolleri Yönet
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.People"
                               Href="users"
                               Size="Size.Large"
                               Class="py-4">
                        Kullanıcıları Yönet
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- Recent Agencies -->
            @if (agencies.Any())
            {
                <MudText Typo="Typo.h6" Class="mt-4">Son Eklenen Acentalar</MudText>
                <MudCard>
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Acenta</th>
                                    <th>Durum</th>
                                    <th>Abonelik</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agency in agencies.OrderByDescending(a => a.CreatedOn).Take(5))
                                {
                                    <tr>
                                        <td>@agency.Name</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(agency.Status == AgencyStatus.Active ? Color.Success : Color.Warning)"
                                                     Variant="Variant.Filled">
                                                @(agency.Status == AgencyStatus.Active ? "Aktif" : agency.Status.ToString())
                                            </MudChip>
                                        </td>
                                        <td>@agency.SubscriptionType</td>
                                        <td>@agency.CreatedOn.ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            }
        }
    </MudStack>
</MudContainer>

@code {
    private List<AgencyDto> agencies = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var result = await AgenciesApi.GetAgenciesAsync(1, 100);
            if (result.IsSuccess && result.Data != null)
            {
                agencies = result.Data;
            }
        }
        catch
        {
            // Dashboard is best-effort; don't crash
        }
        finally
        {
            loading = false;
        }
    }
}
