{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MasterConnection": "Data Source=localhost;Initial Catalog=TenantDb;Integrated Security=True;Trust Server Certificate=True",
    "DefaultConnection": "Data Source=localhost;Initial Catalog=ApplicationDb;Integrated Security=True;Trust Server Certificate=True",
    "IntegrationConnection": "Data Source=localhost;Initial Catalog=IntegrationDb;Integrated Security=True;Trust Server Certificate=True"
  },
  "TenantConnections": {
    "agency1": "Data Source=localhost;Initial Catalog=Agency1;Integrated Security=True;Trust Server Certificate=True",
    "agency2": "Data Source=localhost;Initial Catalog=Agency2;Integrated Security=True;Trust Server Certificate=True",
    "agency3": "Data Source=localhost;Initial Catalog=Agency3;Integrated Security=True;Trust Server Certificate=True"
  },
  "JwtSettings": {
    // SECURITY: no secret is committed. The API refuses to start when this is empty or
    // shorter than 32 characters.
    // Development: dotnet user-secrets set "JwtSettings:Secret" "<random 32+ chars>"
    // Production:  environment variable JwtSettings__Secret (or a secret store)
    "Secret": "",
    "Issuer": "IAMS.Api",
    "Audience": "IAMS.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "MultiTenancy": {
    "Strategy": "Header", // Header, Subdomain, or Database
    "HeaderName": "X-Tenant-ID",
    // Fallback tenant when nothing else resolves one (single-tenant deployments).
    // Remove/empty to reject requests that cannot be resolved to a tenant.
    "DefaultTenant": "default",
    // When true, any caller may pick the tenant via the X-Tenant-ID header.
    // Development/testing convenience ONLY — must stay false in production, where the
    // header is trusted solely from API-key-authenticated internal services.
    "AllowClientTenantResolution": false
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:44390",
    // SECURITY: shared Web/Admin -> API service key; set via environment variable
    // ApiSettings__ApiKey (or user secrets in development). Startup fails when empty.
    "ApiKey": ""
  },
  "Cors": {
    // Origins allowed to call the API from a browser in non-Development environments.
    // Supports wildcard subdomains for tenant hosts, e.g. "https://*.example.com".
    "AllowedOrigins": []
  },
  "VehicleDataApi": {
    "BaseUrl": "https://test.websuresoft.com/das",
    "TimeoutSeconds": "30"
  },
  "PremiumCalculation": {
    "ExternalCalculationPolicyTypes": [ "TRF" ],
    "FallbackToInternalOnFailure": true,
    "ExternalService": {
      "Enabled": false,
      "BaseUrl": "https://external-calculator-service.example.com",
      "CalculationEndpoint": "/api/premium/calculate",
      "HealthCheckEndpoint": "/api/health",
      "TimeoutSeconds": 30,
      "ApiKey": "",
      "MaxRetryAttempts": 3
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning",
        "IAMS": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/iams-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/iams-json-.json",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "Logging": {
    "SlowRequestThresholdMs": 3000,
    "EnableHttpLogging": true,
    "EnablePerformanceLogging": true
  }
}