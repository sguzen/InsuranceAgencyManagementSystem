{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ApplicationDb;Trusted_Connection=true;MultipleActiveResultSets=true;",
    "IntegrationConnection": "Server=(localdb)\\mssqllocaldb;Database=IntegrationDb;Trusted_Connection=true;MultipleActiveResultSets=true;"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "FromEmail": "your-email@gmail.com",
    "FromName": "IAMS Insurance Agency",
    "AgencyName": "IAMS Sigorta Acentesi",
    "ContactPhone": "+90 392 XXX XXXX",
    "ContactEmail": "info@iams-agency.com"
  },
  "FileStorage": {
    "Type": "local",
    "LocalPath": "C:\\IAMS\\Files",
    "BaseUrl": "/files",
    "AzureStorage": {
      "ConnectionString": "your-azure-storage-connection-string",
      "ContainerName": "iams-files"
    }
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:44390"
  },
  "Modules": {
    "Reporting": true,
    "Accounting": false,
    "Integration": false,
    "Claims": true,
    "Policies": true,
    "Customers": true
  },
  "IntegrationProviders": [
    {
      "Name": "axa-turkey",
      "DisplayName": "AXA Türkiye",
      "IsEnabled": false,
      "Settings": {
        "AuthType": "bearer",
        "Token": "your-api-token",
        "TimeoutSeconds": "30",
        "TestEndpoint": "/api/integration/axa/health",
        "CustomerSyncEndpoint": "/api/integration/axa/customers/sync",
        "PolicySyncEndpoint": "/api/integration/axa/policies/sync",
        "ClaimSubmissionEndpoint": "/api/integration/axa/claims/submit"
      }
    },
    {
      "Name": "allianz-turkey",
      "DisplayName": "Allianz Türkiye",
      "IsEnabled": false,
      "Settings": {
        "AuthType": "apikey",
        "ApiKey": "your-api-key",
        "ApiKeyHeader": "X-API-Key",
        "TimeoutSeconds": "45",
        "TestEndpoint": "/api/integration/allianz/status",
        "CustomerSyncEndpoint": "/api/integration/allianz/customers",
        "PolicySyncEndpoint": "/api/integration/allianz/policies",
        "ClaimSubmissionEndpoint": "/api/integration/allianz/claims"
      }
    },
    {
      "Name": "mapfre-turkey",
      "DisplayName": "MAPFRE Türkiye",
      "IsEnabled": false,
      "Settings": {
        "AuthType": "bearer",
        "Token": "your-mapfre-token",
        "TimeoutSeconds": "60",
        "TestEndpoint": "/api/integration/mapfre/health",
        "CustomerSyncEndpoint": "/api/integration/mapfre/customers",
        "PolicySyncEndpoint": "/api/integration/mapfre/policies",
        "ClaimSubmissionEndpoint": "/api/integration/mapfre/claims"
      }
    }
  ],
  "BackgroundServices": {
    "PolicyReminder": {
      "Enabled": true,
      "IntervalHours": 24
    },
    "IntegrationSync": {
      "Enabled": true,
      "IntervalHours": 6
    },
    "ReportScheduler": {
      "Enabled": true,
      "IntervalHours": 1
    },
    "ClaimProcessing": {
      "Enabled": true,
      "IntervalHours": 2
    },
    "DataCleanup": {
      "Enabled": true,
      "RunTime": "02:00"
    },
    "Backup": {
      "Enabled": true,
      "RunDay": "Sunday",
      "RunTime": "03:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IAMS.Infrastructure": "Information"
    }
  }
}