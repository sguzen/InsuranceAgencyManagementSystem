@using MudBlazor
@inherits LayoutComponentBase
@inject ITenantContextAccessor TenantContext
@inject NavigationManager Navigation

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- AppBar -->
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-2" />
            IAMS
        </MudText>
        <MudSpacer />
        
        <!-- Tenant Info -->
        @if (TenantContext.CurrentTenant != null)
        {
            <IMudChip Color="Color.Secondary" Size="Size.Small">
                @TenantContext.CurrentTenant.Name
            </IMudChip>
        }
        
        <!-- User Menu -->
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit">
            <MudMenuItem Icon="@Icons.Material.Filled.Person">Profil</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Settings">Ayarlar</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Çıkış</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <!-- Navigation Drawer -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1976d2",
            Secondary = "#424242",
            AppbarBackground = "#1976d2",
            Background = "#f5f5f5",
            DrawerBackground = "#ffffff",
            Surface = "#ffffff"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#2196f3",
            Secondary = "#757575",
            AppbarBackground = "#1565c0",
            Background = "#121212",
            DrawerBackground = "#1e1e1e",
            Surface = "#1e1e1e"
        }
    };

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    void Logout()
    {
        Navigation.NavigateTo("/Account/Logout");
    }
}