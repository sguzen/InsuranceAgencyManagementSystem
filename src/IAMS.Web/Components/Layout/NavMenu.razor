@using MudBlazor
@inject ITenantContextAccessor TenantContext

<MudNavMenu>
    <!-- Dashboard -->
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <!-- Customers -->
    <MudNavLink Href="/customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
        Müşteriler
    </MudNavLink>

    <!-- Policies -->
    <MudNavLink Href="/policies" Icon="@Icons.Material.Filled.Description">
        Poliçeler
    </MudNavLink>

    <!-- Insurance Companies -->
    <MudNavLink Href="/insurance-companies" Icon="@Icons.Material.Filled.Business">
        Sigorta Şirketleri
    </MudNavLink>

    <!-- Conditional Modules -->
    @if (TenantContext.IsModuleEnabled("Reporting"))
    {
        <MudNavGroup Text="Raporlar" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
            <MudNavLink Href="/reports/customers" Icon="@Icons.Material.Filled.PeopleAlt">
                Müşteri Raporları
            </MudNavLink>
            <MudNavLink Href="/reports/policies" Icon="@Icons.Material.Filled.Policy">
                Poliçe Raporları
            </MudNavLink>
            <MudNavLink Href="/reports/financial" Icon="@Icons.Material.Filled.MonetizationOn">
                Mali Raporlar
            </MudNavLink>
        </MudNavGroup>
    }

    @if (TenantContext.IsModuleEnabled("Accounting"))
    {
        <MudNavGroup Text="Muhasebe" Icon="@Icons.Material.Filled.Calculate" Expanded="false">
            <MudNavLink Href="/accounting/invoices" Icon="@Icons.Material.Filled.Receipt">
                Faturalar
            </MudNavLink>
            <MudNavLink Href="/accounting/payments" Icon="@Icons.Material.Filled.Payment">
                Ödemeler
            </MudNavLink>
            <MudNavLink Href="/accounting/commissions" Icon="@Icons.Material.Filled.TrendingUp">
                Komisyonlar
            </MudNavLink>
        </MudNavGroup>
    }

    <MudDivider Class="my-2" />

    <!-- Administration -->
    <MudNavGroup Text="Yönetim" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
        <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.Group">
            Kullanıcılar
        </MudNavLink>
        <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.Security">
            Roller
        </MudNavLink>
        <MudNavLink Href="/admin/settings" Icon="@Icons.Material.Filled.Settings">
            Ayarlar
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>

<style>
    .mud-nav-link {
        border-radius: 8px;
        margin: 4px 8px;
    }

        .mud-nav-link.active {
            background-color: var(--mud-palette-primary-lighten);
            color: var(--mud-palette-primary);
        }
</style>