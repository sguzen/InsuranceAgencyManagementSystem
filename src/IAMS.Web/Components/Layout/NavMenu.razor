@* IAMS.Web/Components/Layout/NavMenu.razor *@
@using IAMS.MultiTenancy.Interfaces
@using IAMS.Application.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject ITenantContextAccessor TenantContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudNavMenu>
    <!-- Dashboard -->
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <MudDivider Class="my-2" />

    <!-- Customers Section -->
    <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.Prefix">
        Cari Kart
    </MudNavLink>

    <!-- Policies Section -->
    <MudNavGroup Title="Poliçeler" Icon="@Icons.Material.Filled.Assignment" Expanded="true">
        <MudNavLink Href="/policies" Icon="@Icons.Material.Filled.List" IconColor="Color.Primary">
            Poliçe Listesi
        </MudNavLink>
        <MudNavLink Href="/policies/import" Icon="@Icons.Material.Filled.Upload" IconColor="Color.Info">
            Poliçe İçe Aktar
        </MudNavLink>
        <MudNavLink Href="/policies/expiring" Icon="@Icons.Material.Filled.Schedule" IconColor="Color.Warning">
            Süresi Dolacaklar
        </MudNavLink>
    </MudNavGroup>

    <!-- Reports Section (conditional based on tenant modules) -->
    @if (IsReportingModuleEnabled)
    {
        <MudNavGroup Title="Raporlar" Icon="@Icons.Material.Filled.Assessment">
            <MudNavLink Href="/reports/customer" Icon="@Icons.Material.Filled.Person">
                Müşteri Raporu
            </MudNavLink>
            <MudNavLink Href="/reports/customers" Icon="@Icons.Material.Filled.PeopleAlt">
                Müşteri Raporları
            </MudNavLink>
            <MudNavLink Href="/reports/policies" Icon="@Icons.Material.Filled.Assignment">
                Poliçe Raporları
            </MudNavLink>
            <MudNavLink Href="/reports/financial" Icon="@Icons.Material.Filled.AttachMoney">
                Mali Raporlar
            </MudNavLink>
        </MudNavGroup>
    }

    <!-- Accounting Section (conditional based on tenant modules) -->
    @if (IsAccountingModuleEnabled)
    {
        <MudNavGroup Title="Muhasebe" Icon="@Icons.Material.Filled.AccountBalance">
            <MudNavLink Href="/accounting/commissions" Icon="@Icons.Material.Filled.Payments">
                Komisyonlar
            </MudNavLink>
            <MudNavLink Href="/accounting/payments" Icon="@Icons.Material.Filled.Payment">
                Ödemeler
            </MudNavLink>
            <MudNavLink Href="/accounting/invoices" Icon="@Icons.Material.Filled.Receipt">
                Faturalar
            </MudNavLink>
        </MudNavGroup>
    }

    <MudDivider Class="my-2" />

    <!-- Settings Section -->
    <MudNavGroup Title="Ayarlar" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/settings/ui" Icon="@Icons.Material.Filled.Palette">
            Görünüm Tercihleri
        </MudNavLink>
        <MudNavLink Href="/settings/general" Icon="@Icons.Material.Filled.Tune">
            Genel Ayarlar
        </MudNavLink>
        <MudNavLink Href="/insurance-companies" Icon="@Icons.Material.Filled.Business">
            Sigorta Şirketleri
        </MudNavLink>
        <MudNavLink Href="/settings/users" Icon="@Icons.Material.Filled.ManageAccounts">
            Kullanıcı Yönetimi
        </MudNavLink>
        <MudNavLink Href="/settings/modules" Icon="@Icons.Material.Filled.Extension">
            Modül Yönetimi
        </MudNavLink>
        @if (IsIntegrationModuleEnabled && IsSuperAdmin)
        {
            <MudNavLink Href="/settings/integrations" Icon="@Icons.Material.Filled.IntegrationInstructions">
                Entegrasyonlar
            </MudNavLink>
        }
    </MudNavGroup>

    <!-- Help & Support -->
    <MudDivider Class="my-2" />
    <MudNavLink Href="/help" Icon="@Icons.Material.Filled.Help" IconColor="Color.Info">
        Yardım
    </MudNavLink>
    <MudNavLink Href="/about" Icon="@Icons.Material.Filled.Info" IconColor="Color.Secondary">
        Hakkında
    </MudNavLink>
</MudNavMenu>

@code {
    private bool IsReportingModuleEnabled => CheckModuleEnabled("Reporting");
    private bool IsAccountingModuleEnabled => CheckModuleEnabled("Accounting");
    private bool IsIntegrationModuleEnabled => CheckModuleEnabled("Integration");
    private bool IsSuperAdmin { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Check if user has SuperAdmin role
        IsSuperAdmin = user.IsInRole(RoleNames.SuperAdmin);
    }

    private bool CheckModuleEnabled(string moduleName)
    {
        // Hide Reporting and Accounting modules as per user request
        if (moduleName == "Reporting" || moduleName == "Accounting")
        {
            return false;
        }

        // For other modules, return true. In production, check actual module status
        // This would be implemented by calling a module service
        return true;

        /*
        Example implementation:
        try
        {
            if (TenantContext.CurrentTenant != null)
            {
                return await ModuleService.IsModuleEnabledAsync(moduleName, TenantContext.CurrentTenant.Id);
            }
            return false;
        }
        catch
        {
            return false;
        }
        */
    }
}