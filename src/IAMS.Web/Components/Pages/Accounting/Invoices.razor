@page "/accounting/invoices"
@layout Layout.MainLayout
@attribute [Authorize]

<PageTitle>Faturalar</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-3" />
                Faturalar
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Yeni Fatura
            </MudButton>
        </MudStack>

        <!-- Info Card -->
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Fatura Yönetimi
                </MudText>
                <MudText>
                    Bu sayfa faturaları görüntülemek ve yönetmek için kullanılır.
                </MudText>
                <MudText Class="mt-4" Color="Color.Secondary">
                    Fatura oluşturma, görüntüleme ve ödeme takibi bu bölümde yapılabilir.
                </MudText>
            </MudCardContent>
        </MudCard>

        <!-- Invoice Summary Stats -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bekleyen Faturalar</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Color="Color.Warning" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Ödenen</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Vadesi Geçmiş</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Tutar</MudText>
                                <MudText Typo="Typo.h5">₺0.00</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" Color="Color.Info" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Invoices Table Placeholder -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Fatura Listesi</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" />
                    <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Color="Color.Default" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@(new List<object>())" Hover="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Fatura No</MudTh>
                        <MudTh>Müşteri</MudTh>
                        <MudTh>Poliçe No</MudTh>
                        <MudTh>Fatura Tarihi</MudTh>
                        <MudTh>Vade Tarihi</MudTh>
                        <MudTh>Tutar</MudTh>
                        <MudTh>Durum</MudTh>
                        <MudTh>İşlemler</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <!-- Rows will appear when data is loaded -->
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="pa-4">
                            Henüz fatura kaydı bulunmamaktadır.
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    // Invoice data will be loaded here in future implementation
}
