@page "/accounting/payments"
@layout Layout.MainLayout

<PageTitle>Ödemeler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-3" />
                Ödemeler
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Yeni Ödeme
            </MudButton>
        </MudStack>

        <!-- Info Card -->
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Ödeme Yönetimi
                </MudText>
                <MudText>
                    Bu sayfa poliçe ödemelerini görüntülemek ve yönetmek için kullanılır.
                </MudText>
                <MudText Class="mt-4" Color="Color.Secondary">
                    Poliçe ödemeleri, ödeme durumları ve ödeme geçmişi bu bölümde görüntülenebilir.
                </MudText>
            </MudCardContent>
        </MudCard>

        <!-- Payment Summary Stats -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bekleyen Ödemeler</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Large" Color="Color.Warning" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Tamamlanan</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Gecikmiş</MudText>
                                <MudText Typo="Typo.h5">0</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Error" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Tutar</MudText>
                                <MudText Typo="Typo.h5">₺0.00</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" Color="Color.Info" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Payments Table Placeholder -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Ödeme Listesi</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@(new List<object>())" Hover="true" Striped="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Poliçe No</MudTh>
                        <MudTh>Ödeme Tarihi</MudTh>
                        <MudTh>Tutar</MudTh>
                        <MudTh>Ödeme Yöntemi</MudTh>
                        <MudTh>Durum</MudTh>
                        <MudTh>Referans</MudTh>
                        <MudTh>İşlemler</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <!-- Rows will appear when data is loaded -->
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="pa-4">
                            Henüz ödeme kaydı bulunmamaktadır.
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    // Payment data will be loaded here in future implementation
}
