@using IAMS.Application.DTOs.Customer
@using IAMS.Application.Interfaces
@using IAMS.Application.Services.Customers
@using MudBlazor
@using FluentValidation
@inject ICustomerService CustomerService

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 500px; overflow-y: scroll">
            <EditForm Model="_model" OnValidSubmit="CreateCustomer">
                <FluentValidationValidator />
                
                <MudGrid>
                    <!-- First Name -->
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.FirstName"
                                      Label="Ad"
                                      Required="true"
                                      For="@(() => _model.FirstName)"
                                      Immediate="true" />
                    </MudItem>

                    <!-- Last Name -->
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.LastName"
                                      Label="Soyad"
                                      Required="true"
                                      For="@(() => _model.LastName)"
                                      Immediate="true" />
                    </MudItem>

                    <!-- Email -->
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.Email"
                                      Label="E-posta"
                                      InputType="InputType.Email"
                                      Required="true"
                                      For="@(() => _model.Email)"
                                      Immediate="true" />
                    </MudItem>

                    <!-- Phone -->
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.Phone"
                                      Label="Telefon"
                                      InputType="InputType.Telephone"
                                      For="@(() => _model.Phone)"
                                      Immediate="true" />
                    </MudItem>

                    <!-- National ID -->
                   @*  <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.NationalId"
                                      Label="TC Kimlik No"
                                      HelperText="11 haneli TC Kimlik Numarası"
                                      For="@(() => _model.NationalId)"
                                      Immediate="true" />
                    </MudItem> *@

                    <!-- Date of Birth -->
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_model.DateOfBirth"
                                       Label="Doğum Tarihi"
                                       For="@(() => _model.DateOfBirth)"
                                       Culture="@System.Globalization.CultureInfo.GetCultureInfo("tr-TR")" />
                    </MudItem>

                    <!-- Address -->
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Address"
                                      Label="Adres"
                                      Lines="3"
                                      For="@(() => _model.Address)"
                                      Immediate="true" />
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudContainer>
    </DialogContent>
    
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="CreateCustomer"
                   Disabled="_processing">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <MudText Class="ms-2">Kaydediliyor...</MudText>
            }
            else
            {
                <MudText>Kaydet</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private CreateCustomerDto _model = new();
    private bool _processing = false;

    private async Task CreateCustomer()
    {
        _processing = true;
        StateHasChanged();

        try
        {
            await CustomerService.CreateCustomerAsync(_model);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            // Error handling would be done by a global error handler
            // or you could show a snackbar here
            _processing = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }


public class CreateCustomerDtoValidator : AbstractValidator<CreateCustomerDto>
{
    public CreateCustomerDtoValidator()
    {
        RuleFor(x => x.FirstName)
            .NotEmpty().WithMessage("Ad gereklidir")
            .MinimumLength(2).WithMessage("Ad en az 2 karakter olmalıdır")
            .MaximumLength(50).WithMessage("Ad en fazla 50 karakter olabilir");

        RuleFor(x => x.LastName)
            .NotEmpty().WithMessage("Soyad gereklidir")
            .MinimumLength(2).WithMessage("Soyad en az 2 karakter olmalıdır")
            .MaximumLength(50).WithMessage("Soyad en fazla 50 karakter olabilir");

        RuleFor(x => x.Email)
            .NotEmpty().WithMessage("E-posta gereklidir")
            .EmailAddress().WithMessage("Geçerli bir e-posta adresi giriniz");

        RuleFor(x => x.Phone)
            .Matches(@"^[\+]?[0-9\s\-\(\)]{10,}$").WithMessage("Geçerli bir telefon numarası giriniz")
            .When(x => !string.IsNullOrEmpty(x.Phone));

        // RuleFor(x => x.NationalId)
        //     .Must(BeValidTurkishNationalId).WithMessage("Geçerli bir TC Kimlik No giriniz")
        //     .When(x => !string.IsNullOrEmpty(x.NationalId));
    }

    private bool BeValidTurkishNationalId(string? nationalId)
    {
        if (string.IsNullOrEmpty(nationalId) || nationalId.Length != 11)
            return false;

        if (!nationalId.All(char.IsDigit))
            return false;

        var digits = nationalId.Select(c => int.Parse(c.ToString())).ToArray();

        if (digits[0] == 0)
            return false;

        var sum1 = digits[0] + digits[2] + digits[4] + digits[6] + digits[8];
        var sum2 = digits[1] + digits[3] + digits[5] + digits[7];

        var check1 = (sum1 * 7 - sum2) % 10;
        var check2 = (sum1 + sum2 + digits[9]) % 10;

        return check1 == digits[9] && check2 == digits[10];
    }
}
}