@page "/customers/{CustomerId:int}"
@layout Layout.MainLayout
@attribute [Authorize]

@using IAMS.Shared.DTOs.Customer
@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.DTOs.Payment
@using IAMS.Shared.DTOs.Currency
@using IAMS.Application.Interfaces
@using IAMS.Domain.Enums
@using IAMS.Shared.Models
@using IAMS.Web.Services.ApiClient
@using IAMS.Web.Components.Shared.Dialogs
@inject ICustomersApiClient CustomersApi
@inject ICurrenciesApiClient CurrenciesApi
@inject IPoliciesApiClient PoliciesApi
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Cari Kart - @(customer?.FullName ?? "Müşteri")</PageTitle>

@if (customer == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
        <MudProgressLinear Indeterminate="true" />
        <MudText Align="Align.Center" Class="mt-4">Müşteri bilgileri yükleniyor...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
        <MudStack Spacing="4">
            <!-- Header -->
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        @customer.FirstName.FirstOrDefault()@customer.LastName.FirstOrDefault()
                    </MudAvatar>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h4">@customer.FullName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Müşteri Kodu: @customer.CustomerCode
                        </MudText>
                    </MudStack>
                </MudStack>
                
                <MudStack Row Spacing="2">
                    <MudButton Variant="Variant.Outlined" 
                              StartIcon="@Icons.Material.Filled.ArrowBack"
                              OnClick="GoBack">
                        Geri
                    </MudButton>
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary"
                              StartIcon="@Icons.Material.Filled.Edit"
                              OnClick="EditCustomer">
                        Düzenle
                    </MudButton>
                </MudStack>
            </MudStack>

            <!-- Status Badges -->
            <MudStack Row Spacing="2">
                <MudChip Color="@GetStatusColor(customer.Status)" T="CustomerStatus"
                        Size="Size.Medium"
                        Variant="Variant.Filled">
                    @GetStatusText(customer.Status)
                </MudChip>
                <MudChip Color="Color.Info" T="int"
                        Size="Size.Medium" 
                        Variant="Variant.Outlined">
                    @customer.PolicyCount Poliçe
                </MudChip>
                <MudChip Color="@(customer.Type == CustomerType.Individual ? Color.Primary : Color.Secondary)" T="CustomerType"
                        Size="Size.Medium" 
                        Variant="Variant.Outlined">
                    @GetCustomerTypeText(customer.Type)
                </MudChip>
            </MudStack>

            <!-- Tabs -->
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <!-- Personal Information Tab -->
                <MudTabPanel Text="Kişisel Bilgiler" Icon="@Icons.Material.Filled.Person">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Temel Bilgiler</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudStack Spacing="3">
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Ad Soyad:</MudText>
                                            <MudText Typo="Typo.body1">@customer.FullName</MudText>
                                        </MudStack>

                                        <MudDivider />
                                        
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Cinsiyet:</MudText>
                                            <MudText Typo="Typo.body1">@GetGenderText(customer.Gender)</MudText>
                                        </MudStack>
                                        
                                        @if (customer.DateOfBirth.HasValue)
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Doğum Tarihi:</MudText>
                                                <MudText Typo="Typo.body1">@customer.DateOfBirth.Value.ToString("dd.MM.yyyy")</MudText>
                                            </MudStack>
                                            
                                            @if (customer.Age.HasValue)
                                            {
                                                <MudStack Row Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Yaş:</MudText>
                                                    <MudText Typo="Typo.body1">@customer.Age</MudText>
                                                </MudStack>
                                            }
                                        }

                                        <MudDivider />
                                        
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Kimlik Türü:</MudText>
                                            <MudText Typo="Typo.body1">@GetIdentificationTypeText(customer.IdentificationType)</MudText>
                                        </MudStack>
                                        
                                        @if (!string.IsNullOrEmpty(customer.IdentificationNumber))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Kimlik No:</MudText>
                                                <MudText Typo="Typo.body1">@customer.IdentificationNumber</MudText>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.NationalityCountryName))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Uyruk:</MudText>
                                                <MudText Typo="Typo.body1">@customer.NationalityCountryName</MudText>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.OccupationName))
                                        {
                                            <MudDivider />
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Meslek:</MudText>
                                                <MudText Typo="Typo.body1">@customer.OccupationName</MudText>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">İletişim Bilgileri</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudStack Spacing="3">
                                        @if (!string.IsNullOrEmpty(customer.Email))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">E-posta:</MudText>
                                                <MudLink Href="@($"mailto:{customer.Email}")">@customer.Email</MudLink>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.MobilePhoneNumber))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Cep Telefonu:</MudText>
                                                <MudLink Href="@($"tel:{customer.MobilePhoneCountryCode}{customer.MobilePhoneNumber}")">
                                                    @customer.MobilePhoneCountryCode @customer.MobilePhoneNumber
                                                </MudLink>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.HomePhone))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Ev Telefonu:</MudText>
                                                <MudLink Href="@($"tel:{customer.HomePhone}")">@customer.HomePhone</MudLink>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>

                            <MudSpacer />

                            <MudCard Class="mt-4">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Adres Bilgileri</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudStack Spacing="2">
                                        @if (!string.IsNullOrEmpty(customer.Address1))
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Adres 1:</MudText>
                                            <MudText Typo="Typo.body1">@customer.Address1</MudText>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.Address2))
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Adres 2:</MudText>
                                            <MudText Typo="Typo.body1">@customer.Address2</MudText>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.CityName))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween" Class="mt-2">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Şehir:</MudText>
                                                <MudText Typo="Typo.body1">@customer.CityName</MudText>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.DistrictName))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Mahalle:</MudText>
                                                <MudText Typo="Typo.body1">@customer.DistrictName</MudText>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.SubdistrictName))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Bucak:</MudText>
                                                <MudText Typo="Typo.body1">@customer.SubdistrictName</MudText>
                                            </MudStack>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(customer.VillageName))
                                        {
                                            <MudStack Row Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Köy:</MudText>
                                                <MudText Typo="Typo.body1">@customer.VillageName</MudText>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        @if (!string.IsNullOrEmpty(customer.Notes))
                        {
                            <MudItem xs="12">
                                <MudCard>
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Notlar</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText Typo="Typo.body1">@customer.Notes</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <!-- Policies Tab -->
                <MudTabPanel Text="Poliçeler" Icon="@Icons.Material.Filled.Description" BadgeData="@customer.PolicyCount">
                    <!-- Header -->
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">Müşteri Poliçeleri</MudText>
                    </MudStack>

                    @if (loadingPolicies)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (policies.Count == 0)
                    {
                        <MudAlert MudBlazor.Severity="MudBlazor.Severity.Info">
                            Bu müşteriye ait poliçe bulunmamaktadır.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@policies" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                            <HeaderContent>
                                <MudTh Style="width: 50px;"></MudTh>
                                <MudTh>Poliçe No</MudTh>
                                <MudTh>Z.No</MudTh>
                                <MudTh>Poliçe Türü</MudTh>
                                <MudTh>Sigorta Şirketi</MudTh>
                                <MudTh>Başlangıç</MudTh>
                                <MudTh>Bitiş</MudTh>
                                <MudTh>Prim</MudTh>
                                <MudTh>Durum</MudTh>
                                <MudTh>İşlemler</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="">
                                    @if (HasEndorsements(context.Id))
                                    {
                                        <MudIconButton Icon="@(IsExpanded(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => ToggleExpand(context.Id))"
                                                       Title="@(IsExpanded(context.Id) ? "Zeyilleri Gizle" : "Zeyilleri Göster")" />
                                    }
                                </MudTd>
                                <MudTd DataLabel="Poliçe No">@context.PolicyNumber</MudTd>
                                <MudTd DataLabel="Z.No">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.body2">@context.InnerCode</MudText>
                                        @if (HasEndorsements(context.Id))
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Info" T="int">@GetEndorsementCount(context.Id) Zeyil</MudChip>
                                        }
                                    </MudStack>
                                </MudTd>
                                <MudTd DataLabel="Poliçe Türü">@context.PolicyType.Name</MudTd>
                                <MudTd DataLabel="Sigorta Şirketi">@context.InsuranceCompany.Name</MudTd>
                                <MudTd DataLabel="Başlangıç">@context.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                <MudTd DataLabel="Bitiş">@context.EndDate.ToString("dd.MM.yyyy")</MudTd>
                                <MudTd DataLabel="Prim">@context.CurrencySymbol@context.PremiumAmount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Durum">
                                     <MudChip Size="Size.Small" Color="@GetPolicyStatusColor(@context.Status)" T="PolicyStatus">
                                        @GetPolicyStatusText(context.Status)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="İşlemler">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => ViewPolicy(context.Id))" />
                                </MudTd>
                            </RowTemplate>
                            <ChildRowContent>
                                @if (IsExpanded(context.Id) && HasEndorsements(context.Id))
                                {
                                    <td colspan="10" style="padding: 0;">
                                        <MudCard Elevation="0" Class="ma-2">
                                            <MudCardHeader>
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.subtitle2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                                                        Zeyilnameler (@GetEndorsementCount(context.Id))
                                                    </MudText>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <MudTable Items="@GetEndorsements(context.Id)" Hover="true" Dense="true" Elevation="0">
                                                    <HeaderContent>
                                                        <MudTh>Z.No</MudTh>
                                                        <MudTh>Başlangıç</MudTh>
                                                        <MudTh>Bitiş</MudTh>
                                                        <MudTh>Prim</MudTh>
                                                        <MudTh>Durum</MudTh>
                                                        <MudTh>İşlemler</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate Context="endorsement">
                                                        <MudTd DataLabel="Z.No">
                                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudText Typo="Typo.body2">@endorsement.InnerCode</MudText>
                                                                <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                                            </MudStack>
                                                        </MudTd>
                                                        <MudTd DataLabel="Başlangıç">@endorsement.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                                        <MudTd DataLabel="Bitiş">@endorsement.EndDate.ToString("dd.MM.yyyy")</MudTd>
                                                        <MudTd DataLabel="Prim">@endorsement.CurrencySymbol@endorsement.PremiumAmount.ToString("N2")</MudTd>
                                                        <MudTd DataLabel="Durum">
                                                            <MudChip Size="Size.Small" Color="@GetPolicyStatusColor(endorsement.Status)" T="PolicyStatus">
                                                                @GetPolicyStatusText(endorsement.Status)
                                                            </MudChip>
                                                        </MudTd>
                                                        <MudTd DataLabel="İşlemler">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                                           Size="Size.Small"
                                                                           Color="Color.Primary"
                                                                           OnClick="@(() => ViewPolicy(endorsement.Id))" />
                                                        </MudTd>
                                                    </RowTemplate>
                                                </MudTable>
                                            </MudCardContent>
                                        </MudCard>
                                    </td>
                                }
                            </ChildRowContent>
                        </MudTable>
                    }
                </MudTabPanel>

                <!-- Payments & Balance Tab -->
                <MudTabPanel Text="Ödemeler ve Bakiye" Icon="@Icons.Material.Filled.AccountBalance">
                    <!-- Header -->
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">Müşteri Bakiye ve Ödemeleri</MudText>
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  StartIcon="@Icons.Material.Filled.Add"
                                  OnClick="OpenPaymentDialog">
                            Ödeme Kaydet
                        </MudButton>
                    </MudStack>

                    @if (loadingBalance)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (customerBalance != null && customerBalance.Balances.Any())
                    {
                        <!-- Balance Cards -->
                        <MudGrid Class="mb-6">
                            @foreach (var balance in customerBalance.Balances)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard>
                                        <MudCardContent>
                                            <MudStack Spacing="2">
                                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                                    <MudText Typo="Typo.h6">@balance.CurrencyCode</MudText>
                                                    <MudChip Color="@(balance.IsPositive ? Color.Success : Color.Error)"
                                                            Size="Size.Small" T="bool">
                                                        @(balance.IsPositive ? "Alacak" : "Borç")
                                                    </MudChip>
                                                </MudStack>

                                                <MudDivider />

                                                <MudStack Row Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Borç:</MudText>
                                                    <MudText Typo="Typo.body1">@balance.CurrencySymbol@balance.TotalDebt.ToString("N2")</MudText>
                                                </MudStack>

                                                <MudStack Row Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Ödenen:</MudText>
                                                    <MudText Typo="Typo.body1">@balance.CurrencySymbol@balance.TotalPaid.ToString("N2")</MudText>
                                                </MudStack>

                                                <MudDivider />

                                                <MudStack Row Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Bakiye:</MudText>
                                                    <MudText Typo="Typo.h6" Color="@(balance.IsPositive ? Color.Success : Color.Error)">
                                                        @balance.CurrencySymbol@Math.Abs(balance.Balance).ToString("N2")
                                                    </MudText>
                                                </MudStack>
                                            </MudStack>
                                        </MudCardContent>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else
                    {
                        <MudAlert MudBlazor.Severity="MudBlazor.Severity.Info" Class="mb-6">
                            Bu müşteriye ait bakiye bilgisi bulunmamaktadır.
                        </MudAlert>
                    }

                    <!-- Payments Table -->
                    <MudText Typo="Typo.h6" Class="mb-4">Son Ödemeler</MudText>

                    @if (loadingPayments)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (customerPayments.Count == 0)
                    {
                        <MudAlert MudBlazor.Severity="MudBlazor.Severity.Info">
                            Bu müşteriye ait ödeme kaydı bulunmamaktadır.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@customerPayments" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                            <HeaderContent>
                                <MudTh>Tarih</MudTh>
                                <MudTh>Tutar</MudTh>
                                <MudTh>Para Birimi</MudTh>
                                <MudTh>Ödeme Yöntemi</MudTh>
                                <MudTh>Referans</MudTh>
                                <MudTh>Dağıtım Durumu</MudTh>
                                <MudTh>Dağıtılan</MudTh>
                                <MudTh>Dağıtılmamış</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Tarih">@context.PaymentDate.ToString("dd.MM.yyyy")</MudTd>
                                <MudTd DataLabel="Tutar">@context.CurrencySymbol@context.Amount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Para Birimi">@context.CurrencyCode</MudTd>
                                <MudTd DataLabel="Ödeme Yöntemi">@GetPaymentMethodText(context.PaymentMethod)</MudTd>
                                <MudTd DataLabel="Referans">@context.Reference</MudTd>
                                <MudTd DataLabel="Dağıtım Durumu">
                                    <MudChip Size="Size.Small" Color="@GetAllocationStatusColor(context.AllocationStatus)" T="AllocationStatus">
                                        @GetAllocationStatusText(context.AllocationStatus)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Dağıtılan">@context.CurrencySymbol@context.AllocatedAmount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Dağıtılmamış">@context.CurrencySymbol@context.UnallocatedAmount.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudStack>
    </MudContainer>
}

<!-- Payment Dialog -->
<MudDialog @bind-IsVisible="showPaymentDialog" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-3" /> Yeni Ödeme Kaydet
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="newPayment.Amount"
                                Label="Tutar"
                                Variant="Variant.Outlined"
                                Min="0.01m"
                                Step="0.01m"
                                Format="N2"
                                Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="newPayment.CurrencyId"
                          Label="Para Birimi"
                          Variant="Variant.Outlined"
                          Required="true">
                    @foreach (var currency in currencies)
                    {
                        <MudSelectItem Value="@currency.Id">@currency.Code - @currency.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="paymentDate"
                              Label="Ödeme Tarihi"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="newPayment.PaymentMethod"
                          Label="Ödeme Yöntemi"
                          Variant="Variant.Outlined"
                          Required="true">
                    <MudSelectItem Value="@PaymentMethod.Cash">Nakit</MudSelectItem>
                    <MudSelectItem Value="@PaymentMethod.BankTransfer">Banka Havalesi</MudSelectItem>
                    <MudSelectItem Value="@PaymentMethod.Cheque">Çek</MudSelectItem>
                    <MudSelectItem Value="@PaymentMethod.CreditCard">Kredi Kartı</MudSelectItem>
                    <MudSelectItem Value="@PaymentMethod.DebitCard">Banka Kartı</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="newPayment.Reference"
                             Label="Referans / Belge No"
                             Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="newPayment.Notes"
                             Label="Notlar"
                             Variant="Variant.Outlined"
                             Lines="3" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ClosePaymentDialog">İptal</MudButton>
        <MudButton Color="Color.Primary"
                  Variant="Variant.Filled"
                  OnClick="SavePayment"
                  Disabled="savingPayment">
            @if (savingPayment)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span class="ml-2">Kaydediliyor...</span>
            }
            else
            {
                <span>Kaydet</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int CustomerId { get; set; }

    private CustomerDto? customer;
    private List<PolicyDto> policies = new();
    private List<PolicyDto> allPolicies = new(); // Stores all policies including endorsements
    private List<PolicyDto> mainPolicies = new(); // Stores only main policies for display
    private Dictionary<int, List<PolicyDto>> endorsementsByPolicy = new(); // Endorsements grouped by main policy ID
    private HashSet<int> expandedPolicies = new(); // Track which policies are expanded
    private bool loadingPolicies = false;

    // Payment and Balance related fields
    private CustomerBalanceDto? customerBalance;
    private List<CustomerPaymentDto> customerPayments = new();
    private List<CurrencyDto> currencies = new();
    private bool loadingBalance = false;
    private bool loadingPayments = false;
    private bool showPaymentDialog = false;
    private bool savingPayment = false;
    private CreateCustomerPaymentDto newPayment = new();
    private DateTime? paymentDate = DateTime.Today;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomer();
        await Task.WhenAll(
            LoadPolicies(),
            LoadBalance(),
            LoadPayments(),
            LoadCurrencies()
        );
    }

    private async Task LoadCustomer()
    {
        var result = await CustomersApi.GetCustomerByIdAsync(CustomerId);
        if (result.IsSuccess && result.Data != null)
        {
            customer = result.Data;
        }
        else
        {
            Snackbar.Add("Müşteri bulunamadı", MudBlazor.Severity.Error);
            GoBack();
        }
    }

    private async Task LoadPolicies()
    {
        loadingPolicies = true;
        try
        {
            var result = await PoliciesApi.GetPoliciesByCustomerAsync(CustomerId);
            if (result.IsSuccess && result.Data != null)
            {
                allPolicies = result.Data;

                // Separate main policies from endorsements
                mainPolicies = allPolicies.Where(p => p.InnerCode == "000").ToList();

                // Group endorsements by their main policy ID
                endorsementsByPolicy.Clear();
                var endorsements = allPolicies.Where(p => p.InnerCode != "000" && p.OriginalPolicyId.HasValue).ToList();
                foreach (var endorsement in endorsements)
                {
                    if (!endorsementsByPolicy.ContainsKey(endorsement.OriginalPolicyId.Value))
                    {
                        endorsementsByPolicy[endorsement.OriginalPolicyId.Value] = new List<PolicyDto>();
                    }
                    endorsementsByPolicy[endorsement.OriginalPolicyId.Value].Add(endorsement);
                }

                // Sort endorsements by InnerCode
                foreach (var key in endorsementsByPolicy.Keys.ToList())
                {
                    endorsementsByPolicy[key] = endorsementsByPolicy[key].OrderBy(e => e.InnerCode).ToList();
                }

                // Set policies to mainPolicies for display
                policies = mainPolicies;
            }
            else
            {
                allPolicies = new List<PolicyDto>();
                mainPolicies = new List<PolicyDto>();
                policies = new List<PolicyDto>();
                endorsementsByPolicy.Clear();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Poliçeler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Warning);
            allPolicies = new List<PolicyDto>();
            mainPolicies = new List<PolicyDto>();
            policies = new List<PolicyDto>();
            endorsementsByPolicy.Clear();
        }
        finally
        {
            loadingPolicies = false;
        }
    }

    private void EditCustomer()
    {
        Navigation.NavigateTo($"/customers/{CustomerId}/edit");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/customers");
    }

    private async Task ViewPolicy(int policyId)
    {
        var parameters = new DialogParameters
        {
            { "PolicyId", policyId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        await DialogService.ShowAsync<PolicyDetailsDialog>("Poliçe Detayları", parameters, options);
    }

    private void CreatePolicyForCustomer()
    {
        Navigation.NavigateTo($"/policies/create?customerId={CustomerId}");
    }

    // Helper methods for display text
    private string GetStatusText(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => "Aktif",
        CustomerStatus.Inactive => "Pasif",
        CustomerStatus.Suspended => "Askıya Alınmış",
        CustomerStatus.Blacklisted => "Silinmiş",
        _ => status.ToString()
    };

    private Color GetStatusColor(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => Color.Success,
        CustomerStatus.Inactive => Color.Default,
        CustomerStatus.Suspended => Color.Warning,
        CustomerStatus.Blacklisted => Color.Error,
        _ => Color.Default
    };

    private string GetGenderText(Gender gender) => gender switch
    {
        Gender.Male => "Erkek",
        Gender.Female => "Kadın",
        _ => gender.ToString()
    };

    private string GetCustomerTypeText(CustomerType type) => type switch
    {
        CustomerType.Individual => "Bireysel",
        CustomerType.Corporate => "Kurumsal",
        _ => type.ToString()
    };

    private string GetIdentificationTypeText(IdentificationType type) => type switch
    {
        IdentificationType.IdCard => "Kimlik Kartı",
        IdentificationType.Passport => "Pasaport",
        IdentificationType.TradeLicense => "Trade License",
        IdentificationType.TaxNumber => "Vergi Numarası",
        _ => type.ToString()
    };

    private string GetPolicyStatusText(PolicyStatus status) => status switch
    {
        PolicyStatus.Draft => "Taslak",
        PolicyStatus.Active => "Aktif",
        PolicyStatus.Expired => "Süresi Dolmuş",
        PolicyStatus.Cancelled => "İptal",
        PolicyStatus.Suspended => "Askıya Alınmış",
        _ => status.ToString()
    };

    private Color GetPolicyStatusColor(PolicyStatus status) => status switch
    {
        PolicyStatus.Draft => Color.Default,
        PolicyStatus.Active => Color.Success,
        PolicyStatus.Expired => Color.Warning,
        PolicyStatus.Cancelled => Color.Error,
        PolicyStatus.Suspended => Color.Warning,
        _ => Color.Default
    };

    // Endorsement accordion methods
    private bool HasEndorsements(int policyId)
    {
        return endorsementsByPolicy.ContainsKey(policyId) && endorsementsByPolicy[policyId].Any();
    }

    private int GetEndorsementCount(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId].Count : 0;
    }

    private List<PolicyDto> GetEndorsements(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId] : new List<PolicyDto>();
    }

    private bool IsExpanded(int policyId)
    {
        return expandedPolicies.Contains(policyId);
    }

    private void ToggleExpand(int policyId)
    {
        if (expandedPolicies.Contains(policyId))
        {
            expandedPolicies.Remove(policyId);
        }
        else
        {
            expandedPolicies.Add(policyId);
        }
    }

    // Payment and Balance Methods
    private async Task LoadBalance()
    {
        loadingBalance = true;
        try
        {
            var result = await CustomersApi.GetCustomerBalanceAsync(CustomerId);
            if (result.IsSuccess && result.Data != null)
            {
                customerBalance = result.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Bakiye yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Warning);
        }
        finally
        {
            loadingBalance = false;
        }
    }

    private async Task LoadPayments()
    {
        loadingPayments = true;
        try
        {
            var result = await CustomersApi.GetCustomerPaymentsAsync(CustomerId);
            if (result.IsSuccess && result.Data != null)
            {
                customerPayments = result.Data;
            }
            else
            {
                customerPayments = new List<CustomerPaymentDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ödemeler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Warning);
            customerPayments = new List<CustomerPaymentDto>();
        }
        finally
        {
            loadingPayments = false;
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrenciesApi.GetCurrenciesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                currencies = result.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Para birimleri yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    private async Task OpenPaymentDialog()
    {
        var parameters = new DialogParameters
        {
            ["CustomerId"] = CustomerId,
            ["Currencies"] = currencies
        };

        var dialog = await DialogService.ShowAsync<AddCustomerPaymentDialog>("Yeni Ödeme Kaydet", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await Task.WhenAll(LoadBalance(), LoadPayments());
        }
    }

    private void ClosePaymentDialog()
    {
        showPaymentDialog = false;
        newPayment = new CreateCustomerPaymentDto();
        paymentDate = null;
    }

    private async Task SavePayment()
    {
        if (newPayment.Amount <= 0)
        {
            Snackbar.Add("Ödeme tutarı sıfırdan büyük olmalıdır", MudBlazor.Severity.Error);
            return;
        }

        if (newPayment.CurrencyId == 0)
        {
            Snackbar.Add("Para birimi seçmelisiniz", MudBlazor.Severity.Error);
            return;
        }

        savingPayment = true;
        try
        {
            newPayment.PaymentDate = paymentDate ?? DateTime.Today;

            var result = await CustomersApi.CreateCustomerPaymentAsync(CustomerId, newPayment);
            if (result.IsSuccess)
            {
                Snackbar.Add("Ödeme başarıyla kaydedildi", MudBlazor.Severity.Success);
                ClosePaymentDialog();

                // Reload balance and payments
                await Task.WhenAll(LoadBalance(), LoadPayments());
            }
            else
            {
                Snackbar.Add(result.Message ?? "Ödeme kaydedilirken hata oluştu", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ödeme kaydedilirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            savingPayment = false;
        }
    }

    private string GetPaymentMethodText(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => "Nakit",
        PaymentMethod.BankTransfer => "Banka Havalesi",
        PaymentMethod.Cheque => "Çek",
        PaymentMethod.CreditCard => "Kredi Kartı",
        PaymentMethod.DebitCard => "Banka Kartı",
        _ => method.ToString()
    };

    private string GetAllocationStatusText(AllocationStatus status) => status switch
    {
        AllocationStatus.Unallocated => "Dağıtılmamış",
        AllocationStatus.PartiallyAllocated => "Kısmi Dağıtılmış",
        AllocationStatus.FullyAllocated => "Tam Dağıtılmış",
        _ => status.ToString()
    };

    private Color GetAllocationStatusColor(AllocationStatus status) => status switch
    {
        AllocationStatus.Unallocated => Color.Warning,
        AllocationStatus.PartiallyAllocated => Color.Info,
        AllocationStatus.FullyAllocated => Color.Success,
        _ => Color.Default
    };
}
