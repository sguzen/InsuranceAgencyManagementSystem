@page "/customers/create"
@page "/customers/{CustomerId:int}/edit"
@layout Layout.MainLayout

@using IAMS.Application.DTOs.Customer
@using IAMS.Application.Interfaces
@using IAMS.Domain.Enums
@using FluentValidation
@using IAMS.Application.Services.Customers
@inject ICustomerService CustomerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(IsEdit ? "Müşteri Düzenle" : "Yeni Müşteri")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Class="mr-3" />
                @(IsEdit ? "Müşteri Düzenle" : "Yeni Müşteri")
            </MudText>
            <MudButton Variant="Variant.Outlined" 
                      StartIcon="@Icons.Material.Filled.ArrowBack"
                      OnClick="GoBack">
                Geri
            </MudButton>
        </MudStack>

        <!-- Form -->
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit" FormName="customerForm">
            <FluentValidationValidator />
            
            <MudGrid>
                <!-- Personal Information -->
                <MudItem xs="12">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Kişisel Bilgiler</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="model.FirstName"
                                                Label="Ad *"
                                                Variant="Variant.Outlined"
                                                Required="true"
                                                For="@(() => model.FirstName)" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="model.LastName"
                                                Label="Soyad *"
                                                Variant="Variant.Outlined"
                                                Required="true"
                                                For="@(() => model.LastName)" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="model.IdentificationNo"
                                                Label="Kimlik No"
                                                Variant="Variant.Outlined"
                                                Mask="@(new PatternMask("00000000000"))"
                                                For="@(() => model.IdentificationNo)" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudDatePicker @bind-Date="model.DateOfBirth"
                                                 Label="Doğum Tarihi"
                                                 Variant="Variant.Outlined"
                                                 MaxDate="DateTime.Today"
                                                 For="@(() => model.DateOfBirth)" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSelect @bind-Value="model.Gender"
                                             Label="Cinsiyet"
                                             Variant="Variant.Outlined"
                                             For="@(() => model.Gender)">
                                        <MudSelectItem Value="@(Gender.Male)">Erkek</MudSelectItem>
                                        <MudSelectItem Value="@(Gender.Female)">Kadın</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSelect @bind-Value="model.Status"
                                             Label="Durum *"
                                             Variant="Variant.Outlined"
                                             Required="true"
                                             T="CustomerStatus"
                                             For="@(() => model.Status)">
                                        <MudSelectItem T="CustomerStatus" Value="@CustomerStatus.Active">Aktif</MudSelectItem>
                                        <MudSelectItem T="CustomerStatus" Value="@CustomerStatus.Inactive">Pasif</MudSelectItem>
                                        <MudSelectItem T="CustomerStatus" Value="@CustomerStatus.Prospect">Aday Müşteri</MudSelectItem>
                                        <MudSelectItem T="CustomerStatus" Value="@CustomerStatus.Former">Eski Müşteri</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Contact Information -->
                <MudItem xs="12">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">İletişim Bilgileri</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="model.Email"
                                                Label="E-posta *"
                                                Variant="Variant.Outlined"
                                                InputType="InputType.Email"
                                                Required="true"
                                                For="@(() => model.Email)" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="model.Phone"
                                                Label="Telefon *"
                                                Variant="Variant.Outlined"
                                                Required="true"
                                                Mask="@(new PatternMask("(000) 000-0000"))"
                                                For="@(() => model.Phone)" />
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Form Actions -->
                <MudItem xs="12">
                    <MudStack Row Spacing="3" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Outlined" 
                                 Color="Color.Default"
                                 OnClick="GoBack">
                            İptal
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Submit" 
                                 Variant="Variant.Filled" 
                                 Color="Color.Primary"
                                 StartIcon="@Icons.Material.Filled.Save"
                                 Disabled="@saving">
                            @if (saving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                                <MudText Class="ms-2">Kaydediliyor...</MudText>
                            }
                            else
                            {
                                <MudText>@(IsEdit ? "Güncelle" : "Kaydet")</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int? CustomerId { get; set; }

    private CreateOrUpdateCustomerDto model = new();
    private bool saving = false;

    private bool IsEdit => CustomerId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            await LoadCustomer();
        }
        else
        {
            // Set default values for new customer
            model.Status = CustomerStatus.Active;
            model.Gender = Gender.Male; // Set default
        }
    }

    private async Task LoadCustomer()
    {
        try
        {
            var customer = await CustomerService.GetCustomerByIdAsync(CustomerId!.Value);
            if (customer != null)
            {
                model = new CreateOrUpdateCustomerDto
                {
                    FirstName = customer.Data.FirstName,
                    LastName = customer.Data.LastName,
                    Email = customer.Data.Email,
                    Phone = customer.Data.Phone,
                    IdentificationNo = customer.Data.IdentificationNo,
                    DateOfBirth = customer.Data.DateOfBirth,
                    Gender = customer.Data.Gender,
                    Status = customer.Data.Status
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Müşteri bilgileri yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            GoBack();
        }
    }

    private async Task OnValidSubmit()
    {
        saving = true;
        try
        {
            if (IsEdit)
            {
                var updateResult = await CustomerService.UpdateCustomerAsync(CustomerId!.Value, model);
                if (updateResult.IsSuccess)
                {
                    Snackbar.Add("Müşteri başarıyla güncellendi", MudBlazor.Severity.Success);
                    GoBack();
                }
                else
                {
                    // If there are validation errors, show them
                    if (updateResult.Errors?.Any() == true)
                    {
                        foreach (var error in updateResult.Errors)
                        {
                            Snackbar.Add(error, MudBlazor.Severity.Warning);
                        }
                    }
                }
            }
            else
            {
                var createResult = await CustomerService.CreateCustomerAsync(model);
                if (createResult.IsSuccess)
                {
                    Snackbar.Add("Müşteri başarıyla oluşturuldu", MudBlazor.Severity.Success);
                    GoBack();
                }
                else
                {
                    // If there are validation errors, show them
                    if (createResult.Errors?.Any() == true)
                    {
                        foreach (var error in createResult.Errors)
                        {
                            Snackbar.Add(error, MudBlazor.Severity.Warning);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Beklenmeyen hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/customers");
    }
}