@page "/customers"
@page "/customers/list"
@layout Layout.MainLayout

@using IAMS.Application.DTOs.Customer
@using IAMS.Application.Interfaces
@using IAMS.Application.Services.Customers
@using IAMS.MultiTenancy.Interfaces
@using IAMS.Domain.Enums
@using IAMS.Web.Components.Shared
@inject ICustomerService CustomerService
@inject ITenantContextAccessor TenantContext
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IPopoverService PopoverService

<PageTitle>Müşteriler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="Icons.Material.Filled.People" Class="mr-3" />
                Müşteriler
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NavigateToCreate">
                Yeni Müşteri
            </MudButton>
        </MudStack>

        <!-- Search and Filters -->
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="searchTerm"
                                      Label="Ara..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnDebounceIntervalElapsed="OnSearch"
                                      DebounceInterval="300" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect @bind-Value="selectedStatus"
                                   Label="Durum"
                                   Variant="Variant.Outlined"
                                   Clearable="true">
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Active">Aktif</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Inactive">Pasif</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Prospect">Aday</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Suspended">Iptal edilmiş</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Blacklisted">Kara Listede</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Former">Eski</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="fromDate"
                                       Label="Başlangıç Tarihi"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   OnClick="ClearFilters">
                            Temizle
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Data Table -->
        <MudCard>
            <MudDataGrid T="CustomerDto"
                         Items="@customers"
                         Loading="@loading"
                         Hover="true"
                         Striped="true"
                         ReadOnly="false"
                         EditMode="DataGridEditMode.Cell"
                         Dense="true"
                         Height="600px"
                         FixedHeader="true"
                         Virtualize="@virtualizeEnabled">

                <Columns>
                    <PropertyColumn Property="x => x.CustomerCode" Title="Müşteri Kodu" />
                    <PropertyColumn Property="x => x.FirstName" Title="Ad" />
                    <PropertyColumn Property="x => x.LastName" Title="Soyad" />
                    <PropertyColumn Property="x => x.Email" Title="E-posta" />
                    <PropertyColumn Property="x => x.Phone" Title="Telefon" />

                    <TemplateColumn Title="Durum" CellClass="d-flex justify-center">
                        <CellTemplate>
                            <MudChip Color="@GetStatusColor(context.Item.Status)"
                                     Size="Size.Small"
                                     Variant="Variant.Filled">
                                @GetStatusText(context.Item.Status)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.CreatedDate"
                                    Title="Kayıt Tarihi"
                                    Format="dd.MM.yyyy" />

                    <TemplateColumn CellClass="d-flex justify-end" Sortable="false">
                        <CellTemplate>
                            <MudButtonGroup>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => ViewCustomer(context.Item.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Secondary"
                                               OnClick="@(() => EditCustomer(context.Item.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteCustomer(context.Item))" />
                            </MudButtonGroup>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="CustomerDto" />
                </PagerContent>

                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.h6">Müşteri bulunamadı</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">
                            Arama kriterlerinizi değiştirin veya yeni müşteri ekleyin.
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private List<CustomerDto> customers = new();
    private bool loading = true;
    private bool virtualizeEnabled = true;

    // Search and filter parameters
    private string searchTerm = string.Empty;
    private CustomerStatus selectedStatus;
    private DateTime? fromDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            var result = await CustomerService.GetCustomersAsync(new CustomerQueryParams
            {
                SearchTerm = searchTerm,
                Status = selectedStatus,
                CreatedFrom = fromDate,
                PageSize = 1000 // Adjust based on your needs
            });

            customers = result.Data.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Müşteriler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnSearch()
    {
        await LoadCustomers();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        fromDate = null;
        await LoadCustomers();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/customers/create");
    }

    private void ViewCustomer(int customerId)
    {
        Navigation.NavigateTo($"/customers/{customerId}");
    }

    private void EditCustomer(int customerId)
    {
        Navigation.NavigateTo($"/customers/{customerId}/edit");
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"{customer.FirstName} {customer.LastName} isimli müşteriyi silmek istediğinizden emin misiniz?" },
            { x => x.ButtonText, "Sil" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Müşteri Sil", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await CustomerService.DeleteCustomerAsync(customer.Id);
                Snackbar.Add("Müşteri başarıyla silindi", MudBlazor.Severity.Success);
                await LoadCustomers();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Müşteri silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private Color GetStatusColor(CustomerStatus status)
    {
        return status switch
        {
            CustomerStatus.Active => Color.Success,
            CustomerStatus.Inactive => Color.Default,
            CustomerStatus.Suspended => Color.Warning,
            CustomerStatus.Blacklisted => Color.Error,
            CustomerStatus.Former => Color.Surface,
            _ => Color.Default
        };
    }

    private string GetStatusText(CustomerStatus status)
    {
        return status switch
        {
            CustomerStatus.Active => "Aktif",
            CustomerStatus.Inactive => "Pasif",
            CustomerStatus.Prospect => "Aday",
            CustomerStatus.Suspended => "Iptal edilmiş",
            CustomerStatus.Blacklisted => "Kara listede",
            CustomerStatus.Former => "Eski",
            _ => "Bilinmiyor"
        };
    }
}