@page "/customers"
@page "/customers/list"
@layout Layout.MainLayout
@attribute [Authorize]

@using IAMS.Shared.DTOs.Customer
@using IAMS.Shared.DTOs.Currency
@using IAMS.Application.Interfaces
@using IAMS.MultiTenancy.Interfaces
@using IAMS.Domain.Enums
@using IAMS.Shared.QueryParams
@using IAMS.Web.Components.Shared
@using IAMS.Web.Components.Shared.Dialogs
@using IAMS.Web.Services.ApiClient
@using IAMS.Web.Services
@inject ICustomersApiClient CustomersApi
@inject IPaymentsApiClient PaymentsApi
@inject ICurrenciesApiClient CurrenciesApi
@inject ITenantContextAccessor TenantContext
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserPreferencesService PreferencesService

<PageTitle>Müşteriler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudStack Spacing="3">
        <!-- Search and Filters -->
        <MudCard Elevation="3">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="7">
                        <MudTextField @bind-Value="searchTerm"
                                      Label="Ara..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnDebounceIntervalElapsed="OnSearch"
                                      DebounceInterval="300" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCheckBox Value="filterByOutstandingBalance"
                                     Label="Sadece Bakiyesi Olanlar"
                                     Color="Color.Error"
                                     T="bool"
                                     Size="Size.Medium"
                                     ValueChanged="@OnOutstandingBalanceFilterChanged"
                                     Style="font-weight: 500;" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="ClearFilters"
                                   FullWidth="true"
                                   Size="Size.Medium">
                            Temizle
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Customer Data Grid -->
        <MudCard Elevation="3">
            <MudDataGrid T="CustomerDto"
                         Items="@customers"
                         Loading="@loading"
                         Hover="true"
                         Striped="true"
                         Virtualize="true"
                         FixedHeader="true"
                         Height="650px"
                         RowsPerPage="10"
                         Dense="false"
                         RowStyle="cursor: pointer"
                         RowClick="@OnRowClick">
                <ToolBarContent>
                    <MudText Typo="Typo.h5" Style="font-weight: 600;">Cari Kart</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <Columns>
                    @if (viewMode == ListViewMode.Simple)
                    {
                        <!-- Simple View Columns -->
                        <TemplateColumn Title="Müşteri Kodu" Sortable="true" SortBy="x => x.CustomerCode">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-size: 0.95rem; font-weight: 500;">@context.Item.CustomerCode</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Ad Soyad" Sortable="true" SortBy="x => x.FirstName">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-size: 0.95rem; font-weight: 600;">
                                    @context.Item.FirstName @context.Item.LastName
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Poliçe Sayısı" Sortable="true" SortBy="x => x.ActivePolicyCount">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-size: 0.95rem; text-align: center;">
                                    @context.Item.ActivePolicyCount
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bakiye" Sortable="false">
                            <CellTemplate>
                                @{
                                    var balance = GetCustomerBalance(context.Item.Id);
                                    var hasBalance = balance != "-";
                                }
                                <MudText Typo="Typo.body1"
                                         Style="@($"font-size: 1rem; font-weight: 600; {(hasBalance ? "color: #d32f2f;" : "")}")">
                                    @balance
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    else
                    {
                        <!-- Detailed View Columns -->
                        <TemplateColumn Title="Müşteri" Sortable="true" SortBy="x => x.FirstName">
                            <CellTemplate>
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                        @context.Item.FirstName.FirstOrDefault()@context.Item.LastName.FirstOrDefault()
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body1" Style="font-weight: 600;">
                                            @context.Item.FirstName @context.Item.LastName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @context.Item.Email
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Kod" Sortable="true" SortBy="x => x.CustomerCode">
                            <CellTemplate>
                                <MudChip T="String" Size="Size.Small" Color="Color.Info">
                                    @context.Item.CustomerCode
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Telefon" Sortable="false">
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.Phone))
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2">@context.Item.Phone</MudText>
                                    </MudStack>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Poliçeler" Sortable="true" SortBy="x => x.ActivePolicyCount">
                            <CellTemplate>
                                @if (context.Item.ActivePolicyCount > 0)
                                {
                                    <MudChip T="String" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Assignment">
                                        @context.Item.ActivePolicyCount Aktif
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Poliçe yok</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bakiye" Sortable="false">
                            <CellTemplate>
                                @{
                                    var balance = GetCustomerBalance(context.Item.Id);
                                    var hasBalance = balance != "-";
                                }
                                @if (hasBalance)
                                {
                                    <MudChip T="String" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Warning">
                                        @balance
                                    </MudChip>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Title="Bakiye yok" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="İşlemler" CellClass="d-flex justify-end" Sortable="false">
                        <CellTemplate>
                            <MudStack Row Spacing="2" @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                               Color="Color.Success"
                                               Size="Size.Medium"
                                               OnClick="@(() => OpenPaymentDialog(context.Item.Id))"
                                               Title="Ödeme Kaydet" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="@(() => EditCustomer(context.Item.Id))"
                                               Title="Düzenle" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Medium"
                                               OnClick="@(() => DeleteCustomer(context.Item))"
                                               Title="Sil" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <LoadingContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText>Müşteriler yükleniyor...</MudText>
                    </MudStack>
                </LoadingContent>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                                 Style="font-size: 4rem;"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                            Müşteri bulunamadı
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @if (string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <text>Henüz hiç müşteri eklenmemiş. İlk müşteriyi eklemek için "Yeni Müşteri" butonunu kullanın.</text>
                            }
                            else
                            {
                                <text>Arama kriterlerinize uygun müşteri bulunamadı. Farklı arama terimleri deneyin.</text>
                            }
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudCard>

        <!-- Statistics Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Müşteri</MudText>
                                <MudText Typo="Typo.h4">@totalCustomers</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aktif Müşteri</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Success">@activeCustomers</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bu Ay Yeni</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Info">@newCustomersThisMonth</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Info" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Poliçeli Müşteri</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Warning">@customersWithPolicies</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Warning" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private List<CustomerDto> customers = new();
    private Dictionary<int, Dictionary<string, decimal>> customerBalances = new();
    private List<CurrencyDto> currencies = new();
    private bool loading = true;
    private ListViewMode viewMode = ListViewMode.Simple;

    // Search and filter parameters
    private string searchTerm = string.Empty;
    private string? filterType = null;
    private bool filterByOutstandingBalance = false;

    // Statistics
    private int totalCustomers = 0;
    private int activeCustomers = 0;
    private int newCustomersThisMonth = 0;
    private int customersWithPolicies = 0;

    protected override async Task OnInitializedAsync()
    {
        // Load user preferences for view mode
        viewMode = await PreferencesService.GetListViewModeAsync();

        // Read filter query parameter from URL
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        filterType = query["filter"];

        // Set filter from URL if present
        if (filterType == "outstanding")
        {
            filterByOutstandingBalance = true;
        }

        await Task.WhenAll(
            LoadCustomers(),
            LoadBalances(),
            LoadStatistics(),
            LoadCurrencies()
        );
    }

    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            // If filtering for outstanding balance, use the payments endpoint
            if (filterByOutstandingBalance)
            {
                var outstandingCustomers = await PaymentsApi.GetCustomersWithOutstandingBalanceAsync();
                if (outstandingCustomers != null && outstandingCustomers.Any())
                {
                    // Get full customer details for each customer with outstanding balance
                    var customerTasks = outstandingCustomers.Select(async c =>
                    {
                        var customerResult = await CustomersApi.GetCustomerByIdAsync(c.CustomerId);
                        return customerResult.IsSuccess ? customerResult.Data : null;
                    });

                    var customerResults = await Task.WhenAll(customerTasks);
                    customers = customerResults.Where(c => c != null).ToList()!;
                }
                else
                {
                    customers = new List<CustomerDto>();
                }
            }
            else
            {
                var queryParams = new CustomerQueryParams
                {
                    SearchTerm = searchTerm,
                    PageSize = 1000,
                    PageNumber = 1
                };

                var result = await CustomersApi.GetCustomersAsync(queryParams);
                if (result.IsSuccess && result.Data != null)
                {
                    customers = result.Data.Items.ToList();
                }
                else
                {
                    customers = new List<CustomerDto>();
                    if (!string.IsNullOrEmpty(result.Message))
                    {
                        Snackbar.Add(result.Message, MudBlazor.Severity.Warning);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Müşteriler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            customers = new List<CustomerDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var statisticsResult = await CustomersApi.GetCustomerStatisticsAsync();
            if (statisticsResult.IsSuccess && statisticsResult.Data != null)
            {
                var stats = statisticsResult.Data;
                totalCustomers = stats.TotalCustomers;
                activeCustomers = stats.ActiveCustomers;
                newCustomersThisMonth = stats.NewCustomersThisMonth;
                customersWithPolicies = stats.CustomersWithActivePolicies;
            }
        }
        catch (Exception ex)
        {
            // Log error but don't show to user for statistics
            Console.WriteLine($"Statistics loading error: {ex.Message}");
        }
    }

    private async Task LoadBalances()
    {
        try
        {
            var balancesResult = await CustomersApi.GetCustomersWithBalancesAsync();
            if (balancesResult.IsSuccess && balancesResult.Data != null)
            {
                customerBalances.Clear();
                foreach (var item in balancesResult.Data)
                {
                    if (!customerBalances.ContainsKey(item.Id))
                    {
                        customerBalances[item.Id] = new Dictionary<string, decimal>();
                    }
                    customerBalances[item.Id][item.Currency] = item.Balance;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Balances loading error: {ex.Message}");
        }
    }

    private async Task OnSearch()
    {
        await LoadCustomers();
        await LoadBalances();
    }

    private async Task OnOutstandingBalanceFilterChanged(bool value)
    {
        filterByOutstandingBalance = value;
        await LoadCustomers();
        await LoadBalances();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        filterByOutstandingBalance = false;
        await LoadCustomers();
        await LoadBalances();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrenciesApi.GetCurrenciesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                currencies = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Currencies loading error: {ex.Message}");
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<CustomerDto> args)
    {
        Navigation.NavigateTo($"/customers/{args.Item.Id}");
    }

    private async Task OpenPaymentDialog(int customerId)
    {
        // Determine default currency based on customer's largest outstanding balance
        int? defaultCurrencyId = null;

        if (customerBalances.ContainsKey(customerId) && customerBalances[customerId].Any())
        {
            // Find the currency with the largest outstanding balance
            var largestBalanceCurrency = customerBalances[customerId]
                .OrderByDescending(b => b.Value)
                .FirstOrDefault();

            if (largestBalanceCurrency.Value > 0)
            {
                // Find the currency ID by matching the currency code
                var currency = currencies.FirstOrDefault(c => c.Code == largestBalanceCurrency.Key);
                if (currency != null)
                {
                    defaultCurrencyId = currency.Id;
                }
            }
        }

        var parameters = new DialogParameters
        {
            ["CustomerId"] = customerId,
            ["Currencies"] = currencies,
            ["DefaultCurrencyId"] = defaultCurrencyId
        };

        var dialog = await DialogService.ShowAsync<AddCustomerPaymentDialog>("Yeni Ödeme Kaydet", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadBalances();
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/customers/create");
    }

    private void EditCustomer(int customerId)
    {
        Navigation.NavigateTo($"/customers/{customerId}/edit");
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"{customer.FirstName} {customer.LastName} isimli müşteriyi silmek istediğinizden emin misiniz?" },
            { x => x.ButtonText, "Sil" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Müşteri Sil", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var deleteResult = await CustomersApi.DeleteCustomerAsync(customer.Id);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add("Müşteri başarıyla silindi", MudBlazor.Severity.Success);
                    await LoadCustomers();
                    await LoadStatistics();
                }
                else
                {
                    Snackbar.Add(deleteResult.Message ?? "Müşteri silinirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Müşteri silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private string GetCustomerBalance(int customerId)
    {
        if (!customerBalances.ContainsKey(customerId) || !customerBalances[customerId].Any())
        {
            return "-";
        }

        var balances = customerBalances[customerId]
            .Where(b => b.Value != 0)
            .Select(b => $"{b.Value:N2} {b.Key}")
            .ToList();

        return balances.Any() ? string.Join(" | ", balances) : "-";
    }
}