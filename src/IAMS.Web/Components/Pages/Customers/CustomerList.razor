@page "/customers"
@using IAMS.Application.DTOs.Customer
@using IAMS.Application.Interfaces
@using IAMS.Application.Services.Customers
@using MudBlazor
@inject ICustomerService CustomerService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Müşteriler - IAMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <!-- Page Header -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-space-between align-center">
            <div>
                <MudText Typo="Typo.h4" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                    Müşteriler
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Toplam @_totalCount müşteri
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Yeni Müşteri
            </MudButton>
        </div>
    </MudPaper>

    <!-- Search and Filters -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_searchTerm"
                              Label="Müşteri Ara"
                              Placeholder="Ad, soyad veya e-posta ile ara..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyUp="OnSearchKeyUp"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect @bind-Value="_pageSize" Label="Sayfa Başına" T="int">
                    <MudSelectItem Value="10">10</MudSelectItem>
                    <MudSelectItem Value="25">25</MudSelectItem>
                    <MudSelectItem Value="50">50</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSearch">
                    Temizle
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Customer Table -->
    <MudPaper Elevation="1">
        @if (_loading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_customers.Any())
        {
            <MudDataGrid Items="_customers" 
                         Hover="true" 
                         Striped="true"
                         SortMode="SortMode.Single">
                <Columns>
                    <PropertyColumn Property="x => x.FullName" Title="Ad Soyad">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">
                                    @context.Item.FirstName.First()@context.Item.LastName.First()
                                </MudAvatar>
                                @* <div>
                                    <MudText Typo="Typo.body2">@context.Item.FullName</MudText>
                                    @if (!string.IsNullOrEmpty(context.Item.NationalId))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            TC: @context.Item.NationalId
                                        </MudText>
                                    }
                                </div> *@
                            </div>
                        </CellTemplate>
                    </PropertyColumn>
                    
                    <PropertyColumn Property="x => x.Email" Title="E-posta" />
                    
                    <PropertyColumn Property="x => x.Phone" Title="Telefon">
                        <CellTemplate>
                            @if (!string.IsNullOrEmpty(context.Item.Phone))
                            {
                                <MudLink Href="@($"tel:{context.Item.Phone}")">
                                    @context.Item.Phone
                                </MudLink>
                            }
                            else
                            {
                                <MudText Color="Color.Secondary">-</MudText>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    
                    <PropertyColumn Property="x => x.PolicyCount" Title="Poliçe Sayısı">
                        <CellTemplate>
                            <MudChip Size="Size.Small" Color="Color.Info">
                                @context.Item.PolicyCount
                            </MudChip>
                        </CellTemplate>
                    </PropertyColumn>
                    
                    <PropertyColumn Property="x => x.CreatedDate" Title="Kayıt Tarihi">
                        <CellTemplate>
                            @context.Item.CreatedDate.ToString("dd/MM/yyyy")
                        </CellTemplate>
                    </PropertyColumn>
                    
                    <TemplateColumn Title="İşlemler" Sortable="false">
                        <CellTemplate>
                            <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Title="Detaylar"
                                               OnClick="() => ViewCustomer(context.Item.Id)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Warning"
                                               Title="Düzenle"
                                               OnClick="() => EditCustomer(context.Item)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Title="Sil"
                                               OnClick="() => DeleteCustomer(context.Item)" />
                            </MudButtonGroup>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
            
            <!-- Pagination -->
            <div class="d-flex justify-center pa-4">
                <MudPagination Count="_totalPages" 
                               @bind-Selected="_currentPage"
                               BoundaryCount="1"
                               MiddleCount="3"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.People" 
                         Style="font-size: 4rem;" 
                         Color="Color.Secondary" 
                         Class="mb-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Müşteri bulunamadı</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    @if (string.IsNullOrEmpty(_searchTerm))
                    {
                        <span>Henüz hiç müşteri eklenmemiş.</span>
                    }
                    else
                    {
                        <span>"@_searchTerm" araması için sonuç bulunamadı.</span>
                    }
                </MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    İlk Müşteriyi Ekle
                </MudButton>
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<CustomerDto> _customers = new();
    private bool _loading = true;
    private string _searchTerm = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalCount = 0;
    private int _totalPages = 1;
    private Timer? _searchTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            CustomerQueryParams queryParams = new CustomerQueryParams
            {
                PageNumber = _currentPage,
                PageSize = _pageSize,
                SearchTerm = _searchTerm
            };
            var result = await CustomerService.GetCustomersAsync(queryParams);
            _customers = result.Data.Items;
            _totalCount = result.Data.TotalCount;
            _totalPages = result.Data.TotalPages;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Müşteriler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchTimer?.Dispose();
        _searchTimer = new Timer(async _ =>
        {
            _currentPage = 1;
            await InvokeAsync(LoadCustomers);
        }, null, 500, Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        _searchTerm = "";
        _currentPage = 1;
        await LoadCustomers();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CustomerCreateDialog>("Yeni Müşteri");
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadCustomers();
            Snackbar.Add("Müşteri başarıyla oluşturuldu!", MudBlazor.Severity.Success);
        }
    }

    private async Task EditCustomer(CustomerDto customer)
    {
        // var parameters = new DialogParameters<CustomerEditDialog>
        // {
        //     { x => x.Customer, customer }
        // };

        // var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Müşteri Düzenle", parameters);
        // var result = await dialog.Result;

        // if (!result.Canceled)
        // {
        //     await LoadCustomers();
        //     Snackbar.Add("Müşteri başarıyla güncellendi!", MudBlazor.Severity.Success);
        // }
    }

    private void ViewCustomer(int customerId)
    {
        // Navigate to customer details page
        // Navigation.NavigateTo($"/customers/{customerId}");
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Müşteriyi Sil",
            $"{customer.FullName} adlı müşteriyi silmek istediğinizden emin misiniz?",
            yesText: "Sil", cancelText: "İptal");

        if (confirm == true)
        {
            try
            {
                await CustomerService.DeleteCustomerAsync(customer.Id);
                await LoadCustomers();
                Snackbar.Add("Müşteri başarıyla silindi!", MudBlazor.Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Müşteri silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    public void Dispose()
    {
        _searchTimer?.Dispose();
    }
}