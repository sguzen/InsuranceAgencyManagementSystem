@page "/customers"
@page "/customers/list"
@layout Layout.MainLayout

@using IAMS.Application.DTOs.Customer
@using IAMS.Application.Interfaces
@using IAMS.Application.Services.Customers
@using IAMS.MultiTenancy.Interfaces
@using IAMS.Domain.Enums
@using IAMS.Shared.QueryParams
@using IAMS.Web.Components.Shared
@inject ICustomerService CustomerService
@inject ITenantContextAccessor TenantContext
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Müşteriler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="Icons.Material.Filled.People" Class="mr-3" />
                Müşteriler
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NavigateToCreate">
                Yeni Müşteri
            </MudButton>
        </MudStack>

        <!-- Search and Filters -->
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="searchTerm"
                                      Label="Ara..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnDebounceIntervalElapsed="OnSearch"
                                      DebounceInterval="300" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect Value="@selectedStatus"
                                   ValueChanged="@((CustomerStatus value) => OnStatusChanged(value))"
                                   Label="Durum"
                                   Variant="Variant.Outlined"
                                   T="CustomerStatus"
                                   ToStringFunc="@(status => GetStatusText(status))"
                                   Clearable="true">
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Active">Aktif</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Inactive">Pasif</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Prospect">Aday</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Suspended">Iptal edilmiş</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Blacklisted">Kara Listede</MudSelectItem>
                            <MudSelectItem Value="@IAMS.Domain.Enums.CustomerStatus.Former">Eski</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="fromDate"
                                       Label="Başlangıç Tarihi"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudStack Row Spacing="1">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       OnClick="ClearFilters"
                                       FullWidth="true">
                                Temizle
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Statistics Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Müşteri</MudText>
                                <MudText Typo="Typo.h4">@totalCustomers</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aktif Müşteri</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Success">@activeCustomers</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Bu Ay Yeni</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Info">@newCustomersThisMonth</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Info" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Poliçeli Müşteri</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Warning">@customersWithPolicies</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Warning" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Customer Data Grid -->
        <MudCard>
            <MudDataGrid T="CustomerDto"
                         Items="@customers"
                         Loading="@loading"
                         Hover="true"
                         Striped="true"
                         Virtualize="true"
                         FixedHeader="true"
                         Height="600px"
                         RowsPerPage="25">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Müşteri Listesi</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchTerm"
                                  Placeholder="Hızlı arama..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Immediate="true"
                                  OnDebounceIntervalElapsed="OnSearch"
                                  DebounceInterval="300" />
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.CustomerCode" Title="Müşteri Kodu" />
                    <PropertyColumn Property="x => x.FirstName" Title="Ad" />
                    <PropertyColumn Property="x => x.LastName" Title="Soyad" />
                    <PropertyColumn Property="x => x.Email" Title="E-posta" />
                    <PropertyColumn Property="x => x.MobilePhoneNumber" Title="Telefon" />
                    <PropertyColumn Property="x => GetStatusText(x.Status)" Title="Durum" />
                    <PropertyColumn Property="x => x.ActivePolicyCount" Title="Poliçe Sayısı" />
                    <PropertyColumn Property="x => x.CreatedOn" Title="Kayıt Tarihi" />

                    <TemplateColumn Title="İşlemler" CellClass="d-flex justify-end" Sortable="false">
                        <CellTemplate>
                            <MudStack Row Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => ViewCustomer(context.Item.Id))"
                                               Title="Detayları Görüntüle" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => EditCustomer(context.Item.Id))"
                                               Title="Düzenle" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteCustomer(context.Item))"
                                               Title="Sil" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <LoadingContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText>Müşteriler yükleniyor...</MudText>
                    </MudStack>
                </LoadingContent>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                                 Style="font-size: 4rem;"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                            Müşteri bulunamadı
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @if (string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <text>Henüz hiç müşteri eklenmemiş. İlk müşteriyi eklemek için "Yeni Müşteri" butonunu kullanın.</text>
                            }
                            else
                            {
                                <text>Arama kriterlerinize uygun müşteri bulunamadı. Farklı arama terimleri deneyin.</text>
                            }
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private List<CustomerDto> customers = new();
    private bool loading = true;

    // Search and filter parameters
    private string searchTerm = string.Empty;
    private CustomerStatus selectedStatus;
    private DateTime? fromDate;

    // Statistics
    private int totalCustomers = 0;
    private int activeCustomers = 0;
    private int newCustomersThisMonth = 0;
    private int customersWithPolicies = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
        await LoadStatistics();
    }

    private async Task OnStatusChanged(CustomerStatus status)
    {
        selectedStatus = status;
        await OnSearch();
    }
    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            var queryParams = new CustomerQueryParams
            {
                SearchTerm = searchTerm,
                Status = selectedStatus,
                CreatedFrom = fromDate,
                PageSize = 1000,
                PageNumber = 1
            };

            var result = await CustomerService.GetCustomersAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                customers = result.Data.Items.ToList();
            }
            else
            {
                customers = new List<CustomerDto>();
                if (!string.IsNullOrEmpty(result.Message))
                {
                    Snackbar.Add(result.Message, MudBlazor.Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Müşteriler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            customers = new List<CustomerDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var statisticsResult = await CustomerService.GetCustomerStatisticsAsync();
            if (statisticsResult.IsSuccess && statisticsResult.Data != null)
            {
                var stats = statisticsResult.Data;
                totalCustomers = stats.TotalCustomers;
                activeCustomers = stats.ActiveCustomers;
                newCustomersThisMonth = stats.NewCustomersThisMonth;
                customersWithPolicies = stats.CustomersWithActivePolicies;
            }
        }
        catch (Exception ex)
        {
            // Log error but don't show to user for statistics
            Console.WriteLine($"Statistics loading error: {ex.Message}");
        }
    }

    private async Task OnSearch()
    {
        await LoadCustomers();
    }

    private async Task ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatus = CustomerStatus.Active;
        fromDate = null;
        await LoadCustomers();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/customers/create");
    }

    private void ViewCustomer(int customerId)
    {
        Navigation.NavigateTo($"/customers/{customerId}");
    }

    private void EditCustomer(int customerId)
    {
        Navigation.NavigateTo($"/customers/{customerId}/edit");
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"{customer.FirstName} {customer.LastName} isimli müşteriyi silmek istediğinizden emin misiniz?" },
            { x => x.ButtonText, "Sil" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Müşteri Sil", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var deleteResult = await CustomerService.DeleteCustomerAsync(customer.Id);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add("Müşteri başarıyla silindi", MudBlazor.Severity.Success);
                    await LoadCustomers();
                    await LoadStatistics();
                }
                else
                {
                    Snackbar.Add(deleteResult.Message ?? "Müşteri silinirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Müşteri silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private Color GetStatusColor(CustomerStatus status)
    {
        return status switch
        {
            CustomerStatus.Active => Color.Success,
            CustomerStatus.Inactive => Color.Warning,
            CustomerStatus.Blacklisted => Color.Error,
            _ => Color.Default
        };
    }

    private string GetStatusText(CustomerStatus? status)
    {
        return status switch
        {
            CustomerStatus.Active => "Aktif",
            CustomerStatus.Inactive => "Pasif",
            CustomerStatus.Suspended => "Iptal edilmiş",
            CustomerStatus.Blacklisted => "Kara listede",
            CustomerStatus.Former => "Eski",
            _ => "Bilinmiyor"
        };
    }
}