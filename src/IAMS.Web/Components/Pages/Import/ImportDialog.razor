@using IAMS.Web.Services.ApiClient
@inject IPolicyImportApiClient ImportApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                <b>@Company.Name</b> sisteminden policeler import edilecek.
            </MudAlert>

            <MudText Typo="Typo.subtitle2">Tarih Filtresi (Opsiyonel)</MudText>

            <MudDateRangePicker @bind-DateRange="dateRange"
                                Label="Tarih Araligi"
                                Variant="Variant.Outlined"
                                DateFormat="dd.MM.yyyy"
                                Placeholder="Tum policeler" />

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Tarih araligi secmezseniz son 1 yildaki tum policeler import edilir.
            </MudText>

            @if (Company.LastImportDate.HasValue)
            {
                <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">
                    Son import: @Company.LastImportDate.Value.ToString("dd.MM.yyyy HH:mm")
                    <br />
                    Ayni policeler tekrar import edilirse guncellenir.
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Iptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@submitting">
            @if (submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Onizle ve Eslestir
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ImportableCompanyDto Company { get; set; } = null!;

    private DateRange? dateRange;
    private bool submitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        submitting = true;
        try
        {
            // Navigate to the existing Cari Kart mapping page with MySQL source params
            var url = $"/policies/import?source=mysql&masterCompanyId={Company.MasterInsuranceCompanyId}";

            if (dateRange?.Start != null)
                url += $"&startDate={dateRange.Start.Value:yyyy-MM-dd}";

            if (dateRange?.End != null)
                url += $"&endDate={dateRange.End.Value:yyyy-MM-dd}";

            // Close dialog and return the navigation URL
            MudDialog.Close(DialogResult.Ok(url));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            submitting = false;
        }
    }
}
