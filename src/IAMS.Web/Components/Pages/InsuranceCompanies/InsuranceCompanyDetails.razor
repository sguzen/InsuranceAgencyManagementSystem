@page "/insurance-companies/{CompanyId:int}"
@layout Layout.MainLayout
@rendermode InteractiveServer

@using IAMS.Application.DTOs.InsuranceCompany
@using IAMS.Application.DTOs.Policy
@using IAMS.Application.Services.InsuranceCompanies
@using IAMS.Application.Interfaces
@using IAMS.Domain.Enums
@using IAMS.Web.Components.Shared
@using MudBlazor

@attribute [Authorize]
@inject IInsuranceCompanyService InsuranceCompanyService
@inject IPolicyService PolicyService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(company?.Name ?? "Şirket Detayları")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
        }
        else if (company != null)
        {
            <!-- Header -->
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h4">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-3" />
                        @company.Name
                    </MudText>
                    @if (!string.IsNullOrEmpty(company.Description))
                    {
                        <MudText Typo="Typo.body1" Color="Color.Secondary">@company.Description</MudText>
                    }
                </MudStack>
                <MudStack Row Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                              StartIcon="@Icons.Material.Filled.ArrowBack"
                              OnClick="GoBack">
                        Geri
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                              Color="Color.Primary"
                              StartIcon="@Icons.Material.Filled.Edit"
                              OnClick="EditCompany">
                        Düzenle
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                              Color="Color.Error"
                              StartIcon="@Icons.Material.Filled.Delete"
                              OnClick="DeleteCompany">
                        Sil
                    </MudButton>
                </MudStack>
            </MudStack>

            <!-- Status Badge -->
            <MudStack Row Spacing="2">
                <MudChip Size="Size.Large" T="Boolean"
                         Color="@(company.IsActive ? Color.Success : Color.Default)"
                         Variant="Variant.Filled"
                         Icon="@(company.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)">
                    @(company.IsActive ? "Aktif" : "Pasif")
                </MudChip>
            </MudStack>

            <!-- Statistics Cards -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Color="Color.Info" />
                                <MudText Typo="Typo.h4">@activePoliciesCount</MudText>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aktif Poliçe</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.h4">@totalPoliciesCount</MudText>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Poliçe</MudText>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Success" />
                                <MudText Typo="Typo.h4">₺@company.TotalPremiums.ToString("N2")</MudText>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Prim (TRY)</MudText>
                                @if (company.CurrencyBreakdowns != null && company.CurrencyBreakdowns.Any())
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>Para Birimi Detayları:</strong></MudText>
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center" Style="margin-top: 4px;">
                                        @foreach (var breakdown in company.CurrencyBreakdowns)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @breakdown.CurrencySymbol@breakdown.TotalPremiums.ToString("N0") @breakdown.CurrencyCode
                                            </MudText>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Large" Color="Color.Warning" />
                                <MudText Typo="Typo.h4">₺@company.TotalCommissions.ToString("N2")</MudText>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Komisyon (TRY)</MudText>
                                @if (company.CurrencyBreakdowns != null && company.CurrencyBreakdowns.Any())
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"><strong>Para Birimi Detayları:</strong></MudText>
                                    <MudStack Spacing="0" AlignItems="AlignItems.Center" Style="margin-top: 4px;">
                                        @foreach (var breakdown in company.CurrencyBreakdowns)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @breakdown.CurrencySymbol@breakdown.TotalCommissions.ToString("N0") @breakdown.CurrencyCode
                                            </MudText>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Tabs -->
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <!-- Contact Information Tab -->
                <MudTabPanel Icon="@Icons.Material.Filled.ContactMail" Text="İletişim Bilgileri">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="1">
                                <MudCardContent>
                                    <MudStack Spacing="3">
                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">E-posta</MudText>
                                                @if (!string.IsNullOrEmpty(company.ContactEmail))
                                                {
                                                    <MudLink Href="@($"mailto:{company.ContactEmail}")" Typo="Typo.body1">
                                                        @company.ContactEmail
                                                    </MudLink>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body1" Color="Color.Secondary">Belirtilmemiş</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>

                                        <MudDivider />

                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Primary" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Telefon</MudText>
                                                @if (!string.IsNullOrEmpty(company.ContactPhone))
                                                {
                                                    <MudLink Href="@($"tel:{company.ContactPhone}")" Typo="Typo.body1">
                                                        @company.ContactPhone
                                                    </MudLink>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body1" Color="Color.Secondary">Belirtilmemiş</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>

                                        <MudDivider />

                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Start">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Adres</MudText>
                                                <MudText Typo="Typo.body1">
                                                    @(company.Address ?? "Belirtilmemiş")
                                                </MudText>
                                            </MudStack>
                                        </MudStack>

                                        <MudDivider />

                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Primary" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Website</MudText>
                                                @if (!string.IsNullOrEmpty(company.Website))
                                                {
                                                    <MudLink Href="@company.Website" Target="_blank" Typo="Typo.body1">
                                                        @company.Website <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                                    </MudLink>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body1" Color="Color.Secondary">Belirtilmemiş</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <!-- Metadata -->
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="1">
                                <MudCardContent>
                                    <MudStack Spacing="3">
                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Primary" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Oluşturulma Tarihi</MudText>
                                                <MudText Typo="Typo.body1">@company.CreatedOn.ToString("dd MMMM yyyy HH:mm")</MudText>
                                            </MudStack>
                                        </MudStack>

                                        @if (company.ModifiedOn.HasValue)
                                        {
                                            <MudDivider />
                                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Primary" />
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Son Güncelleme</MudText>
                                                    <MudText Typo="Typo.body1">@company.ModifiedOn.Value.ToString("dd MMMM yyyy HH:mm")</MudText>
                                                </MudStack>
                                            </MudStack>
                                        }

                                        @if (company.LastPolicyDate.HasValue)
                                        {
                                            <MudDivider />
                                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Son Poliçe Tarihi</MudText>
                                                    <MudText Typo="Typo.body1">@company.LastPolicyDate.Value.ToString("dd MMMM yyyy")</MudText>
                                                </MudStack>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Associated Policies Tab -->
                <MudTabPanel Icon="@Icons.Material.Filled.Description" Text="İlişkili Poliçeler" BadgeData="@activePoliciesCount" BadgeColor="Color.Info">
                    <MudStack Spacing="3">
                        <MudAlert MudBlazor.Severity="MudBlazor.Severity.Info" Variant="Variant.Text">
                            Bu şirketle ilişkili @totalPoliciesCount poliçe bulunmaktadır. (@activePoliciesCount aktif)
                        </MudAlert>

                        @if (loadingPolicies)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (mainPolicies.Count == 0)
                        {
                            <MudAlert MudBlazor.Severity="MudBlazor.Severity.Info">
                                Bu şirkete ait poliçe bulunmamaktadır.
                            </MudAlert>
                        }
                        else
                        {
                            <MudDataGrid T="PolicyDto"
                                         Items="@mainPolicies"
                                         Hover="true"
                                         Striped="true"
                                         Dense="true">
                                <Columns>
                                    <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 60px;">
                                        <CellTemplate>
                                            @if (HasEndorsements(context.Item.Id))
                                            {
                                                <MudIconButton Icon="@(IsExpanded(context.Item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ToggleExpand(context.Item.Id))"
                                                               Title="@(IsExpanded(context.Item.Id) ? "Zeyilleri Gizle" : "Zeyilleri Göster")" />
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="x => x.PolicyNumber" Title="Poliçe No" />
                                    <TemplateColumn Title="Z.No">
                                        <CellTemplate>
                                            <div style="text-align: center;">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                    <MudText Typo="Typo.body2">@context.Item.InnerCode</MudText>
                                                    @if (HasEndorsements(context.Item.Id))
                                                    {
                                                        <MudChip Size="Size.Small" Color="Color.Info" T="int">@GetEndorsementCount(context.Item.Id) Zeyil</MudChip>
                                                    }
                                                </MudStack>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Müşteri">
                                        <CellTemplate>
                                            @if (context.Item.Customer != null)
                                            {
                                                <MudText Typo="Typo.body2">@($"{context.Item.Customer.FirstName} {context.Item.Customer.LastName}")</MudText>
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="x => x.PolicyType!.Name" Title="Poliçe Türü" />
                                    <TemplateColumn Title="Başlangıç">
                                        <CellTemplate>
                                            <div style="text-align: center;">
                                                @context.Item.StartDate.ToString("dd.MM.yyyy")
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Bitiş">
                                        <CellTemplate>
                                            <div style="text-align: center;">
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2">@context.Item.EndDate.ToString("dd.MM.yyyy")</MudText>
                                                    @if (context.Item.DaysUntilExpiry <= 30 && context.Item.DaysUntilExpiry >= 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Warning">
                                                            @context.Item.DaysUntilExpiry gün kaldı
                                                        </MudText>
                                                    }
                                                    else if (context.Item.IsExpired)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Error">
                                                            @Math.Abs(context.Item.DaysUntilExpiry) gün geçti
                                                        </MudText>
                                                    }
                                                </MudStack>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Prim">
                                        <CellTemplate>
                                            <div style="text-align: right;">
                                                @context.Item.PremiumAmount.ToString("C2")
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Komisyon">
                                        <CellTemplate>
                                            <div style="text-align: right;">
                                                <MudText Typo="Typo.body2">@context.Item.CommissionAmount.ToString("C2")</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.CommissionRate.ToString("F2")%</MudText>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Durum">
                                        <CellTemplate>
                                            <div style="text-align: center;">
                                                <MudChip Size="Size.Small" Color="@GetPolicyStatusColor(context.Item.Status)" T="string">
                                                    @GetPolicyStatusText(context.Item.Status)
                                                </MudChip>
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="İşlemler">
                                        <CellTemplate>
                                            <div style="text-align: center;">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                               Size="Size.Small"
                                                               Color="Color.Primary"
                                                               OnClick="@(() => ViewPolicy(context.Item.Id))"
                                                               Title="Detayları Görüntüle" />
                                            </div>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <ChildRowContent>
                                    @if (IsExpanded(context.Item.Id) && HasEndorsements(context.Item.Id))
                                    {
                                        <td colspan="11">
                                            <MudCard Elevation="0" Class="ma-2">
                                                <MudCardHeader>
                                                    <CardHeaderContent>
                                                        <MudText Typo="Typo.subtitle2">
                                                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                                                            Zeyilnameler (@GetEndorsementCount(context.Item.Id))
                                                        </MudText>
                                                    </CardHeaderContent>
                                                </MudCardHeader>
                                                <MudCardContent>
                                                    <MudTable Items="@GetEndorsements(context.Item.Id)" Hover="true" Dense="true" Elevation="0">
                                                        <HeaderContent>
                                                            <MudTh>Z.No</MudTh>
                                                            <MudTh>Başlangıç</MudTh>
                                                            <MudTh>Bitiş</MudTh>
                                                            <MudTh Style="text-align: right">Prim</MudTh>
                                                            <MudTh Style="text-align: right">Komisyon</MudTh>
                                                            <MudTh Style="text-align: center">Durum</MudTh>
                                                            <MudTh Style="text-align: center">İşlemler</MudTh>
                                                        </HeaderContent>
                                                        <RowTemplate Context="endorsement">
                                                            <MudTd DataLabel="Z.No">
                                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                                    <MudText Typo="Typo.body2">@endorsement.InnerCode</MudText>
                                                                    <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                                                </MudStack>
                                                            </MudTd>
                                                            <MudTd DataLabel="Başlangıç">@endorsement.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                                            <MudTd DataLabel="Bitiş">@endorsement.EndDate.ToString("dd.MM.yyyy")</MudTd>
                                                            <MudTd DataLabel="Prim" Style="text-align: right">@endorsement.PremiumAmount.ToString("C2")</MudTd>
                                                            <MudTd DataLabel="Komisyon" Style="text-align: right">@endorsement.CommissionAmount.ToString("C2")</MudTd>
                                                            <MudTd DataLabel="Durum" Style="text-align: center">
                                                                <MudChip T="string" Color="@GetPolicyStatusColor(endorsement.Status)" Size="Size.Small">
                                                                    @GetPolicyStatusText(endorsement.Status)
                                                                </MudChip>
                                                            </MudTd>
                                                            <MudTd DataLabel="İşlemler" Style="text-align: center">
                                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                                               Size="Size.Small"
                                                                               Color="Color.Primary"
                                                                               OnClick="@(() => ViewPolicy(endorsement.Id))"
                                                                               Title="Detayları Görüntüle" />
                                                            </MudTd>
                                                        </RowTemplate>
                                                    </MudTable>
                                                </MudCardContent>
                                            </MudCard>
                                        </td>
                                    }
                                </ChildRowContent>
                            </MudDataGrid>
                        }
                    </MudStack>
                </MudTabPanel>

                <!-- Statistics Tab -->
                <MudTabPanel Icon="@Icons.Material.Filled.Analytics" Text="İstatistikler">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudCard Elevation="1">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Mali Özet (TRY)</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudSimpleTable Hover="true">
                                        <tbody>
                                            <tr>
                                                <td><MudText Typo="Typo.body1">Toplam Prim Tutarı (TRY)</MudText></td>
                                                <td><MudText Typo="Typo.body1" Align="Align.Right">₺@company.TotalPremiums.ToString("N2")</MudText></td>
                                            </tr>
                                            <tr>
                                                <td><MudText Typo="Typo.body1">Toplam Komisyon (TRY)</MudText></td>
                                                <td><MudText Typo="Typo.body1" Align="Align.Right">₺@company.TotalCommissions.ToString("N2")</MudText></td>
                                            </tr>
                                            <tr>
                                                <td><MudText Typo="Typo.body1" Color="Color.Primary"><strong>Ortalama Komisyon Oranı</strong></MudText></td>
                                                <td>
                                                    <MudText Typo="Typo.body1" Align="Align.Right" Color="Color.Primary">
                                                        <strong>
                                                            @if (company.TotalPremiums > 0)
                                                            {
                                                                @((company.TotalCommissions / company.TotalPremiums * 100).ToString("F2"))
                                                            }
                                                            else
                                                            {
                                                                @("0.00%")
                                                            }
                                                        </strong>
                                                    </MudText>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudCard Elevation="1">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Poliçe Özeti</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudSimpleTable Hover="true">
                                        <tbody>
                                            <tr>
                                                <td><MudText Typo="Typo.body1">Toplam Poliçe</MudText></td>
                                                <td><MudText Typo="Typo.body1" Align="Align.Right">@totalPoliciesCount</MudText></td>
                                            </tr>
                                            <tr>
                                                <td><MudText Typo="Typo.body1">Aktif Poliçe</MudText></td>
                                                <td><MudText Typo="Typo.body1" Align="Align.Right" Color="Color.Success">@activePoliciesCount</MudText></td>
                                            </tr>
                                            <tr>
                                                <td><MudText Typo="Typo.body1">Pasif Poliçe</MudText></td>
                                                <td><MudText Typo="Typo.body1" Align="Align.Right" Color="Color.Secondary">@inactivePoliciesCount</MudText></td>
                                            </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        @if (company.CurrencyBreakdowns != null && company.CurrencyBreakdowns.Any())
                        {
                            <MudItem xs="12">
                                <MudCard Elevation="1">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Para Birimi Bazında Dağılım</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudSimpleTable Hover="true">
                                            <thead>
                                                <tr>
                                                    <th><MudText Typo="Typo.body2"><strong>Para Birimi</strong></MudText></th>
                                                    <th><MudText Typo="Typo.body2" Align="Align.Right"><strong>Poliçe Sayısı</strong></MudText></th>
                                                    <th><MudText Typo="Typo.body2" Align="Align.Right"><strong>Toplam Prim</strong></MudText></th>
                                                    <th><MudText Typo="Typo.body2" Align="Align.Right"><strong>Toplam Komisyon</strong></MudText></th>
                                                    <th><MudText Typo="Typo.body2" Align="Align.Right"><strong>Komisyon Oranı</strong></MudText></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var breakdown in company.CurrencyBreakdowns)
                                                {
                                                    <tr>
                                                        <td>
                                                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Color="Color.Primary" />
                                                                <MudText Typo="Typo.body1">@breakdown.CurrencyCode (@breakdown.CurrencySymbol)</MudText>
                                                            </MudStack>
                                                        </td>
                                                        <td><MudText Typo="Typo.body1" Align="Align.Right">@breakdown.PolicyCount</MudText></td>
                                                        <td><MudText Typo="Typo.body1" Align="Align.Right">@breakdown.CurrencySymbol@breakdown.TotalPremiums.ToString("N2")</MudText></td>
                                                        <td><MudText Typo="Typo.body1" Align="Align.Right">@breakdown.CurrencySymbol@breakdown.TotalCommissions.ToString("N2")</MudText></td>
                                                        <td>
                                                            <MudText Typo="Typo.body1" Align="Align.Right" Color="Color.Primary">
                                                                @if (breakdown.TotalPremiums > 0)
                                                                {
                                                                    @((breakdown.TotalCommissions / breakdown.TotalPremiums * 100).ToString("F2"))
                                                                    <text>%</text>
                                                                }
                                                                else
                                                                {
                                                                    <text>0.00%</text>
                                                                }
                                                            </MudText>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <MudAlert MudBlazor.Severity="MudBlazor.Severity.Error">Şirket bulunamadı.</MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int CompanyId { get; set; }

    private InsuranceCompanyDto? company;
    private bool loading = true;
    private List<PolicyDto> policies = new();
    private List<PolicyDto> mainPolicies = new(); // Only main policies for display
    private Dictionary<int, List<PolicyDto>> endorsementsByPolicy = new(); // Endorsements grouped by main policy ID
    private HashSet<int> expandedPolicies = new(); // Track which policies are expanded
    private bool loadingPolicies = false;

    // Calculated statistics from actual loaded policies
    private int totalPoliciesCount = 0;
    private int activePoliciesCount = 0;
    private int inactivePoliciesCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCompany();
        await LoadPolicies();
    }

    private async Task LoadCompany()
    {
        loading = true;
        try
        {
            var result = await InsuranceCompanyService.GetInsuranceCompanyByIdAsync(CompanyId);
            if (result.IsSuccess && result.Data != null)
            {
                company = result.Data;
            }
            else
            {
                Snackbar.Add(result.Message ?? "Şirket bulunamadı", MudBlazor.Severity.Error);
                GoBack();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
            GoBack();
        }
        finally
        {
            loading = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/insurance-companies");
    private void EditCompany() => Navigation.NavigateTo($"/insurance-companies/{CompanyId}/edit");

    private async Task DeleteCompany()
    {
        if (company == null) return;

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"{company.Name} adlı şirketi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz." },
            { x => x.ButtonText, "Sil" },
            { x => x.Color, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Şirket Sil", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                var deleteResult = await InsuranceCompanyService.DeleteInsuranceCompanyAsync(CompanyId);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add("Şirket başarıyla silindi", MudBlazor.Severity.Success);
                    GoBack();
                }
                else
                {
                    Snackbar.Add(deleteResult.Message ?? "Silme işlemi başarısız", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task LoadPolicies()
    {
        loadingPolicies = true;
        try
        {
            var queryParams = new PolicyQueryParams
            {
                InsuranceCompanyId = CompanyId,
                PageSize = 1000,
                PageNumber = 1
            };

            var result = await PolicyService.GetPoliciesAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                policies = result.Data.Items.ToList();

                // Separate main policies from endorsements
                mainPolicies = policies.Where(p => p.InnerCode == "000").ToList();

                // Group endorsements by their main policy ID
                endorsementsByPolicy.Clear();
                var endorsements = policies.Where(p => p.InnerCode != "000" && p.OriginalPolicyId.HasValue).ToList();
                foreach (var endorsement in endorsements)
                {
                    if (!endorsementsByPolicy.ContainsKey(endorsement.OriginalPolicyId.Value))
                    {
                        endorsementsByPolicy[endorsement.OriginalPolicyId.Value] = new List<PolicyDto>();
                    }
                    endorsementsByPolicy[endorsement.OriginalPolicyId.Value].Add(endorsement);
                }

                // Sort endorsements by InnerCode
                foreach (var key in endorsementsByPolicy.Keys.ToList())
                {
                    endorsementsByPolicy[key] = endorsementsByPolicy[key].OrderBy(e => e.InnerCode).ToList();
                }

                // Calculate statistics from main policies only (not endorsements)
                totalPoliciesCount = mainPolicies.Count;
                activePoliciesCount = mainPolicies.Count(p => p.Status == PolicyStatus.Active);
                inactivePoliciesCount = mainPolicies.Count(p => p.Status != PolicyStatus.Active);
            }
            else
            {
                policies = new List<PolicyDto>();
                mainPolicies = new List<PolicyDto>();
                endorsementsByPolicy.Clear();
                totalPoliciesCount = 0;
                activePoliciesCount = 0;
                inactivePoliciesCount = 0;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Poliçeler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Warning);
        }
        finally
        {
            loadingPolicies = false;
        }
    }

    private void ViewPolicy(int policyId)
    {
        Navigation.NavigateTo($"/policies/{policyId}");
    }

    private Color GetPolicyStatusColor(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => Color.Success,
            PolicyStatus.Draft => Color.Info,
            PolicyStatus.Cancelled => Color.Error,
            PolicyStatus.Expired => Color.Warning,
            PolicyStatus.Suspended => Color.Secondary,
            _ => Color.Default
        };
    }

    private string GetPolicyStatusText(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => "Aktif",
            PolicyStatus.Draft => "Taslak",
            PolicyStatus.Cancelled => "İptal",
            PolicyStatus.Expired => "Süresi Dolmuş",
            PolicyStatus.Suspended => "Askıya Alınmış",
            _ => "Bilinmiyor"
        };
    }

    // Endorsement accordion methods
    private bool HasEndorsements(int policyId)
    {
        return endorsementsByPolicy.ContainsKey(policyId) && endorsementsByPolicy[policyId].Any();
    }

    private int GetEndorsementCount(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId].Count : 0;
    }

    private List<PolicyDto> GetEndorsements(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId] : new List<PolicyDto>();
    }

    private bool IsExpanded(int policyId)
    {
        return expandedPolicies.Contains(policyId);
    }

    private void ToggleExpand(int policyId)
    {
        if (expandedPolicies.Contains(policyId))
        {
            expandedPolicies.Remove(policyId);
        }
        else
        {
            expandedPolicies.Add(policyId);
        }
    }
}
