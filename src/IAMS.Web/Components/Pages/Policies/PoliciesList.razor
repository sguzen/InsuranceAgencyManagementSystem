    private Color GetStatusColor(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => Color.Success,
            PolicyStatus.Draft => Color.Info,
            PolicyStatus.Cancelled => Color.Error,
            PolicyStatus.Expired => Color.Warning,
            PolicyStatus.Suspended => Color.Secondary,
            _ => Color.Default
        };
    }

    private string GetStatusColorHex(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => "#4caf50",      // Green
            PolicyStatus.Draft => "#2196f3",       // Blue
            PolicyStatus.Cancelled => "#f44336",   // Red
            PolicyStatus.Expired => "#ff9800",     // Orange
            PolicyStatus.Suspended => "#9e9e9e",   // Grey
            _ => "#000000"
        };
    }

    private string GetStatusText(PolicyStatus? status)
    {
        if (status == null) return "Tümü";

        return status switch
        {
            PolicyStatus.Active => "Aktif",
            PolicyStatus.Draft => "Taslak",
            PolicyStatus.Cancelled => "İptal",
            PolicyStatus.Expired => "Süresi Dolmuş",
            PolicyStatus.Suspended => "Askıya Alınmış",
            _ => "Bilinmiyor"
        };
    }

    private string GetStateTypeShortText(StateType stateType)
    {
        return stateType switch
        {
            StateType.YeniPolice => "P",
            StateType.Tecdit => "T",
            StateType.Ilave => "V",
            StateType.Iade => "R",
            StateType.Iptal => "X",
            StateType.Yeniden => "Y",
            _ => stateType.ToString()
        };
    }

    // Endorsement accordion methods
    private bool HasEndorsements(int policyId)
    {
        return endorsementsByPolicy.ContainsKey(policyId) && endorsementsByPolicy[policyId].Any();
    }

    private int GetEndorsementCount(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId].Count : 0;
    }

    private List<PolicyDto> GetEndorsements(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId] : new List<PolicyDto>();
    }

    private bool IsExpanded(int policyId)
    {
        return expandedPolicies.Contains(policyId);
    }

    private void ToggleExpand(int policyId)
    {
        if (expandedPolicies.Contains(policyId))
        {
            expandedPolicies.Remove(policyId);
        }
        else
        {
            expandedPolicies.Add(policyId);
        }
    }
}