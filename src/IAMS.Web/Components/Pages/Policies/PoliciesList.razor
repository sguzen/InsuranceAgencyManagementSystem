@page "/policies"
@page "/policies/list"
@layout Layout.MainLayout
@attribute [Authorize]

@using IAMS.Domain.Enums
@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.QueryParams
@using IAMS.Web.Components.Shared
@using IAMS.Web.Components.Shared.Dialogs
@using IAMS.Web.Services.ApiClient
@using IAMS.Web.Services
@inject IPoliciesApiClient PoliciesApi
@inject IPolicyTypesApiClient PolicyTypesApi
@inject IPaymentsApiClient PaymentsApi
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IUserPreferencesService PreferencesService

<PageTitle>Poliçeler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudStack Spacing="3">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-3" />
                Poliçeler
            </MudText>
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Schedule"
                           Href="/policies/expiring">
                    Süresi Dolacaklar
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Upload"
                           Href="/policies/import">
                    İçe Aktar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    Yeni Poliçe
                </MudButton>
            </MudStack>
        </MudStack>

        <!-- Search and Filters -->
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="searchTerm"
                                      Label="Ara..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnDebounceIntervalElapsed="OnSearch"
                                      DebounceInterval="300"
                                      HelperText="Poliçe no, müşteri adı ile arayın" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect Value="selectedPolicyTypeId"
                                   ValueChanged="OnPolicyTypeChanged"
                                   Label="Poliçe Tipi"
                                   Variant="Variant.Outlined"
                                   T="int?"
                                   Clearable="true">
                            @if (policyTypes != null)
                            {
                                @foreach (var policyType in policyTypes)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)policyType.Id)">@policyType.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudCheckBox Value="filterByOutstandingBalance"
                                     Label="Sadece Bakiyesi Olanlar"
                                     Color="Color.Primary"
                                     T="bool"
                                     ValueChanged="@OnOutstandingBalanceFilterChanged" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudStack Row Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                           Color="Color.Primary"
                                           OnClick="OnSearch"
                                           Title="Filtrele" />
                            <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                           Color="Color.Secondary"
                                           OnClick="ClearFilters"
                                           Title="Temizle" />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Policies Data Grid -->
        <MudCard>
            <MudDataGrid T="PolicyDto"
                         ServerData="LoadServerData"
                         @ref="dataGrid"
                         Hover="true"
                         Striped="true"
                         FixedHeader="true"
                         Height="600px"
                         RowsPerPage="20"
                         RowStyle="cursor: pointer"
                         RowClick="@OnRowClick">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Poliçe Listesi</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchTerm"
                                  Placeholder="Hızlı arama..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Immediate="true"
                                  OnDebounceIntervalElapsed="OnSearch"
                                  DebounceInterval="300" />
                </ToolBarContent>
                <Columns>
                    @if (viewMode == ListViewMode.Simple)
                    {
                        <!-- Simple View Columns -->
                        <TemplateColumn Title="İşlemler" Sortable="false">
                            <CellTemplate>
                                <MudStack Row Spacing="2">
                                    <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                                   Color="Color.Success"
                                                   Size="Size.Medium"
                                                   OnClick="@(() => OpenPaymentDialog(context.Item.Id))"
                                                   Title="Ödeme Al" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Medium"
                                                   OnClick="@(() => DeletePolicy(context.Item))"
                                                   Title="Sil" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Poliçe No" Sortable="true" SortBy="x => x.PolicyNumber">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-size: 0.95rem; font-weight: 500;">
                                    @(context.Item.FormattedPolicyNumber ?? context.Item.PolicyNumber)
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Müşteri" Sortable="true" SortBy="x => x.Customer!.FirstName">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-size: 0.95rem; font-weight: 600;">
                                    @if (context.Item.Customer != null)
                                    {
                                        @($"{context.Item.Customer.FirstName} {context.Item.Customer.LastName}")
                                    }
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Poliçe Tipi" Sortable="true" SortBy="x => x.PolicyType!.Name">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.PolicyType?.Name</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Prim Tutarı" Sortable="true" SortBy="x => x.PremiumAmount">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="text-align: right;">
                                    @context.Item.CurrencySymbol@context.Item.PremiumAmount.ToString("N2")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bakiye" Sortable="false">
                            <CellTemplate>
                                @{
                                    var balance = GetPolicyBalance(context.Item.Id);
                                    var hasBalance = balance > 0;
                                }
                                <MudText Typo="Typo.body1"
                                         Style="@($"text-align: right; font-weight: 600; {(hasBalance ? "color: #d32f2f;" : "")}")">
                                    @if (hasBalance)
                                    {
                                        @($"{context.Item.CurrencySymbol}{balance:N2}")
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bitiş Tarihi" Sortable="true" SortBy="x => x.EndDate">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="text-align: center;">
                                    @context.Item.EndDate.ToString("dd.MM.yyyy")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Durum" Sortable="true" SortBy="x => x.Status">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    <MudText Typo="Typo.body2"
                                             Style="@($"font-weight: 500; color: {GetStatusColorHex(context.Item.Status)};")">
                                        @GetStatusText(context.Item.Status)
                                    </MudText>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                    else
                    {
                        <!-- Detailed View Columns -->
                        <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 60px;">
                            <CellTemplate>
                                @if (HasEndorsements(context.Item.Id))
                                {
                                    <MudIconButton Icon="@(IsExpanded(context.Item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ToggleExpand(context.Item.Id))"
                                                   Title="@(IsExpanded(context.Item.Id) ? "Zeyilleri Gizle" : "Zeyilleri Göster")" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="İşlemler" Sortable="false">
                            <CellTemplate>
                                <MudStack Row Spacing="2">
                                    <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                                   Color="Color.Success"
                                                   Size="Size.Medium"
                                                   OnClick="@(() => OpenPaymentDialog(context.Item.Id))"
                                                   Title="Ödeme Al" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Medium"
                                                   OnClick="@(() => DeletePolicy(context.Item))"
                                                   Title="Sil" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Poliçe No" Sortable="true" SortBy="x => x.PolicyNumber">
                            <CellTemplate>
                                <MudChip T="String" Size="Size.Small" Color="Color.Info">
                                    @(context.Item.FormattedPolicyNumber ?? context.Item.PolicyNumber)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Z.No">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                        <MudText Typo="Typo.body2">@context.Item.InnerCode</MudText>
                                        @if (HasEndorsements(context.Item.Id))
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Info" T="int">@GetEndorsementCount(context.Item.Id) Zeyil</MudChip>
                                        }
                                    </MudStack>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="TIP">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    <MudText Typo="Typo.caption">@GetStateTypeShortText(context.Item.StateType)</MudText>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Müşteri">
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">
                                    @if (context.Item.Customer != null)
                                    {
                                        @($"{context.Item.Customer.FirstName} {context.Item.Customer.LastName}")
                                    }
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.InsuranceCompany!.Name" Title="Sigorta Şirketi" />
                        <PropertyColumn Property="x => x.PolicyType!.Name" Title="Poliçe Tipi" />
                        <TemplateColumn Title="Araç">
                            <CellTemplate>
                                @if (context.Item.Vehicle != null)
                                {
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">
                                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" Class="mr-1" />
                                            @context.Item.Vehicle.PlateNumber
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @context.Item.Vehicle.BrandName @context.Item.Vehicle.ModelName
                                        </MudText>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Prim Tutarı">
                            <CellTemplate>
                                <div style="text-align: right;">
                                    @context.Item.CurrencySymbol@context.Item.PremiumAmount.ToString("N2")
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bakiye">
                            <CellTemplate>
                                <div style="text-align: right;">
                                    @{
                                        var balance = GetPolicyBalance(context.Item.Id);
                                        if (balance > 0)
                                        {
                                            <MudChip T="String" Size="Size.Small" Color="Color.Error">@context.Item.CurrencySymbol@balance.ToString("N2")</MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                        }
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Başlangıç">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    @context.Item.StartDate.ToString("dd.MM.yyyy")
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bitiş">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    <div>@context.Item.EndDate.ToString("dd.MM.yyyy")</div>
                                    @if (context.Item.DaysUntilExpiry <= 30 && context.Item.DaysUntilExpiry >= 0)
                                    {
                                        <div style="font-size: 0.75rem; color: var(--mud-palette-warning);">
                                            @context.Item.DaysUntilExpiry gün kaldı
                                        </div>
                                    }
                                    else if (context.Item.IsExpired)
                                    {
                                        <div style="font-size: 0.75rem; color: var(--mud-palette-error);">
                                            @Math.Abs(context.Item.DaysUntilExpiry) gün geçti
                                        </div>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Durum">
                            <CellTemplate>
                                <div style="text-align: center;">
                                    <MudChip T="string" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small">
                                        @GetStatusText(context.Item.Status)
                                    </MudChip>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
                <ChildRowContent>
                    @if (IsExpanded(context.Item.Id) && HasEndorsements(context.Item.Id))
                    {
                        <td colspan="13">
                            <MudCard Elevation="0" Class="ma-2">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                                            Zeyilnameler (@GetEndorsementCount(context.Item.Id))
                                        </MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudTable Items="@GetEndorsements(context.Item.Id)" Hover="true" Dense="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>Z.No</MudTh>
                                            <MudTh>TIP</MudTh>
                                            <MudTh>Başlangıç</MudTh>
                                            <MudTh>Bitiş</MudTh>
                                            <MudTh>Prim Tutarı</MudTh>
                                            <MudTh>Durum</MudTh>
                                            <MudTh>İşlemler</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="endorsement">
                                            <MudTd DataLabel="Z.No">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2">@endorsement.InnerCode</MudText>
                                                    <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="TIP">
                                                <MudText Typo="Typo.caption">@GetStateTypeShortText(endorsement.StateType)</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Başlangıç">@endorsement.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                            <MudTd DataLabel="Bitiş">
                                                <div>
                                                    <div>@endorsement.EndDate.ToString("dd.MM.yyyy")</div>
                                                    @if (endorsement.DaysUntilExpiry <= 30 && endorsement.DaysUntilExpiry >= 0)
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--mud-palette-warning);">
                                                            @endorsement.DaysUntilExpiry gün kaldı
                                                        </div>
                                                    }
                                                    else if (endorsement.IsExpired)
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--mud-palette-error);">
                                                            @Math.Abs(endorsement.DaysUntilExpiry) gün geçti
                                                        </div>
                                                    }
                                                </div>
                                            </MudTd>
                                            <MudTd DataLabel="Prim Tutarı" Style="text-align: right;">@endorsement.CurrencySymbol@endorsement.PremiumAmount.ToString("N2")</MudTd>
                                            <MudTd DataLabel="Durum">
                                                <MudChip T="string" Color="@GetStatusColor(endorsement.Status)" Size="Size.Small">
                                                    @GetStatusText(endorsement.Status)
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="İşlemler">
                                                <MudStack Row Spacing="1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Payment"
                                                                   Color="Color.Success"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => OpenPaymentDialog(endorsement.Id))"
                                                                   Title="Ödeme Al" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EditPolicy(endorsement.Id))"
                                                                   Title="Düzenle" />
                                                </MudStack>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudCardContent>
                            </MudCard>
                        </td>
                    }
                </ChildRowContent>
                <LoadingContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText>Poliçeler yükleniyor...</MudText>
                    </MudStack>
                </LoadingContent>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate"
                                 Style="font-size: 4rem;"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                            Poliçe bulunamadı
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @if (string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <text>Henüz hiç poliçe eklenmemiş. İlk poliçeyi eklemek için "Yeni Poliçe" butonunu kullanın.</text>
                            }
                            else
                            {
                                <text>Arama kriterlerinize uygun poliçe bulunamadı. Farklı arama terimleri deneyin.</text>
                            }
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private MudDataGrid<PolicyDto> dataGrid;
    private Dictionary<int, List<PolicyDto>> endorsementsByPolicy = new(); // Endorsements grouped by main policy ID
    private HashSet<int> expandedPolicies = new(); // Track which policies are expanded
    private List<IAMS.Shared.DTOs.PolicyType.PolicyTypeDto> policyTypes;
    private Dictionary<int, decimal> policyBalances = new(); // Policy outstanding balances
    private ListViewMode viewMode = ListViewMode.Detailed; // Default to detailed for policies
    private bool isInitialized = false;

    // Search and filter parameters
    private string searchTerm = string.Empty;
    private int? selectedPolicyTypeId;
    private bool filterByOutstandingBalance = false;

    protected override async Task OnInitializedAsync()
    {
        // Load user preferences for view mode
        viewMode = await PreferencesService.GetListViewModeAsync();

        // Load initial data
        await LoadPolicyTypes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            isInitialized = true;
            await Task.Delay(50);

            if (dataGrid != null)
            {
                try
                {
                    await dataGrid.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading initial data: {ex.Message}");
                }
            }
        }
    }

    private async Task<GridData<PolicyDto>> LoadServerData(GridState<PolicyDto> state)
    {
        try
        {
            Console.WriteLine($"LoadServerData called - Page: {state.Page}, PageSize: {state.PageSize}");

            var pageNumber = state.Page + 1; // MudBlazor uses 0-based index
            var pageSize = state.PageSize > 0 ? state.PageSize : 20; // Default to 20 if not set

            Console.WriteLine($"Fetching policies - PageNumber: {pageNumber}, PageSize: {pageSize}, SearchTerm: '{searchTerm}', PolicyTypeId: {selectedPolicyTypeId}");

            var queryParams = new PolicyQueryParams
            {
                SearchTerm = searchTerm,
                PolicyTypeId = selectedPolicyTypeId,
                PageSize = pageSize,
                PageNumber = pageNumber
            };

            var result = await PoliciesApi.GetPoliciesAsync(queryParams);
            Console.WriteLine($"API result - Success: {result.IsSuccess}, HasData: {result.Data != null}, ItemCount: {result.Data?.Items?.Count ?? 0}");
            if (result.IsSuccess && result.Data != null)
            {
                var mainPolicies = result.Data.Items.ToList();
                Console.WriteLine($"Main policies received: {mainPolicies.Count}");

                // Load endorsements for each policy (for the detailed view)
                endorsementsByPolicy.Clear();
                foreach (var policy in mainPolicies)
                {
                    // Load endorsements for this policy if needed
                    // For now, we'll load them on-demand when the row is expanded
                }

                // Load balances for the current page policies only (batch load)
                await LoadPolicyBalancesBatch(mainPolicies.Select(p => p.Id).ToList(), mainPolicies);

                // Filter by outstanding balance if enabled (client-side for now)
                if (filterByOutstandingBalance)
                {
                    mainPolicies = mainPolicies.Where(p => policyBalances.ContainsKey(p.Id) && policyBalances[p.Id] > 0).ToList();
                }

                Console.WriteLine($"Returning GridData - Items: {mainPolicies.Count}, TotalItems: {result.Data.TotalCount}");

                return new GridData<PolicyDto>
                {
                    Items = mainPolicies,
                    TotalItems = result.Data.TotalCount
                };
            }
            else
            {
                Console.WriteLine($"API call failed - Message: {result.Message}");
                if (!string.IsNullOrEmpty(result.Message))
                {
                    Snackbar.Add(result.Message, MudBlazor.Severity.Warning);
                }
                return new GridData<PolicyDto> { Items = new List<PolicyDto>(), TotalItems = 0 };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in LoadServerData: {ex}");
            Snackbar.Add($"Poliçeler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            return new GridData<PolicyDto> { Items = new List<PolicyDto>(), TotalItems = 0 };
        }
    }

    private async Task LoadPolicyTypes()
    {
        try
        {
            var result = await PolicyTypesApi.GetActiveTypesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                policyTypes = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Policy types loading error: {ex.Message}");
        }
    }

    private async Task LoadPolicyBalancesBatch(List<int> policyIds, List<PolicyDto> policies)
    {
        try
        {
            if (!policyIds.Any())
            {
                return;
            }

            // Batch load total payments for all policies in one query
            var totalPaymentsResult = await PaymentsApi.GetBatchTotalPaymentsByPolicyIdsAsync(policyIds);
            if (totalPaymentsResult.IsSuccess && totalPaymentsResult.Data != null)
            {
                var paymentTotals = totalPaymentsResult.Data;

                // Calculate balances for each policy
                foreach (var policy in policies)
                {
                    var totalPaid = paymentTotals.ContainsKey(policy.Id) ? paymentTotals[policy.Id] : 0;
                    var balance = policy.PremiumAmount - totalPaid;
                    policyBalances[policy.Id] = balance > 0 ? balance : 0;
                }
            }
            else
            {
                // Fallback: set balance to premium amount for all policies
                foreach (var policy in policies)
                {
                    policyBalances[policy.Id] = policy.PremiumAmount;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Policy balances loading error: {ex.Message}");
        }
    }

    private async Task OnSearch()
    {
        if (dataGrid != null)
        {
            await dataGrid.ReloadServerData();
        }
    }

    private async Task OnPolicyTypeChanged(int? value)
    {
        selectedPolicyTypeId = value;
        if (dataGrid != null)
        {
