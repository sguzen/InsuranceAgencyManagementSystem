    private async Task ActivatePolicy(PolicyDto policy)
    {
        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.ContentText, $"{policy.PolicyNumber} numaralı poliçeyi aktifleştirmek istediğinizden emin misiniz?" },
            { x => x.ButtonText, "Aktifleştir" },
            { x => x.Color, Color.Success }
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Poliçe Aktifleştir", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var activateResult = await PoliciesApi.ActivatePolicyAsync(policy.Id);
                if (activateResult.IsSuccess)
                {
                    Snackbar.Add("Poliçe başarıyla aktifleştirildi", MudBlazor.Severity.Success);
                    await LoadPolicies();
                    await LoadStatistics();
                }
                else
                {
                    Snackbar.Add(activateResult.Message ?? "Poliçe aktifleştirilirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Poliçe aktifleştirilirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

