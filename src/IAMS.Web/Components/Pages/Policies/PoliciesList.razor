@page "/policies"
@page "/policies/list"
@layout Layout.MainLayout

@using IAMS.Domain.Enums
@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.QueryParams
@using IAMS.Web.Components.Shared
@using IAMS.Web.Services.ApiClient
@inject IPoliciesApiClient PoliciesApi
@inject IPolicyTypesApiClient PolicyTypesApi
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Poliçeler</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-3" />
                Poliçeler
            </MudText>
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Schedule"
                           Href="/policies/expiring">
                    Süresi Dolacaklar (@expiringCount)
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.Upload"
                           Href="/policies/import">
                    İçe Aktar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="NavigateToCreate">
                    Yeni Poliçe
                </MudButton>
            </MudStack>
        </MudStack>

        <!-- Search and Filters -->
        <MudCard>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="searchTerm"
                                      Label="Ara..."
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnDebounceIntervalElapsed="OnSearch"
                                      DebounceInterval="300"
                                      HelperText="Poliçe no, müşteri adı ile arayın" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect Value="selectedStatus"
                                   ValueChanged="OnStatusChanged"
                                   Label="Durum"
                                   Variant="Variant.Outlined"
                                   T="PolicyStatus?"
                                   ToStringFunc="@(status => GetStatusText(status))"
                                   Clearable="true">
                            <MudSelectItem T="PolicyStatus?" Value="@((PolicyStatus?)PolicyStatus.Active)">Aktif</MudSelectItem>
                            <MudSelectItem T="PolicyStatus?" Value="@((PolicyStatus?)PolicyStatus.Draft)">Taslak</MudSelectItem>
                            <MudSelectItem T="PolicyStatus?" Value="@((PolicyStatus?)PolicyStatus.Expired)">Süresi Dolmuş</MudSelectItem>
                            <MudSelectItem T="PolicyStatus?" Value="@((PolicyStatus?)PolicyStatus.Cancelled)">İptal</MudSelectItem>
                            <MudSelectItem T="PolicyStatus?" Value="@((PolicyStatus?)PolicyStatus.Suspended)">Askıya Alınmış</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect Value="selectedPolicyTypeId"
                                   ValueChanged="OnPolicyTypeChanged"
                                   Label="Poliçe Tipi"
                                   Variant="Variant.Outlined"
                                   T="int?"
                                   Clearable="true">
                            @if (policyTypes != null)
                            {
                                @foreach (var policyType in policyTypes)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)policyType.Id)">@policyType.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudDatePicker Date="startDateFrom"
                                       DateChanged="OnStartDateFromChanged"
                                       Label="Başlangıç (Den)"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudDatePicker Date="startDateTo"
                                       DateChanged="OnStartDateToChanged"
                                       Label="Başlangıç (E)"
                                       Variant="Variant.Outlined"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="1">
                        <MudStack Row Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                           Color="Color.Primary"
                                           OnClick="OnSearch"
                                           Title="Filtrele" />
                            <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                           Color="Color.Secondary"
                                           OnClick="ClearFilters"
                                           Title="Temizle" />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Statistics Cards -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Poliçe</MudText>
                                <MudText Typo="Typo.h4">@totalPolicies</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aktif Poliçe</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Success">@activePolicies</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Süresi Dolacak</MudText>
                                <MudText Typo="Typo.h4" Color="Color.Warning">@expiringCount</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">30 gün içinde</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Color="Color.Warning" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent Class="pb-2">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aylık Gelir</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Info">@monthlyRevenue.ToString("C")</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Info" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Policies Data Grid -->
        <MudCard>
            <MudDataGrid T="PolicyDto"
                         Items="@policies"
                         Loading="@loading"
                         Hover="true"
                         Striped="true"
                         Virtualize="true"
                         FixedHeader="true"
                         Height="600px"
                         RowsPerPage="25">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Poliçe Listesi</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchTerm"
                                  Placeholder="Hızlı arama..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Immediate="true"
                                  OnDebounceIntervalElapsed="OnSearch"
                                  DebounceInterval="300" />
                </ToolBarContent>
                <Columns>
                    <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 60px;">
                        <CellTemplate>
                            @if (HasEndorsements(context.Item.Id))
                            {
                                <MudIconButton Icon="@(IsExpanded(context.Item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleExpand(context.Item.Id))"
                                               Title="@(IsExpanded(context.Item.Id) ? "Zeyilleri Gizle" : "Zeyilleri Göster")" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.PolicyNumber" Title="Poliçe No" />
                    <TemplateColumn Title="Z.No">
                        <CellTemplate>
                            <div style="text-align: center;">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                    <MudText Typo="Typo.body2">@context.Item.InnerCode</MudText>
                                    @if (HasEndorsements(context.Item.Id))
                                    {
                                        <MudChip Size="Size.Small" Color="Color.Info" T="int">@GetEndorsementCount(context.Item.Id) Zeyil</MudChip>
                                    }
                                </MudStack>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="TIP">
                        <CellTemplate>
                            <div style="text-align: center;">
                                <MudText Typo="Typo.caption">@GetStateTypeShortText(context.Item.StateType)</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Müşteri">
                        <CellTemplate>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">
                                    @if (context.Item.Customer != null)
                                    {
                                        @context.Item.Customer.FirstName.FirstOrDefault()
                                        @context.Item.Customer.LastName.FirstOrDefault()
                                    }
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">
                                        @if (context.Item.Customer != null)
                                        {
                                            @($"{context.Item.Customer.FirstName} {context.Item.Customer.LastName}")
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.Item.Customer?.Email
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.InsuranceCompany!.Name" Title="Sigorta Şirketi" />
                    <PropertyColumn Property="x => x.PolicyType!.Name" Title="Poliçe Tipi" />
                    <TemplateColumn Title="Araç">
                        <CellTemplate>
                            @if (context.Item.Vehicle != null)
                            {
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Size="Size.Small" Class="mr-1" />
                                        @context.Item.Vehicle.PlateNumber
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.Item.Vehicle.BrandName @context.Item.Vehicle.ModelName
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Prim Tutarı">
                        <CellTemplate>
                            <div style="text-align: right;">
                                @context.Item.CurrencySymbol@context.Item.PremiumAmount.ToString("N2")
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Başlangıç">
                        <CellTemplate>
                            <div style="text-align: center;">
                                @context.Item.StartDate.ToString("dd.MM.yyyy")
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Bitiş">
                        <CellTemplate>
                            <div style="text-align: center;">
                                <div>@context.Item.EndDate.ToString("dd.MM.yyyy")</div>
                                @if (context.Item.DaysUntilExpiry <= 30 && context.Item.DaysUntilExpiry >= 0)
                                {
                                    <div style="font-size: 0.75rem; color: var(--mud-palette-warning);">
                                        @context.Item.DaysUntilExpiry gün kaldı
                                    </div>
                                }
                                else if (context.Item.IsExpired)
                                {
                                    <div style="font-size: 0.75rem; color: var(--mud-palette-error);">
                                        @Math.Abs(context.Item.DaysUntilExpiry) gün geçti
                                    </div>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Durum">
                        <CellTemplate>
                            <div style="text-align: center;">
                                <MudChip T="string" Color="@GetStatusColor(context.Item.Status)" Size="Size.Small">
                                    @GetStatusText(context.Item.Status)
                                </MudChip>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="İşlemler" Sortable="false">
                        <CellTemplate>
                            <MudStack Row Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               OnClick="@(() => ViewPolicy(context.Item.Id))"
                                               Title="Detayları Görüntüle" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => EditPolicy(context.Item.Id))"
                                               Title="Düzenle" />
                                @if (context.Item.Status == PolicyStatus.Draft)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ActivatePolicy(context.Item))"
                                                   Title="Aktifleştir" />
                                }
                                @if (context.Item.Status == PolicyStatus.Active)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Pause"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   OnClick="@(() => SuspendPolicy(context.Item))"
                                                   Title="Askıya Al" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => CancelPolicy(context.Item))"
                                                   Title="İptal Et" />
                                }
                                @if (context.Item.CanRenew)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RenewPolicy(context.Item))"
                                                   Title="Yenile" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeletePolicy(context.Item))"
                                               Title="Sil" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <ChildRowContent>
                    @if (IsExpanded(context.Item.Id) && HasEndorsements(context.Item.Id))
                    {
                        <td colspan="13">
                            <MudCard Elevation="0" Class="ma-2">
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle2">
                                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                                            Zeyilnameler (@GetEndorsementCount(context.Item.Id))
                                        </MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudTable Items="@GetEndorsements(context.Item.Id)" Hover="true" Dense="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>Z.No</MudTh>
                                            <MudTh>TIP</MudTh>
                                            <MudTh>Başlangıç</MudTh>
                                            <MudTh>Bitiş</MudTh>
                                            <MudTh>Prim Tutarı</MudTh>
                                            <MudTh>Durum</MudTh>
                                            <MudTh>İşlemler</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="endorsement">
                                            <MudTd DataLabel="Z.No">
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2">@endorsement.InnerCode</MudText>
                                                    <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="TIP">
                                                <MudText Typo="Typo.caption">@GetStateTypeShortText(endorsement.StateType)</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="Başlangıç">@endorsement.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                            <MudTd DataLabel="Bitiş">
                                                <div>
                                                    <div>@endorsement.EndDate.ToString("dd.MM.yyyy")</div>
                                                    @if (endorsement.DaysUntilExpiry <= 30 && endorsement.DaysUntilExpiry >= 0)
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--mud-palette-warning);">
                                                            @endorsement.DaysUntilExpiry gün kaldı
                                                        </div>
                                                    }
                                                    else if (endorsement.IsExpired)
                                                    {
                                                        <div style="font-size: 0.75rem; color: var(--mud-palette-error);">
                                                            @Math.Abs(endorsement.DaysUntilExpiry) gün geçti
                                                        </div>
                                                    }
                                                </div>
                                            </MudTd>
                                            <MudTd DataLabel="Prim Tutarı" Style="text-align: right;">@endorsement.CurrencySymbol@endorsement.PremiumAmount.ToString("N2")</MudTd>
                                            <MudTd DataLabel="Durum">
                                                <MudChip T="string" Color="@GetStatusColor(endorsement.Status)" Size="Size.Small">
                                                    @GetStatusText(endorsement.Status)
                                                </MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="İşlemler">
                                                <MudStack Row Spacing="1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => ViewPolicy(endorsement.Id))"
                                                                   Title="Detayları Görüntüle" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Color="Color.Primary"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EditPolicy(endorsement.Id))"
                                                                   Title="Düzenle" />
                                                </MudStack>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudCardContent>
                            </MudCard>
                        </td>
                    }
                </ChildRowContent>
                <LoadingContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText>Poliçeler yükleniyor...</MudText>
                    </MudStack>
                </LoadingContent>
                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate"
                                 Style="font-size: 4rem;"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">
                            Poliçe bulunamadı
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @if (string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <text>Henüz hiç poliçe eklenmemiş. İlk poliçeyi eklemek için "Yeni Poliçe" butonunu kullanın.</text>
                            }
                            else
                            {
                                <text>Arama kriterlerinize uygun poliçe bulunamadı. Farklı arama terimleri deneyin.</text>
                            }
                        </MudText>
                    </MudStack>
                </NoRecordsContent>
            </MudDataGrid>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private List<PolicyDto> policies = new();
    private List<PolicyDto> allPolicies = new(); // Stores all policies including endorsements
    private List<PolicyDto> mainPolicies = new(); // Stores only main policies for display
    private Dictionary<int, List<PolicyDto>> endorsementsByPolicy = new(); // Endorsements grouped by main policy ID
    private HashSet<int> expandedPolicies = new(); // Track which policies are expanded
    private List<IAMS.Shared.DTOs.PolicyType.PolicyTypeDto> policyTypes;
    private bool loading = true;

    // Search and filter parameters
    private string searchTerm = string.Empty;
    private PolicyStatus? selectedStatus;
    private int? selectedPolicyTypeId;
    private DateTime? startDateFrom;
    private DateTime? startDateTo;

    // Statistics
    private int totalPolicies = 0;
    private int activePolicies = 0;
    private int expiringCount = 0;
    private decimal monthlyRevenue = 0;

    protected override async Task OnInitializedAsync()
    {
        // Run sequentially to avoid DbContext concurrency issues
        await LoadPolicies();
        await LoadStatistics();
        await LoadPolicyTypes();
    }

    private async Task LoadPolicies()
    {
        loading = true;
        try
        {
            var queryParams = new PolicyQueryParams
            {
                SearchTerm = searchTerm,
                Status = selectedStatus,
                PolicyTypeId = selectedPolicyTypeId,
                StartDateFrom = startDateFrom,
                StartDateTo = startDateTo,
                PageSize = 1000,
                PageNumber = 1
            };

            var result = await PoliciesApi.GetPoliciesAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                allPolicies = result.Data.Items.ToList();

                // Separate main policies from endorsements
                mainPolicies = allPolicies.Where(p => p.InnerCode == "000").ToList();

                // Group endorsements by their main policy ID
                endorsementsByPolicy.Clear();
                var endorsements = allPolicies.Where(p => p.InnerCode != "000" && p.OriginalPolicyId.HasValue).ToList();
                foreach (var endorsement in endorsements)
                {
                    if (!endorsementsByPolicy.ContainsKey(endorsement.OriginalPolicyId.Value))
                    {
                        endorsementsByPolicy[endorsement.OriginalPolicyId.Value] = new List<PolicyDto>();
                    }
                    endorsementsByPolicy[endorsement.OriginalPolicyId.Value].Add(endorsement);
                }

                // Sort endorsements by InnerCode
                foreach (var key in endorsementsByPolicy.Keys.ToList())
                {
                    endorsementsByPolicy[key] = endorsementsByPolicy[key].OrderBy(e => e.InnerCode).ToList();
                }

                // Set policies to mainPolicies for display
                policies = mainPolicies;
            }
            else
            {
                allPolicies = new List<PolicyDto>();
                mainPolicies = new List<PolicyDto>();
                policies = new List<PolicyDto>();
                endorsementsByPolicy.Clear();
                if (!string.IsNullOrEmpty(result.Message))
                {
                    Snackbar.Add(result.Message, MudBlazor.Severity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Poliçeler yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            allPolicies = new List<PolicyDto>();
            mainPolicies = new List<PolicyDto>();
            policies = new List<PolicyDto>();
            endorsementsByPolicy.Clear();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var statisticsResult = await PoliciesApi.GetStatisticsAsync();
            if (statisticsResult.IsSuccess && statisticsResult.Data != null)
            {
                var stats = statisticsResult.Data;
                totalPolicies = stats.TotalPolicies;
                activePolicies = stats.ActivePolicies;
                expiringCount = stats.ExpiringPolicies;
                monthlyRevenue = stats.MonthlyRevenue;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Statistics loading error: {ex.Message}");
        }
    }

    private async Task LoadPolicyTypes()
    {
        try
        {
            var result = await PolicyTypesApi.GetActiveAsync();
            if (result.IsSuccess && result.Data != null)
            {
                policyTypes = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Policy types loading error: {ex.Message}");
        }
    }

    private async Task OnSearch()
    {
        await LoadPolicies();
    }

    private async Task OnStatusChanged(PolicyStatus? value)
    {
