@page "/policies/{PolicyId:int}"
@layout Layout.MainLayout
@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.DTOs.Payment
@using IAMS.Application.Interfaces
@using IAMS.Web.Services.ApiClient
@using IAMS.Domain.Enums
@using IAMS.Web.Components.Shared
@using IAMS.Web.Components.Shared.Dialogs
@using IAMS.Web.Services.ApiClient
@inject IPoliciesApiClient PoliciesApi
@inject IPaymentsApiClient PaymentsApi
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Poliçe Detayları</PageTitle>

@if (policy == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText>Poliçe bilgileri yükleniyor...</MudText>
        </MudStack>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
        <MudStack Spacing="4">
            <!-- Header with Policy Number and Actions -->
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h4" Color="Color.Primary">@policy.PolicyNumber</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Secondary">
                                @policy.PolicyType?.Name - @policy.InsuranceCompany?.Name
                            </MudText>
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudChip Color="@GetStatusColor(policy.Status)" Size="Size.Medium" T="PolicyStatus">
                                    @GetStatusText(policy.Status)
                                </MudChip>
                                @if (policy.IsExpired)
                                {
                                    <MudChip Color="Color.Error" Size="Size.Medium" T="int">
                                        Süresi Dolmuş (@Math.Abs(policy.DaysUntilExpiry) gün geçti)
                                    </MudChip>
                                }
                                else if (policy.DaysUntilExpiry <= 30)
                                {
                                    <MudChip Color="Color.Warning" Size="Size.Medium" T="int">
                                        @policy.DaysUntilExpiry gün kaldı
                                    </MudChip>
                                }
                            </MudStack>
                        </MudStack>
                        
                        <MudStack Row Spacing="2">
                            <MudButton Variant="Variant.Outlined" 
                                      StartIcon="@Icons.Material.Filled.ArrowBack"
                                      OnClick="GoBack">
                                Geri
                            </MudButton>
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Primary"
                                      StartIcon="@Icons.Material.Filled.Edit"
                                      OnClick="EditPolicy">
                                Düzenle
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- Financial Summary Cards -->
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudCard Class="pa-4">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.h4" Color="Color.Primary">@policy.CurrencySymbol@policy.PremiumAmount.ToString("N2")</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary">Prim Tutarı</MudText>
                        </MudStack>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCard Class="pa-4">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Paid" Size="Size.Large" Color="Color.Success" />
                            <MudText Typo="Typo.h4" Color="Color.Success">@policy.CurrencySymbol@policy.CommissionAmount.ToString("N2")</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary">
                                Komisyon (%@policy.CommissionRate.ToString("F1"))
                            </MudText>
                        </MudStack>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCard Class="pa-4">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Large" Color="Color.Info" />
                            <MudText Typo="Typo.h5" Color="Color.Info">@GetPolicyDuration()</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary">Poliçe Süresi</MudText>
                        </MudStack>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Payment Tracking Section -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-2" />
                            Ödeme Takibi
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddPayment">
                            Ödeme Ekle
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="3">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" Size="Size.Large" Color="Color.Info" />
                                    <MudText Typo="Typo.h5" Color="Color.Info">@policy.CurrencySymbol@policy.PremiumAmount.ToString("N2")</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Tutar</MudText>
                                </MudStack>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                    <MudText Typo="Typo.h5" Color="Color.Success">@policy.CurrencySymbol@totalPaid.ToString("N2")</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ödenen</MudText>
                                </MudStack>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" Color="@(outstandingBalance > 0 ? Color.Warning : Color.Success)" />
                                    <MudText Typo="Typo.h5" Color="@(outstandingBalance > 0 ? Color.Warning : Color.Success)">@policy.CurrencySymbol@outstandingBalance.ToString("N2")</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Kalan Bakiye</MudText>
                                </MudStack>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudCard Outlined="true" Class="pa-4">
                                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Large" Color="Color.Primary" />
                                    <MudText Typo="Typo.h5" Color="Color.Primary">@payments.Count</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Ödeme</MudText>
                                </MudStack>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                    @if (payments.Any())
                    {
                        <MudTable Items="@payments" Hover="true" Dense="true" Elevation="0" Class="mt-4">
                            <HeaderContent>
                                <MudTh>Ödeme Tarihi</MudTh>
                                <MudTh>Vade Tarihi</MudTh>
                                <MudTh Style="text-align: right;">Tutar</MudTh>
                                <MudTh>Ödeme Yöntemi</MudTh>
                                <MudTh>Durum</MudTh>
                                <MudTh>Referans</MudTh>
                                <MudTh>İşlemler</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Ödeme Tarihi">
                                    @context.PaymentDate.ToString("dd.MM.yyyy")
                                </MudTd>
                                <MudTd DataLabel="Vade Tarihi">
                                    @if (context.DueDate.HasValue)
                                    {
                                        <div>
                                            <div>@context.DueDate.Value.ToString("dd.MM.yyyy")</div>
                                            @if (context.Status == PaymentStatus.Pending && context.DueDate.Value < DateTime.Today)
                                            {
                                                <MudChip Size="Size.Small" Color="Color.Error" T="string">Gecikmiş</MudChip>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Tutar" Style="text-align: right;">
                                    <strong>@policy.CurrencySymbol@context.Amount.ToString("N2")</strong>
                                </MudTd>
                                <MudTd DataLabel="Ödeme Yöntemi">
                                    @GetPaymentMethodText(context.PaymentMethod)
                                </MudTd>
                                <MudTd DataLabel="Durum">
                                    <MudChip T="string" Color="@GetPaymentStatusColor(context.Status)" Size="Size.Small">
                                        @GetPaymentStatusText(context.Status)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Referans">
                                    @(string.IsNullOrEmpty(context.Reference) ? "-" : context.Reference)
                                </MudTd>
                                <MudTd DataLabel="İşlemler">
                                    <MudStack Row Spacing="1">
                                        @if (context.Status == PaymentStatus.Pending)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           OnClick="@(() => MarkPaymentCompleted(context.Id))"
                                                           Title="Tamamlandı Olarak İşaretle" />
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditPayment(context.Id))"
                                                       Title="Düzenle" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeletePayment(context.Id))"
                                                       Title="Sil" />
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Class="mt-4">
                            Bu poliçe için henüz ödeme kaydı bulunmamaktadır. Yukarıdaki "Ödeme Ekle" butonuna tıklayarak yeni ödeme ekleyebilirsiniz.
                        </MudAlert>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Main Information Cards -->
            <MudGrid>
                <!-- Policy Information -->
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Poliçe Bilgileri</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="3">
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Poliçe Numarası:</MudText>
                                    <MudText><strong>@policy.PolicyNumber</strong></MudText>
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>İç Kod (Z.No):</MudText>
                                    <MudText>
                                        <strong>@policy.InnerCode</strong>
                                        @if (policy.InnerCode != "000")
                                        {
                                            <MudChip T="String" Size="Size.Small" Color="Color.Info" Class="ml-2">Zeyilname</MudChip>
                                        }
                                    </MudText>
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Durum Tipi (TIP):</MudText>
                                    <MudText><strong>@GetStateTypeText(policy.StateType)</strong></MudText>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(policy.BranchCode))
                                {
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Branş Kodu:</MudText>
                                        <MudText><strong>@policy.BranchCode</strong></MudText>
                                    </MudStack>
                                }
                                <MudDivider />
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Sigorta Şirketi:</MudText>
                                    <MudText><strong>@policy.InsuranceCompany?.Name</strong></MudText>
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Poliçe Tipi:</MudText>
                                    <MudText><strong>@policy.PolicyType?.Name</strong></MudText>
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Para Birimi:</MudText>
                                    <MudText><strong>@GetCurrencyText(policy.Currency)</strong></MudText>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(policy.Marketer))
                                {
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Pazarlamacı:</MudText>
                                        <MudText><strong>@policy.Marketer</strong></MudText>
                                    </MudStack>
                                }
                                <MudDivider />
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Başlangıç Tarihi:</MudText>
                                    <MudText><strong>@policy.StartDate.ToString("dd MMMM yyyy")</strong></MudText>
                                </MudStack>
                                <MudStack Row Justify="Justify.SpaceBetween">
                                    <MudText>Bitiş Tarihi:</MudText>
                                    <MudText><strong>@policy.EndDate.ToString("dd MMMM yyyy")</strong></MudText>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Customer Information -->
                <MudItem xs="12" md="6">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Müşteri Bilgileri</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Color="Color.Primary"
                                               OnClick="ViewCustomer"
                                               Title="Müşteri Detayları" />
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (policy.Customer != null)
                            {
                                <MudStack Spacing="3">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                                        <MudAvatar Color="Color.Primary" Size="Size.Large">
                                            @policy.Customer.FirstName.FirstOrDefault()@policy.Customer.LastName.FirstOrDefault()
                                        </MudAvatar>
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.h6">@policy.Customer.FirstName @policy.Customer.LastName</MudText>
                                            <MudText Color="Color.Secondary">@policy.Customer.Email</MudText>
                                        </MudStack>
                                    </MudStack>
                                    <MudDivider />
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>KKTC Kimlik No:</MudText>
                                        <MudText><strong>@policy.Customer.IdentificationNumber</strong></MudText>
                                    </MudStack>
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Telefon:</MudText>
                                        <MudText><strong>@policy.Customer.MobilePhoneNumber</strong></MudText>
                                    </MudStack>
                                    @if (!string.IsNullOrEmpty(policy.Customer.Address1))
                                    {
                                        <MudStack Spacing="1">
                                            <MudText>Adres:</MudText>
                                            <MudText><strong>@policy.Customer.Address1</strong></MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Vehicle Information (if applicable) -->
            @if (policy.Vehicle != null)
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="mr-2" />
                                Araç Bilgileri
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudStack Spacing="3">
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Plaka:</MudText>
                                        <MudText><strong>@policy.Vehicle.PlateNumber</strong></MudText>
                                    </MudStack>
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Marka/Model:</MudText>
                                        <MudText><strong>@policy.Vehicle.BrandName @policy.Vehicle.ModelName</strong></MudText>
                                    </MudStack>
                                    @if (policy.Vehicle.ModelYear.HasValue)
                                    {
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText>Model Yılı:</MudText>
                                            <MudText><strong>@policy.Vehicle.ModelYear</strong></MudText>
                                        </MudStack>
                                    }
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Araç Yaşı:</MudText>
                                        <MudText><strong>@policy.Vehicle.VehicleAge yıl</strong></MudText>
                                    </MudStack>
                                    @if (!string.IsNullOrEmpty(policy.Vehicle.Color))
                                    {
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText>Renk:</MudText>
                                            <MudText><strong>@policy.Vehicle.Color</strong></MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudStack Spacing="3">
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Şasi Numarası:</MudText>
                                        <MudText><strong>@policy.Vehicle.ChassisNumber</strong></MudText>
                                    </MudStack>
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Araç Tipi:</MudText>
                                        <MudText><strong>@GetVehicleTypeText(policy.Vehicle.VehicleType)</strong></MudText>
                                    </MudStack>
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Yakıt Tipi:</MudText>
                                        <MudText><strong>@GetFuelTypeText(policy.Vehicle.FuelType)</strong></MudText>
                                    </MudStack>
                                    <MudStack Row Justify="Justify.SpaceBetween">
                                        <MudText>Kullanım Tarzı:</MudText>
                                        <MudText><strong>@GetUsageTypeText(policy.Vehicle.UsageType)</strong></MudText>
                                    </MudStack>
                                    @if (policy.Vehicle.CurrentValue.HasValue)
                                    {
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText>Güncel Değer:</MudText>
                                            <MudText><strong>@policy.Vehicle.CurrentValue.Value.ToString("N2") @policy.Vehicle.Currency</strong></MudText>
                                        </MudStack>
                                    }
                                    <MudDivider />
                                    @if (policy.DriverAge.HasValue)
                                    {
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText>Sürücü Yaşı:</MudText>
                                            <MudText><strong>@policy.DriverAge yaş</strong></MudText>
                                        </MudStack>
                                    }
                                    @if (policy.DriverType.HasValue)
                                    {
                                        <MudStack Row Justify="Justify.SpaceBetween">
                                            <MudText>Sürücü Tipi:</MudText>
                                            <MudText><strong>@GetDriverTypeText(policy.DriverType.Value)</strong></MudText>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            }

            <!-- Endorsements Section -->
            @if (policy.InnerCode == "000" && endorsements.Any())
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                                Zeyilnameler (@endorsements.Count)
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="@endorsements" Hover="true" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Z.No</MudTh>
                                <MudTh>TIP</MudTh>
                                <MudTh>Başlangıç</MudTh>
                                <MudTh>Bitiş</MudTh>
                                <MudTh>Prim Tutarı</MudTh>
                                <MudTh>Komisyon</MudTh>
                                <MudTh>Durum</MudTh>
                                <MudTh>İşlemler</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Z.No">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.body2">@context.InnerCode</MudText>
                                        <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                    </MudStack>
                                </MudTd>
                                <MudTd DataLabel="TIP">
                                    <MudText Typo="Typo.caption">@GetStateTypeShortText(context.StateType)</MudText>
                                </MudTd>
                                <MudTd DataLabel="Başlangıç">@context.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                <MudTd DataLabel="Bitiş">
                                    <div>
                                        <div>@context.EndDate.ToString("dd.MM.yyyy")</div>
                                        @if (context.DaysUntilExpiry <= 30 && context.DaysUntilExpiry >= 0)
                                        {
                                            <div style="font-size: 0.75rem; color: var(--mud-palette-warning);">
                                                @context.DaysUntilExpiry gün kaldı
                                            </div>
                                        }
                                        else if (context.IsExpired)
                                        {
                                            <div style="font-size: 0.75rem; color: var(--mud-palette-error);">
                                                @Math.Abs(context.DaysUntilExpiry) gün geçti
                                            </div>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="Prim Tutarı" Style="text-align: right;">@context.CurrencySymbol@context.PremiumAmount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Komisyon" Style="text-align: right;">@context.CurrencySymbol@context.CommissionAmount.ToString("N2")</MudTd>
                                <MudTd DataLabel="Durum">
                                    <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                        @GetStatusText(context.Status)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="İşlemler">
                                    <MudStack Row Spacing="1">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       OnClick="@(() => ViewEndorsement(context.Id))"
                                                       Title="Detayları Görüntüle" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => EditEndorsement(context.Id))"
                                                       Title="Düzenle" />
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            }

            <!-- Notes Section -->
            @if (!string.IsNullOrEmpty(policy.Notes))
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Notlar</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Style="white-space: pre-wrap;">@policy.Notes</MudText>
                    </MudCardContent>
                </MudCard>
            }

            <!-- Action Buttons -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">İşlemler</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Poliçe İşlemleri</MudText>
                                
                                @if (policy.Status == PolicyStatus.Draft)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               FullWidth="true"
                                               OnClick="ActivatePolicy">
                                        Poliçeyi Aktifleştir
                                    </MudButton>
                                }

                                @if (policy.Status == PolicyStatus.Active)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Warning"
                                               StartIcon="@Icons.Material.Filled.Pause"
                                               FullWidth="true"
                                               OnClick="SuspendPolicy">
                                        Askıya Al
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Cancel"
                                               FullWidth="true"
                                               OnClick="CancelPolicy">
                                        İptal Et
                                    </MudButton>
                                }

                                @if (policy.CanRenew)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Refresh"
                                               FullWidth="true"
                                               OnClick="RenewPolicy">
                                        Poliçeyi Yenile
                                    </MudButton>
                                }

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           FullWidth="true"
                                           OnClick="DeletePolicy">
                                    Sil
                                </MudButton>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Belgeler ve Raporlar</MudText>
                                
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Print"
                                           FullWidth="true"
                                           OnClick="PrintPolicy">
                                    Poliçeyi Yazdır
                                </MudButton>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           FullWidth="true"
                                           OnClick="ExportToPdf">
                                    PDF İndir
                                </MudButton>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.Email"
                                           FullWidth="true"
                                           OnClick="SendByEmail">
                                    E-posta Gönder
                                </MudButton>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- Policy History -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Poliçe Geçmişi</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        <MudTimelineItem Color="Color.Success" Icon="@Icons.Material.Filled.Create">
                            <ItemContent>
                                <MudStack Spacing="1">
                                    <MudText><strong>Poliçe Oluşturuldu</strong></MudText>
                                    <MudText Color="Color.Secondary">
                                        @policy.CreatedOn.ToString("dd MMMM yyyy HH:mm")
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(policy.CreatedBy))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @policy.CreatedBy tarafından
                                        </MudText>
                                    }
                                </MudStack>
                            </ItemContent>
                        </MudTimelineItem>

                        @if (policy.ModifiedOn.HasValue)
                        {
                            <MudTimelineItem Color="Color.Info" Icon="@Icons.Material.Filled.Edit">
                                <ItemContent>
                                    <MudStack Spacing="1">
                                        <MudText><strong>Son Güncelleme</strong></MudText>
                                        <MudText Color="Color.Secondary">
                                            @policy.ModifiedOn.Value.ToString("dd MMMM yyyy HH:mm")
                                        </MudText>
                                        @if (!string.IsNullOrEmpty(policy.ModifiedBy))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @policy.ModifiedBy tarafından
                                            </MudText>
                                        }
                                    </MudStack>
                                </ItemContent>
                            </MudTimelineItem>
                        }

                        <MudTimelineItem Color="@GetStatusColor(policy.Status)" Icon="@GetStatusIcon(policy.Status)">
                            <ItemContent>
                                <MudStack Spacing="1">
                                    <MudText><strong>Mevcut Durum: @GetStatusText(policy.Status)</strong></MudText>
                                    <MudText Color="Color.Secondary">
                                        @DateTime.Now.ToString("dd MMMM yyyy HH:mm")
                                    </MudText>
                                </MudStack>
                            </ItemContent>
                        </MudTimelineItem>
                    </MudTimeline>
                </MudCardContent>
            </MudCard>
        </MudStack>
    </MudContainer>
}

@code {
    [Parameter] public int PolicyId { get; set; }

    private PolicyDto? policy;
    private List<PolicyDto> endorsements = new();
    private List<PolicyPaymentDto> payments = new();
    private decimal totalPaid = 0;
    private decimal outstandingBalance = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadPolicy();
        await LoadEndorsements();
        await LoadPayments();
    }

    private async Task LoadPolicy()
    {
        try
        {
            var result = await PoliciesApi.GetPolicyByIdAsync(PolicyId);
            if (result.IsSuccess && result.Data != null)
            {
                policy = result.Data;
            }
            else
            {
                Snackbar.Add("Poliçe bulunamadı", MudBlazor.Severity.Error);
                Navigation.NavigateTo("/policies");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Poliçe yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            Navigation.NavigateTo("/policies");
        }
    }

    private async Task LoadEndorsements()
    {
        try
        {
            // Only load endorsements if this is a main policy (InnerCode == "000")
            if (policy?.InnerCode == "000")
            {
                var result = await PoliciesApi.GetEndorsementsByPolicyIdAsync(PolicyId);
                if (result.IsSuccess && result.Data != null)
                {
                    endorsements = result.Data;
                }
                else
                {
                    endorsements = new List<PolicyDto>();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Zeyilnameler yüklenirken hata: {ex.Message}");
            endorsements = new List<PolicyDto>();
        }
    }

    private async Task LoadPayments()
    {
        try
        {
            payments = await PaymentsApi.GetPaymentsByPolicyIdAsync(PolicyId);
            totalPaid = await PaymentsApi.GetTotalPaymentsByPolicyIdAsync(PolicyId);
            outstandingBalance = (policy?.PremiumAmount ?? 0) - totalPaid;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ödemeler yüklenirken hata: {ex.Message}");
            payments = new List<PolicyPaymentDto>();
            totalPaid = 0;
            outstandingBalance = policy?.PremiumAmount ?? 0;
        }
    }

    private async Task AddPayment()
    {
        var parameters = new DialogParameters
        {
            ["PolicyId"] = PolicyId,
            ["PolicyNumber"] = policy?.PolicyNumber,
            ["CurrencyId"] = policy?.CurrencyId,
            ["CurrencySymbol"] = policy?.CurrencySymbol
        };

        var dialog = await DialogService.ShowAsync<AddPaymentDialog>("Yeni Ödeme Ekle", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadPayments();
        }
    }

    private async Task EditPayment(int paymentId)
    {
        try
        {
            var payment = payments.FirstOrDefault(p => p.Id == paymentId);
            if (payment == null)
            {
                Snackbar.Add("Ödeme bulunamadı", MudBlazor.Severity.Error);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Payment"] = payment,
                ["PolicyId"] = PolicyId,
                ["PolicyNumber"] = policy?.PolicyNumber,
                ["CurrencyId"] = policy?.CurrencyId,
                ["CurrencySymbol"] = policy?.CurrencySymbol
            };

            var dialog = await DialogService.ShowAsync<AddPaymentDialog>("Ödeme Düzenle", parameters);
            var result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                await LoadPayments();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task MarkPaymentCompleted(int paymentId)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Bu ödemeyi tamamlandı olarak işaretlemek istediğinizden emin misiniz?",
            ["ButtonText"] = "Tamamlandı İşaretle",
            ["Color"] = Color.Success
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Ödeme Onayı", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                await PaymentsApi.UpdatePaymentStatusAsync(paymentId, PaymentStatus.Completed);
                Snackbar.Add("Ödeme başarıyla tamamlandı olarak işaretlendi", MudBlazor.Severity.Success);
                await LoadPayments();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ödeme durumu güncellenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task DeletePayment(int paymentId)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = "Bu ödeme kaydını silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            ["ButtonText"] = "Sil",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Ödeme Sil", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                await PaymentsApi.DeleteAsync(paymentId);
                Snackbar.Add("Ödeme kaydı başarıyla silindi", MudBlazor.Severity.Success);
                await LoadPayments();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ödeme silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private Color GetPaymentStatusColor(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Completed => Color.Success,
            PaymentStatus.Pending => Color.Warning,
            PaymentStatus.Failed => Color.Error,
            PaymentStatus.Refunded => Color.Info,
            PaymentStatus.PartiallyPaid => Color.Warning,
            PaymentStatus.Overdue => Color.Error,
            _ => Color.Default
        };
    }

    private string GetPaymentStatusText(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Completed => "Tamamlandı",
            PaymentStatus.Pending => "Bekliyor",
            PaymentStatus.Failed => "Başarısız",
            PaymentStatus.Refunded => "İade Edildi",
            PaymentStatus.PartiallyPaid => "Kısmi Ödendi",
            PaymentStatus.Overdue => "Gecikmiş",
            _ => status.ToString()
        };
    }

    private string GetPaymentMethodText(PaymentMethod method)
    {
        return method switch
        {
            PaymentMethod.Cash => "Nakit",
            PaymentMethod.CreditCard => "Kredi Kartı",
            PaymentMethod.BankTransfer => "Banka Havalesi",
            PaymentMethod.Cheque => "Çek",
            PaymentMethod.DebitCard => "Banka Kartı",
            PaymentMethod.OnlinePayment => "Online Ödeme",
            _ => method.ToString()
        };
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/policies");
    }

    private void EditPolicy()
    {
        Navigation.NavigateTo($"/policies/{PolicyId}/edit");
    }

    private void ViewCustomer()
    {
        if (policy?.Customer != null)
        {
            Navigation.NavigateTo($"/customers/{policy.Customer.Id}");
        }
    }

    private void RenewPolicy()
    {
        Navigation.NavigateTo($"/policies/renew/{PolicyId}");
    }

    private async Task ActivatePolicy()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"{policy!.PolicyNumber} numaralı poliçeyi aktifleştirmek istediğinizden emin misiniz?",
            ["ButtonText"] = "Aktifleştir",
            ["Color"] = Color.Success
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Poliçe Aktifleştir", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var activateResult = await PoliciesApi.ActivatePolicyAsync(PolicyId);
                if (activateResult.IsSuccess)
                {
                    Snackbar.Add("Poliçe başarıyla aktifleştirildi", MudBlazor.Severity.Success);
                    await LoadPolicy();
                }
                else
                {
                    Snackbar.Add(activateResult.Message ?? "Poliçe aktifleştirilirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Poliçe aktifleştirilirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task SuspendPolicy()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"{policy!.PolicyNumber} numaralı poliçeyi askıya almak istediğinizden emin misiniz?",
            ["ButtonText"] = "Askıya Al",
            ["Color"] = Color.Warning
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Poliçeyi Askıya Al", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var suspendResult = await PoliciesApi.SuspendPolicyAsync(PolicyId, "Kullanıcı tarafından askıya alındı");
                if (suspendResult.IsSuccess)
                {
                    Snackbar.Add("Poliçe başarıyla askıya alındı", MudBlazor.Severity.Success);
                    await LoadPolicy();
                }
                else
                {
                    Snackbar.Add(suspendResult.Message ?? "Poliçe askıya alınırken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Poliçe askıya alınırken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task CancelPolicy()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"{policy!.PolicyNumber} numaralı poliçeyi iptal etmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            ["ButtonText"] = "İptal Et",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Poliçeyi İptal Et", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var cancelResult = await PoliciesApi.CancelPolicyAsync(PolicyId, "Kullanıcı tarafından iptal edildi");
                if (cancelResult.IsSuccess)
                {
                    Snackbar.Add("Poliçe başarıyla iptal edildi", MudBlazor.Severity.Success);
                    await LoadPolicy();
                }
                else
                {
                    Snackbar.Add(cancelResult.Message ?? "Poliçe iptal edilirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Poliçe iptal edilirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task DeletePolicy()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"{policy!.PolicyNumber} numaralı poliçeyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.",
            ["ButtonText"] = "Sil",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmationDialog>("Poliçeyi Sil", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var deleteResult = await PoliciesApi.DeletePolicyAsync(PolicyId);
                if (deleteResult.IsSuccess)
                {
                    Snackbar.Add("Poliçe başarıyla silindi", MudBlazor.Severity.Success);
                    Navigation.NavigateTo("/policies");
                }
                else
                {
                    Snackbar.Add(deleteResult.Message ?? "Poliçe silinirken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Poliçe silinirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
            }
        }
    }

    private void PrintPolicy()
    {
        Snackbar.Add("Yazdırma özelliği yakında eklenecek", MudBlazor.Severity.Info);
