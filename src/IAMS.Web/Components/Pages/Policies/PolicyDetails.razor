    private string GetPolicyDuration()
    {
        if (policy == null) return "0 gün";

        var duration = policy.EndDate - policy.StartDate;
        var totalDays = duration.TotalDays;

        if (totalDays < 365)
        {
            return $"{Math.Round(totalDays / 30, 1)} ay";
        }
        else
        {
            var years = Math.Round(totalDays / 365.25, 1);
            return $"{years} yıl";
        }
    }

