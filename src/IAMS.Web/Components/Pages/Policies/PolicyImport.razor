@page "/policies/import"
@layout Layout.MainLayout

@using IAMS.Application.DTOs.Policy
@using IAMS.Application.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Text.Json
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Poliçe İçe Aktar</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" />
                Poliçe İçe Aktar
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Geri Dön
            </MudButton>
        </MudStack>

        <!-- Instructions Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Kullanım Talimatları
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Excel dosyanızdan poliçeleri toplu olarak içe aktarabilirsiniz. Lütfen aşağıdaki adımları takip edin:
                </MudText>
                <MudList Dense="true" T="String">
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Excel dosyanızın (.xlsx veya .xls) formatında olduğundan emin olun
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Dosya boyutu 10 MB'dan küçük olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        İlk satır başlık satırı olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Müşteriler sisteme önceden eklenmiş olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Sigorta şirketleri ve poliçe tipleri tanımlı olmalıdır
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>

        <!-- File Upload Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Excel Dosyası Seçin</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <input type="file" id="policyFileInput" accept=".xlsx,.xls" style="display: none;" />
                <button type="button"
                        class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-ripple"
                        onclick="selectFile()">
                    <span class="mud-button-label">
                        <span class="mud-button-icon-start">
                            <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"></path>
                            </svg>
                        </span>
                        Dosya Seç
                    </span>
                </button>

                @if (!string.IsNullOrEmpty(selectedFileName))
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Icon="@Icons.Material.Filled.InsertDriveFile"
                             OnClose="ClearFile"
                             Class="mt-3">
                        @selectedFileName
                    </MudChip>

                    <MudStack Row Spacing="2" Class="mt-4">
                        <button type="button"
                                class="mud-button-root mud-button mud-button-filled mud-button-filled-success mud-ripple"
                                onclick="uploadFile()"
                                disabled="@isUploading">
                            @if (isUploading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <span>İçe Aktarılıyor...</span>
                            }
                            else
                            {
                                <span class="mud-button-label">
                                    <span class="mud-button-icon-start">
                                        <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"></path>
                                        </svg>
                                    </span>
                                    İçe Aktar
                                </span>
                            }
                        </button>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="ClearFile"
                                   Disabled="@isUploading">
                            İptal
                        </MudButton>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>

        <!-- Upload Progress -->
        @if (isUploading)
        {
            <MudCard>
                <MudCardContent>
                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        <MudText Typo="Typo.body1">Dosya yükleniyor ve poliçeler işleniyor...</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Bu işlem biraz zaman alabilir.</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        <!-- Import Results -->
        @if (importResult != null)
        {
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
                            İçe Aktarma Sonuçları
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Info" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Satır</MudText>
                                        <MudText Typo="Typo.h4">@importResult.TotalRows</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Başarılı</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Success">@importResult.SuccessCount</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Hatalı</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Error">@importResult.FailureCount</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                    @if (importResult.Errors != null && importResult.Errors.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mt-6 mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="mr-2" />
                            Hatalar
                        </MudText>
                        <MudTable Items="@importResult.Errors" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Satır No</MudTh>
                                <MudTh>Poliçe No</MudTh>
                                <MudTh>Alan</MudTh>
                                <MudTh>Hata Mesajı</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Satır No">@context.RowNumber</MudTd>
                                <MudTd DataLabel="Poliçe No">@context.PolicyNumber</MudTd>
                                <MudTd DataLabel="Alan">@context.FieldName</MudTd>
                                <MudTd DataLabel="Hata Mesajı">
                                    <MudText Typo="Typo.body2" Color="Color.Error">@context.ErrorMessage</MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }

                    @if (importResult.SuccessCount > 0)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Success" Class="mt-4">
                            @importResult.SuccessCount poliçe başarıyla içe aktarıldı!
                        </MudAlert>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.List"
                               Href="/policies">
                        Poliçeleri Görüntüle
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="ResetImport">
                        Yeni İçe Aktarım
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }
    </MudStack>
</MudContainer>

<script>
    let dotNetHelper;

    window.selectFile = () => {
        document.getElementById('policyFileInput').click();
    };

    window.initFileUpload = (helper) => {
        dotNetHelper = helper;

        const fileInput = document.getElementById('policyFileInput');
        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;

                // Validate file
                const maxSize = 10 * 1024 * 1024; // 10MB
                const validExtensions = ['.xlsx', '.xls'];
                const extension = '.' + file.name.split('.').pop().toLowerCase();

                if (file.size > maxSize) {
                    dotNetHelper.invokeMethodAsync('ShowError', `Dosya boyutu çok büyük. Maksimum 10 MB olmalıdır.`);
                    return;
                }

                if (!validExtensions.includes(extension)) {
                    dotNetHelper.invokeMethodAsync('ShowError', 'Sadece Excel dosyaları (.xlsx, .xls) yüklenebilir');
                    return;
                }

                dotNetHelper.invokeMethodAsync('FileSelected', file.name);
            });
        }
    };

    window.uploadFile = async () => {
        const fileInput = document.getElementById('policyFileInput');
        const file = fileInput.files[0];
        if (!file) return;

        await dotNetHelper.invokeMethodAsync('SetUploading', true);

        const formData = new FormData();
        formData.append('file', file);

        try {
            const response = await fetch('/api/policies/import', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await response.json();
                await dotNetHelper.invokeMethodAsync('UploadComplete', JSON.stringify(result));
            } else {
                const error = await response.text();
                await dotNetHelper.invokeMethodAsync('ShowError', `Sunucu hatası: ${error}`);
            }
        } catch (error) {
            await dotNetHelper.invokeMethodAsync('ShowError', `Hata: ${error.message}`);
        } finally {
            await dotNetHelper.invokeMethodAsync('SetUploading', false);
        }
    };

    window.clearFileInput = () => {
        const fileInput = document.getElementById('policyFileInput');
        if (fileInput) {
            fileInput.value = '';
        }
    };
</script>

@code {
    private string? selectedFileName;
    private bool isUploading = false;
    private PolicyImportResultDto? importResult;
    private DotNetObjectReference<PolicyImport>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initFileUpload", dotNetRef);
        }
    }

    [JSInvokable]
    public void FileSelected(string fileName)
    {
        selectedFileName = fileName;
        importResult = null;
        Snackbar.Add($"Dosya seçildi: {fileName}", MudBlazor.Severity.Success);
        StateHasChanged();
    }

    [JSInvokable]
    public void ShowError(string message)
    {
        Snackbar.Add(message, MudBlazor.Severity.Error);
        StateHasChanged();
    }

    [JSInvokable]
    public void SetUploading(bool uploading)
    {
        isUploading = uploading;
        StateHasChanged();
    }

    [JSInvokable]
    public void UploadComplete(string resultJson)
    {
        try
        {
            var result = JsonSerializer.Deserialize<Result<PolicyImportResultDto>>(resultJson, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (result != null && result.IsSuccess)
            {
                importResult = result.Data;

                if (importResult.SuccessCount > 0)
                {
                    Snackbar.Add($"{importResult.SuccessCount} poliçe başarıyla içe aktarıldı!", MudBlazor.Severity.Success);
                }

                if (importResult.FailureCount > 0)
                {
                    Snackbar.Add($"{importResult.FailureCount} poliçe içe aktarılamadı. Detaylar için aşağıya bakın.", MudBlazor.Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add(result?.Message ?? "Poliçeler içe aktarılırken hata oluştu", MudBlazor.Severity.Error);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sonuç işlenirken hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private void ClearFile()
    {
        selectedFileName = null;
        importResult = null;
        JSRuntime.InvokeVoidAsync("clearFileInput");
    }

    private void ResetImport()
    {
        selectedFileName = null;
        importResult = null;
        JSRuntime.InvokeVoidAsync("clearFileInput");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/policies");
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
