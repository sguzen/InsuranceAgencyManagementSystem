@page "/policies/import"
@layout Layout.MainLayout

@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.DTOs.Customer
@using IAMS.Shared.DTOs.InsuranceCompany
@using IAMS.Shared.DTOs.Parametric
@using IAMS.Application.Models
@using IAMS.Domain.Enums
@using Microsoft.AspNetCore.WebUtilities
@using IAMS.Web.Services.ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IInsuranceCompaniesApiClient InsuranceCompaniesApi
@inject IPoliciesApiClient PoliciesApi
@inject ICustomersApiClient CustomersApi
@inject IParametricApiClient ParametricApi

<PageTitle>Poliçe İçe Aktar</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    @if (currentStep == ImportStep.FileSelection)
    {
        <!-- Step 1: File Selection -->
        <MudStack Spacing="4">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">
                    <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" />
                    Poliçe İçe Aktar
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack" Href="/policies">
                    Geri Dön
                </MudButton>
            </MudStack>

            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Adım 1: Excel Dosyası Seçin</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudSelect T="int" Label="Sigorta Şirketi" @bind-Value="selectedInsuranceCompanyId"
                                   Required="true" Variant="Variant.Outlined">
                            @foreach (var company in insuranceCompanies)
                            {
                                <MudSelectItem Value="@company.Id">@company.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudFileUpload T="IBrowserFile" OnFilesChanged="OnFileSelected" Accept=".xlsx,.xls">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Dosya Seç
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>

                        @if (selectedFile != null)
                        {
                            <MudChip T="String" Icon="@Icons.Material.Filled.AttachFile" Color="Color.Info">
                                @selectedFile.Name (@FormatBytes(selectedFile.Size))
                            </MudChip>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Preview"
                                   Disabled="@(selectedFile == null || isProcessing)"
                                   OnClick="ParseFile">
                            @if (isProcessing)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <span>Dosya işleniyor...</span>
                            }
                            else
                            {
                                <span>Önizleme</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudStack>
    }
    else if (currentStep == ImportStep.ReviewAndMap)
    {
        <!-- Step 2: Review and Map Customers -->
        <MudStack Spacing="4">
            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">
                    <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-3" />
                    Adım 2: Müşteri Eşleştirme (@previewPolicies.Count Poliçe)
                </MudText>
                <MudStack Row Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="BackToFileSelection">
                        Geri Dön
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(!AllPoliciesMapped() || isSaving)"
                               OnClick="SaveImport">
                        @if (isSaving)
                        {
                            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                            <span>Kaydediliyor...</span>
                        }
                        else
                        {
                            <span>Kaydet (@GetMappedCount() / @previewPolicies.Count)</span>
                        }
                    </MudButton>
                </MudStack>
            </MudStack>

            @if (!AllPoliciesMapped())
            {
                <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">
                    Lütfen tüm poliçeler için müşteri eşleştirmesi yapın (@GetUnmappedCount() poliçe kaldı)
                </MudAlert>
            }

            <!-- Policy List with Mapping -->
            <MudPaper Elevation="0" Class="pa-4">
                @foreach (var policy in previewPolicies)
                {
                    <MudCard Class="@(policy.IsValid ? "mb-3" : "mb-3 border-l-4 border-warning")">
                        <MudCardContent>
                            <MudGrid>
                                <!-- Policy Info Column -->
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Poliçe Bilgileri</MudText>
                                    <MudText Typo="Typo.body2"><b>Poliçe No:</b> @policy.PolicyNumber</MudText>
                                    <MudText Typo="Typo.body2"><b>Tarih:</b> @policy.StartDate?.ToString("dd.MM.yyyy") - @policy.EndDate?.ToString("dd.MM.yyyy")</MudText>
                                    <MudText Typo="Typo.body2"><b>Tip:</b> @policy.PolicyTypeName</MudText>
                                    @if (!string.IsNullOrEmpty(policy.PlateNumber))
                                    {
                                        <MudText Typo="Typo.body2"><b>Plaka:</b> @policy.PlateNumber</MudText>
                                    }
                                    <MudText Typo="Typo.body2"><b>Prim:</b> @policy.PremiumAmount.ToString("N2") @policy.CurrencyCode</MudText>
                                </MudItem>

                                <!-- Sigortalı (Insured Person) - Stored as string -->
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Sigortalı</MudText>
                                    <MudText Typo="Typo.body2"><b>İsim:</b> @policy.InsuredCustomerName</MudText>
                                    <MudText Typo="Typo.body2" Class="text-xs text-gray-500">
                                        Kimlik/Pasaport: @policy.InsuredCustomerIdentifier
                                    </MudText>
                                    <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mt-2">
                                        Bu bilgi poliçede metin olarak saklanacak
                                    </MudAlert>
                                </MudItem>

                                <!-- Policy Owner Mapping Column -->
                                <MudItem xs="12" md="4">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Tertiary">Cari Kart</MudText>

                                    <MudStack Row Class="mb-2">
                                        <MudCheckBox T="bool"
                                                     Value="@policy.PolicyOwnerSameAsInsured"
                                                     ValueChanged="@((bool value) => OnPolicyOwnerSameAsInsuredChanged(policy, value))"
                                                     Label="Sigortalı ile aynı"
                                                     Dense="true"
                                                     Color="Color.Success" />
                                        <MudChip T="String" Size="Size.Small" Color="@(policy.PolicyOwnerSameAsInsured ? Color.Success : Color.Default)">
                                            @(policy.PolicyOwnerSameAsInsured ? "✓ Aynı" : "✗ Farklı")
                                        </MudChip>
                                    </MudStack>

                                    @if (!policy.PolicyOwnerSameAsInsured)
                                    {
                                        <MudAutocomplete T="CustomerDto"
                                                         Label="Mevcut Müşteri Ara"
                                                         SearchFunc="@SearchCustomersAsync"
                                                         ToStringFunc="@(c => c == null ? "" : $"{c.FullName} ({c.CustomerCode})")"
                                                         Dense="true"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         ResetValueOnEmptyText="true"
                                                         CoerceText="true"
                                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                                         AdornmentColor="Color.Primary"
                                                         ValueChanged="@((CustomerDto c) => OnOwnerCustomerSelected(policy, c))" />

                                        <MudText Typo="Typo.body2" Class="my-2 text-center">veya</MudText>

                                        <MudCheckBox T="bool"
                                                     Value="@policy.CreateNewPolicyOwner"
                                                     ValueChanged="@((bool value) => OnCreateNewPolicyOwnerChanged(policy, value))"
                                                     Label="Yeni poliçe sahibi müşteri oluştur"
                                                     Dense="true"
                                                     Color="Color.Warning" />

                                        @if (policy.CreateNewPolicyOwner)
                                        {
                                            <MudTextField @bind-Value="policy.PolicyOwnerName"
                                                          Label="Müşteri Adı" Variant="Variant.Outlined"
                                                          Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                          Required="true" />
                                            <MudTextField @bind-Value="policy.PolicyOwnerPhone"
                                                          Label="Telefon" Variant="Variant.Outlined"
                                                          Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                          Placeholder="0542XXXXXXX" />

                                            <MudSelect T="CustomerType"
                                                       Value="@policy.PolicyOwnerCustomerType"
                                                       ValueChanged="@((CustomerType type) => OnCustomerTypeChanged(policy, type))"
                                                       Label="Müşteri Tipi" Variant="Variant.Outlined"
                                                       Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                       Required="true">
                                                <MudSelectItem Value="@CustomerType.Individual">Bireysel</MudSelectItem>
                                                <MudSelectItem Value="@CustomerType.Corporate">Kurumsal</MudSelectItem>
                                            </MudSelect>

                                            @if (policy.PolicyOwnerCustomerType == CustomerType.Individual)
                                            {
                                                
                                                    var selectedCountry = countries.FirstOrDefault(c => c.Id == policy.PolicyOwnerNationalityCountryId);
                                                
                                                <MudAutocomplete T="CountryDto"
                                                                 SearchFunc="@SearchCountriesAsync"
                                                                 ToStringFunc="@(c => c == null ? "" : c.NameTr)"
                                                                 Value="@selectedCountry"
                                                                 Label="Uyruk (Nationality)" Variant="Variant.Outlined"
                                                                 Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                                 Required="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 CoerceText="true"
                                                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                                                 AdornmentColor="Color.Primary"
                                                                 ValueChanged="@((CountryDto c) => OnNationalityCountrySelected(policy, c))" />

                                                
                                                    var identifierLabel = GetIdentifierLabel(policy.PolicyOwnerNationalityCountryId);
                                                
                                                <MudTextField @bind-Value="policy.PolicyOwnerIdentifier"
                                                              Label="@identifierLabel" Variant="Variant.Outlined"
                                                              Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                              Required="true" />
                                            }
                                            else
                                            {
                                                <MudTextField @bind-Value="policy.PolicyOwnerIdentifier"
                                                              Label="Ticaret Sicil No (Trade License)" Variant="Variant.Outlined"
                                                              Dense="true" Margin="Margin.Dense" Class="mt-2"
                                                              Required="true" />
                                            }
                                        }
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                }
            </MudPaper>
        </MudStack>
    }
</MudContainer>

@code {
    private enum ImportStep
    {
        FileSelection,
        ReviewAndMap
    }

    private ImportStep currentStep = ImportStep.FileSelection;
    private List<InsuranceCompanyDto> insuranceCompanies = new();
    private List<CountryDto> countries = new();
    private int selectedInsuranceCompanyId;
    private IBrowserFile? selectedFile;
    private List<PolicyImportPreviewDto> previewPolicies = new();
    private bool isProcessing = false;
    private bool isSaving = false;

    // KKTC country ID constant
    private const int KKTC_COUNTRY_ID = 601;

    protected override async Task OnInitializedAsync()
    {
        await LoadInsuranceCompaniesAsync();
        await LoadCountriesAsync();
    }

    private async Task LoadInsuranceCompaniesAsync()
    {
        try
        {
            var result = await InsuranceCompaniesApi.GetActiveInsuranceCompaniesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                insuranceCompanies = result.Data;
                if (insuranceCompanies.Any())
                {
                    selectedInsuranceCompanyId = insuranceCompanies.First().Id;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sigorta şirketleri yüklenirken hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadCountriesAsync()
    {
        try
        {
            var result = await ParametricApi.GetCountriesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                countries = result.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ülkeler yüklenirken hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private string GetIdentifierLabel(int? nationalityCountryId)
    {
        if (!nationalityCountryId.HasValue)
            return "Kimlik/Pasaport";

        return nationalityCountryId.Value == KKTC_COUNTRY_ID
            ? "Kimlik No (ID Card)"
            : "Pasaport No (Passport)";
    }

    private async Task<IEnumerable<CountryDto>> SearchCountriesAsync(string searchTerm, CancellationToken cancellationToken)
    {
        // Return all countries if no search term or too short
        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < 1)
            return countries;

        var searchLower = searchTerm.ToLowerInvariant();

        // Search by Turkish name, English name, code, or special handling for KKTC
        return countries.Where(c =>
        {
            // Special handling for KKTC - match if search contains "kktc" or any part of the name
            if (c.Id == KKTC_COUNTRY_ID)
            {
                // If typing "kktc", match KKTC
                if (searchLower.Contains("kktc")) return true;

                // If typing any part of "KUZEY KIBRIS TÜRK CUMHURİYET", match KKTC
                var nameLower = c.NameTr.ToLowerInvariant();
                if (nameLower.Contains(searchLower)) return true;
            }

            // For all countries: search in Turkish name, English name, or code
            return c.NameTr.ToLowerInvariant().Contains(searchLower) ||
                   c.NameEn.ToLowerInvariant().Contains(searchLower) ||
                   (!string.IsNullOrEmpty(c.Code) && c.Code.ToLowerInvariant().Contains(searchLower));
        }).ToList();
    }

    private void OnNationalityCountrySelected(PolicyImportPreviewDto policy, CountryDto? country)
    {
        if (country != null)
        {
            policy.PolicyOwnerNationalityCountryId = country.Id;
        }
        else
        {
            policy.PolicyOwnerNationalityCountryId = null;
        }
        StateHasChanged();
    }

    private void OnCustomerTypeChanged(PolicyImportPreviewDto policy, CustomerType type)
    {
        policy.PolicyOwnerCustomerType = type;

        // When changing to Individual, set KKTC as default nationality
        if (type == CustomerType.Individual && !policy.PolicyOwnerNationalityCountryId.HasValue)
        {
            policy.PolicyOwnerNationalityCountryId = KKTC_COUNTRY_ID;
        }
        // When changing to Corporate, clear nationality (not applicable for corporate)
        else if (type == CustomerType.Corporate)
        {
            policy.PolicyOwnerNationalityCountryId = null;
        }

        StateHasChanged();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task ParseFile()
    {
        if (selectedFile == null || selectedInsuranceCompanyId <= 0)
        {
            Snackbar.Add("Lütfen dosya ve sigorta şirketi seçin", MudBlazor.Severity.Warning);
            return;
        }

        isProcessing = true;
        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
            var result = await PoliciesApi.ParsePolicyImportAsync(stream, selectedFile.Name, selectedInsuranceCompanyId);

            if (result.IsSuccess && result.Data != null)
            {
                previewPolicies = result.Data;

                // Ensure all policies have default values set
                foreach (var policy in previewPolicies)
                {
                    if (!policy.PolicyOwnerSameAsInsured &&
                        !policy.PolicyOwnerCustomerId.HasValue &&
                        !policy.CreateNewPolicyOwner)
                    {
                        policy.PolicyOwnerSameAsInsured = true; // Force default
                    }
                }

                currentStep = ImportStep.ReviewAndMap;
                await InvokeAsync(StateHasChanged); // Force UI update
                Snackbar.Add($"{previewPolicies.Count} poliçe başarıyla okundu. Lütfen müşteri eşleştirmesi yapın.", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add($"Dosya okunamadı: {result.Message}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Dosya işlenirken hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void BackToFileSelection()
    {
        currentStep = ImportStep.FileSelection;
        previewPolicies.Clear();
        selectedFile = null;
    }

    private async Task SaveImport()
    {
        if (!AllPoliciesMapped())
        {
            Snackbar.Add("Lütfen tüm poliçeler için müşteri eşleştirmesi yapın", MudBlazor.Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            var result = await PoliciesApi.ImportPoliciesWithMappingAsync(previewPolicies, selectedInsuranceCompanyId);

            if (result.IsSuccess && result.Data != null)
            {
                var importResult = result.Data;
                if (importResult.SuccessCount > 0)
                {
                    Snackbar.Add(
                        $"{importResult.SuccessCount} poliçe başarıyla içe aktarıldı! " +
                        (importResult.FailureCount > 0 ? $"{importResult.FailureCount} poliçe başarısız oldu." : ""),
                        importResult.FailureCount > 0 ? MudBlazor.Severity.Warning : MudBlazor.Severity.Success);

                    // Show errors if any
                    if (importResult.Errors.Any())
                    {
                        foreach (var error in importResult.Errors.Take(5))
                        {
                            Snackbar.Add($"Satır {error.RowNumber}: {error.ErrorMessage}", MudBlazor.Severity.Error);
                        }
                    }

                    // Navigate to policies list after successful import
                    if (importResult.FailureCount == 0)
                    {
                        await Task.Delay(1500); // Give user time to see the message
                        Navigation.NavigateTo("/policies");
                    }
                }
                else
                {
                    Snackbar.Add("Hiçbir poliçe içe aktarılamadı", MudBlazor.Severity.Error);
                }
            }
            else
            {
                Snackbar.Add($"İçe aktarma başarısız: {result.Message}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Kayıt sırasında hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool AllPoliciesMapped()
    {
        return previewPolicies.All(p => p.IsValid);
    }

    private int GetMappedCount()
    {
        return previewPolicies.Count(p => p.IsValid);
    }

    private int GetUnmappedCount()
    {
        return previewPolicies.Count(p => !p.IsValid);
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private async Task<IEnumerable<CustomerDto>> SearchCustomersAsync(string searchTerm, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < 2)
            return Enumerable.Empty<CustomerDto>();

        try
        {
            var queryParams = new IAMS.Shared.QueryParams.CustomerQueryParams
            {
                PageNumber = 1,
                PageSize = 10,
                SearchTerm = searchTerm
            };

            var result = await CustomersApi.GetCustomersAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                return result.Data.Items;
            }

            return Enumerable.Empty<CustomerDto>();
        }
        catch
        {
            return Enumerable.Empty<CustomerDto>();
        }
    }

    private void OnOwnerCustomerSelected(PolicyImportPreviewDto policy, CustomerDto? customer)
    {
        if (customer != null)
        {
            policy.PolicyOwnerCustomerId = customer.Id;
            policy.CreateNewPolicyOwner = false;
        }
        else
        {
            policy.PolicyOwnerCustomerId = null;
        }
        StateHasChanged();
    }

    private void OnPolicyOwnerSameAsInsuredChanged(PolicyImportPreviewDto policy, bool value)
    {
        policy.PolicyOwnerSameAsInsured = value;

        // Reset other options when checkbox is checked
        if (value)
        {
            policy.PolicyOwnerCustomerId = null;
            policy.CreateNewPolicyOwner = false;
            policy.PolicyOwnerName = null;
            policy.PolicyOwnerIdentifier = null;
            policy.PolicyOwnerPhone = null;
            policy.PolicyOwnerCustomerType = CustomerType.Individual;
            policy.PolicyOwnerNationalityCountryId = null;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnCreateNewPolicyOwnerChanged(PolicyImportPreviewDto policy, bool value)
    {
        policy.CreateNewPolicyOwner = value;

        // Clear existing customer selection when creating new
        if (value)
        {
            policy.PolicyOwnerCustomerId = null;
            // Set KKTC as default nationality for Individual customers
            policy.PolicyOwnerCustomerType = CustomerType.Individual;
            policy.PolicyOwnerNationalityCountryId = KKTC_COUNTRY_ID;
        }
        else
        {
            policy.PolicyOwnerName = null;
            policy.PolicyOwnerIdentifier = null;
            policy.PolicyOwnerPhone = null;
            policy.PolicyOwnerCustomerType = CustomerType.Individual;
            policy.PolicyOwnerNationalityCountryId = null;
        }

        InvokeAsync(StateHasChanged);
    }
}
