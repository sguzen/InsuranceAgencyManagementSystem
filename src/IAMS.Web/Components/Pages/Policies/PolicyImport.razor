@page "/policies/import"
@layout Layout.MainLayout

@using IAMS.Shared.DTOs.Policy
@using IAMS.Shared.DTOs.InsuranceCompany
@using IAMS.Application.Models
@using Microsoft.AspNetCore.WebUtilities
@using IAMS.Web.Services.ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IInsuranceCompaniesApiClient InsuranceCompaniesApi
@inject IPoliciesApiClient PoliciesApi

<PageTitle>Poliçe İçe Aktar</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" />
                Poliçe İçe Aktar
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/policies">
                Geri Dön
            </MudButton>
        </MudStack>

        <!-- Instructions Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Kullanım Talimatları
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Excel dosyanızdan poliçeleri toplu olarak içe aktarabilirsiniz. Lütfen aşağıdaki adımları takip edin:
                </MudText>
                <MudList Dense="true" T="String">
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Excel dosyanızın (.xlsx veya .xls) formatında olduğundan emin olun
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Dosya boyutu 10 MB'dan küçük olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        İlk satır başlık satırı olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Müşteriler sisteme önceden eklenmiş olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Sigorta şirketleri ve poliçe tipleri tanımlı olmalıdır
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>

        <!-- File Upload Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Excel Dosyası Seçin ve Yükleyin</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <form method="post" action="/api/fileupload/policies/import" enctype="multipart/form-data" data-enhance="false" id="uploadForm">
                    <MudStack Spacing="3">
                        <!-- Insurance Company Selection -->
                        <MudSelect T="int" Label="Sigorta Şirketi" @bind-Value="selectedInsuranceCompanyId"
                                   Required="true" Variant="Variant.Outlined">
                            @foreach (var company in insuranceCompanies)
                            {
                                <MudSelectItem Value="@company.Id">@company.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <input type="hidden" name="insuranceCompanyId" value="@selectedInsuranceCompanyId" />

                        <MudText Typo="Typo.body2">
                            Dosya seçin (.xlsx veya .xls):
                        </MudText>

                        <input type="file"
                               name="file"
                               accept=".xlsx,.xls"
                               required
                               class="mud-input-root mud-input-root-outlined mud-input-root-adorned-start"
                               style="padding: 10px; border: 1px solid #ccc; border-radius: 4px; width: 100%;" />

                        <button type="submit"
                                class="mud-button-root mud-button mud-button-filled mud-button-filled-success mud-ripple"
                                style="width: fit-content;">
                            <span class="mud-button-label">
                                <span class="mud-button-icon-start">
                                    <svg class="mud-icon-root mud-svg-icon mud-icon-size-medium" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"></path>
                                    </svg>
                                </span>
                                İçe Aktar
                            </span>
                        </button>

                        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                            Not: Dosya yüklendiğinde sayfa yenilenecektir.
                        </MudAlert>
                    </MudStack>
                </form>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private List<InsuranceCompanyDto> insuranceCompanies = new();
    private int selectedInsuranceCompanyId;

    protected override async Task OnInitializedAsync()
    {
        await LoadInsuranceCompaniesAsync();
        CheckImportStatus();
    }

    private void CheckImportStatus()
    {
        var uri = new Uri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("success", out var successValue) && successValue == "1")
        {
            Snackbar.Add("Poliçeler başarıyla içe aktarıldı!", MudBlazor.Severity.Success);
            // Clean up the URL by navigating to the same page without query parameters
            Navigation.NavigateTo("/policies/import", replace: true);
        }
        else if (queryParams.TryGetValue("error", out var errorValue) && errorValue == "1")
        {
            Snackbar.Add("Poliçe içe aktarma işlemi sırasında bir hata oluştu. Lütfen dosyanızı kontrol edip tekrar deneyin.", MudBlazor.Severity.Error);
            // Clean up the URL by navigating to the same page without query parameters
            Navigation.NavigateTo("/policies/import", replace: true);
        }
    }

    private async Task LoadInsuranceCompaniesAsync()
    {
        try
        {
            var result = await InsuranceCompaniesApi.GetActiveInsuranceCompaniesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                insuranceCompanies = result.Data;
                if (insuranceCompanies.Any())
                {
                    selectedInsuranceCompanyId = insuranceCompanies.First().Id;
                }
            }
            else
            {
                insuranceCompanies = new List<InsuranceCompanyDto>();
                Snackbar.Add("Sigorta şirketleri yüklenemedi", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            insuranceCompanies = new List<InsuranceCompanyDto>();
            Snackbar.Add($"Sigorta şirketleri yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
    }
}
