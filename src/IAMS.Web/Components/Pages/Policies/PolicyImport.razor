@page "/policies/import"
@layout Layout.MainLayout

@using IAMS.Application.DTOs.Policy
@using IAMS.Application.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Poliçe İçe Aktar</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" GutterBottom="false">
                <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" />
                Poliçe İçe Aktar
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="GoBack">
                Geri Dön
            </MudButton>
        </MudStack>

        <!-- Instructions Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Kullanım Talimatları
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Excel dosyanızdan poliçeleri toplu olarak içe aktarabilirsiniz. Lütfen aşağıdaki adımları takip edin:
                </MudText>
                <MudList Dense="true" T="String">
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Excel dosyanızın (.xlsx veya .xls) formatında olduğundan emin olun
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Dosya boyutu 10 MB'dan küçük olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        İlk satır başlık satırı olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Müşteriler sisteme önceden eklenmiş olmalıdır
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        Sigorta şirketleri ve poliçe tipleri tanımlı olmalıdır
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>

        <!-- File Upload Card -->
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Excel Dosyası Seçin</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <InputFile @ref="fileInputRef"
                          OnChange="OnFileSelected"
                          accept=".xlsx,.xls"
                          style="display: none;" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="TriggerFileInput"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    Dosya Seç
                </MudButton>

                @if (selectedFile != null)
                {
                    <MudChip T="string"
                             Color="Color.Info"
                             Icon="@Icons.Material.Filled.InsertDriveFile"
                             OnClose="ClearFile"
                             Class="mt-3">
                        @selectedFile.Name (@FormatFileSize(selectedFile.Size))
                    </MudChip>
                }

                @if (selectedFile != null)
                {
                    <MudStack Row Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   OnClick="ImportPolicies"
                                   Disabled="@isUploading">
                            @if (isUploading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <span>İçe Aktarılıyor...</span>
                            }
                            else
                            {
                                <span>İçe Aktar</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   OnClick="ClearFile"
                                   Disabled="@isUploading">
                            İptal
                        </MudButton>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>

        <!-- Upload Progress -->
        @if (isUploading)
        {
            <MudCard>
                <MudCardContent>
                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        <MudText Typo="Typo.body1">Dosya yükleniyor ve poliçeler işleniyor...</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Bu işlem biraz zaman alabilir.</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        <!-- Import Results -->
        @if (importResult != null)
        {
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
                            İçe Aktarma Sonuçları
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Info" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Satır</MudText>
                                        <MudText Typo="Typo.h4">@importResult.TotalRows</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Başarılı</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Success">@importResult.SuccessCount</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCard Elevation="2">
                                <MudCardContent Class="pb-2">
                                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Color="Color.Error" />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Hatalı</MudText>
                                        <MudText Typo="Typo.h4" Color="Color.Error">@importResult.FailureCount</MudText>
                                    </MudStack>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>

                    @if (importResult.Errors != null && importResult.Errors.Any())
                    {
                        <MudText Typo="Typo.h6" Class="mt-6 mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="mr-2" />
                            Hatalar
                        </MudText>
                        <MudTable Items="@importResult.Errors" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Satır No</MudTh>
                                <MudTh>Poliçe No</MudTh>
                                <MudTh>Alan</MudTh>
                                <MudTh>Hata Mesajı</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Satır No">@context.RowNumber</MudTd>
                                <MudTd DataLabel="Poliçe No">@context.PolicyNumber</MudTd>
                                <MudTd DataLabel="Alan">@context.FieldName</MudTd>
                                <MudTd DataLabel="Hata Mesajı">
                                    <MudText Typo="Typo.body2" Color="Color.Error">@context.ErrorMessage</MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }

                    @if (importResult.SuccessCount > 0)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Success" Class="mt-4">
                            @importResult.SuccessCount poliçe başarıyla içe aktarıldı!
                        </MudAlert>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.List"
                               Href="/policies">
                        Poliçeleri Görüntüle
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="ResetImport">
                        Yeni İçe Aktarım
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }
    </MudStack>
</MudContainer>

@code {
    private InputFile? fileInputRef;
    private IBrowserFile? selectedFile;
    private bool isUploading = false;
    private PolicyImportResultDto? importResult;

    private async Task TriggerFileInput()
    {
        try
        {
            if (fileInputRef?.Element != null)
            {
                await JSRuntime.InvokeVoidAsync("eval", "arguments[0].click()", fileInputRef.Element);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Dosya seçimi tetiklenemedi: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            try
            {
                const long maxFileSize = 10 * 1024 * 1024; // 10MB

                var file = e.File;
                if (file != null)
                {
                    // Check file size before accepting it
                    if (file.Size > maxFileSize)
                    {
                        Snackbar.Add($"Dosya boyutu çok büyük. Maksimum 10 MB olmalıdır. (Seçilen: {FormatFileSize(file.Size)})", MudBlazor.Severity.Error);
                        return;
                    }

                    // Check file extension
                    var extension = Path.GetExtension(file.Name).ToLowerInvariant();
                    if (extension != ".xlsx" && extension != ".xls")
                    {
                        Snackbar.Add("Sadece Excel dosyaları (.xlsx, .xls) yüklenebilir", MudBlazor.Severity.Error);
                        return;
                    }

                    selectedFile = file;
                    importResult = null;
                    StateHasChanged();

                    Snackbar.Add($"Dosya seçildi: {file.Name}", MudBlazor.Severity.Success);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Dosya seçilirken hata: {ex.Message}", MudBlazor.Severity.Error);
                selectedFile = null;
            }
        });
    }

    private void ClearFile()
    {
        selectedFile = null;
        importResult = null;
    }

    private async Task ImportPolicies()
    {
        if (selectedFile == null) return;

        isUploading = true;
        importResult = null;

        try
        {
            // Validate file size
            const long maxFileSize = 10 * 1024 * 1024; // 10MB
            if (selectedFile.Size > maxFileSize)
            {
                Snackbar.Add("Dosya boyutu 10 MB'dan büyük olamaz", MudBlazor.Severity.Error);
                isUploading = false;
                return;
            }

            // Validate file extension
            var extension = Path.GetExtension(selectedFile.Name).ToLowerInvariant();
            if (extension != ".xlsx" && extension != ".xls")
            {
                Snackbar.Add("Sadece Excel dosyaları (.xlsx, .xls) yüklenebilir", MudBlazor.Severity.Error);
                isUploading = false;
                return;
            }

            // Create multipart form content
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
            content.Add(fileContent, "file", selectedFile.Name);

            // Send to API
            var response = await Http.PostAsync("/api/policies/import", content);

            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Result<PolicyImportResultDto>>(responseContent, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (result != null && result.IsSuccess)
                {
                    importResult = result.Data;

                    if (importResult.SuccessCount > 0)
                    {
                        Snackbar.Add($"{importResult.SuccessCount} poliçe başarıyla içe aktarıldı!", MudBlazor.Severity.Success);
                    }

                    if (importResult.FailureCount > 0)
                    {
                        Snackbar.Add($"{importResult.FailureCount} poliçe içe aktarılamadı. Detaylar için aşağıya bakın.", MudBlazor.Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add(result?.Message ?? "Poliçeler içe aktarılırken hata oluştu", MudBlazor.Severity.Error);
                }
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Sunucu hatası: {errorMessage}", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ResetImport()
    {
        selectedFile = null;
        importResult = null;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/policies");
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
