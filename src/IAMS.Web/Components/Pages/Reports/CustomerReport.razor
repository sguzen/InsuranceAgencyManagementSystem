@page "/reports/customer"
@layout Layout.MainLayout
@rendermode InteractiveServer

@attribute [Authorize]

@using IAMS.Application.DTOs.Customer
@using IAMS.Application.DTOs.Policy
@using IAMS.Application.DTOs.Currency
@using IAMS.Web.Services.ApiClient
@using IAMS.Application.Services.Currencies
@using IAMS.Domain.Enums
@using IAMS.Shared.QueryParams
@using System.Net.Http.Json
@inject ICustomersApiClient CustomersApi
@inject IPoliciesApiClient PoliciesApi
@inject ICurrenciesApiClient CurrenciesApi
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>Müşteri Raporu</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Print Header (only visible when printing) -->
        <div class="print-header" style="display: none;">
            <h1>Müşteri Raporu</h1>
            @if (selectedCustomer != null)
            {
                <div class="print-date">
                    <strong>@selectedCustomer.FirstName @selectedCustomer.LastName</strong> - @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                </div>
            }
        </div>

        <!-- Header -->
        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="no-print">
            <MudText Typo="Typo.h4">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-3" />
                Müşteri Raporu
            </MudText>
            @if (selectedCustomer != null)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintReport"
                           Disabled="@loading">
                    Yazdır
                </MudButton>
            }
        </MudStack>

        <!-- Selection Card -->
        <MudCard Class="no-print">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                        Müşteri Seçimi
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudAutocomplete 
                                       T="CustomerDto"
                                       SearchFunc="@SearchCustomers"
                                       ToStringFunc="@(customer => customer != null ? $"{customer.FirstName} {customer.LastName}" : "")"
                                       Label="Müşteri Seçin *"
                                       Variant="Variant.Outlined"
                                       ResetValueOnEmptyText="true"
                                       CoerceText="true"
                                       CoerceValue="true"
                                       MaxItems="50"
                                       ValueChanged="OnCustomerSelected"
                                       HelperText="Müşteri adı ile arayın">
                            <ItemTemplate Context="customerItem">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                                        @customerItem.FirstName.FirstOrDefault()@customerItem.LastName.FirstOrDefault()
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@customerItem.FirstName @customerItem.LastName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @customerItem.Email - @customerItem.CustomerCode
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect
                                 Label="Para Birimi *"
                                 Variant="Variant.Outlined"
                                 T="string"
                                 @bind-Value="selectedCurrencyCode">
                            @if (currencies != null)
                            {
                                @foreach (var currency in currencies)
                                {
                                    <MudSelectItem Value="@currency.Code">
                                        @currency.Code - @currency.Name
                                    </MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        @if (loading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8 no-print">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.h6">Müşteri bilgileri yükleniyor...</MudText>
            </MudStack>
        }
        else if (selectedCustomer != null)
        {
            <!-- Customer Information -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Class="mr-2" />
                            Müşteri Bilgileri
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Müşteri Kodu</MudText>
                                <MudText Typo="Typo.body1"><strong>@selectedCustomer.CustomerCode</strong></MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Ad Soyad</MudText>
                                <MudText Typo="Typo.body1"><strong>@selectedCustomer.FirstName @selectedCustomer.LastName</strong></MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">E-posta</MudText>
                                <MudText Typo="Typo.body1">@selectedCustomer.Email</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Telefon</MudText>
                                <MudText Typo="Typo.body1">@selectedCustomer.MobilePhoneNumber</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Kimlik No</MudText>
                                <MudText Typo="Typo.body1">@selectedCustomer.IdentificationNumber</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Durum</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetCustomerStatusColor()">
                                    @GetCustomerStatusText()
                                </MudChip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Kayıt Tarihi</MudText>
                                <MudText Typo="Typo.body1">@selectedCustomer.CreatedDate.ToString("dd.MM.yyyy")</MudText>
                            </MudStack>
                        </MudItem>
                        @if (!string.IsNullOrEmpty(selectedCustomer.Address1))
                        {
                            <MudItem xs="12" md="6">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Adres 1</MudText>
                                    <MudText Typo="Typo.body1">@selectedCustomer.Address1</MudText>
                                </MudStack>
                            </MudItem>
                        }
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <!-- Financial Summary -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent Class="pb-2">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Poliçe (@selectedCurrencyCode)</MudText>
                                    <MudText Typo="Typo.h4">@filteredPolicies.Count</MudText>
                                </MudStack>
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Primary" />
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent Class="pb-2">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Aktif Poliçe</MudText>
                                    <MudText Typo="Typo.h4" Color="Color.Success">@activePolicyCount</MudText>
                                </MudStack>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent Class="pb-2">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Prim (@selectedCurrencyCode)</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Info">@totalPremiums.ToString("N2")</MudText>
                                </MudStack>
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Info" />
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="2">
                        <MudCardContent Class="pb-2">
                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Toplam Komisyon (@selectedCurrencyCode)</MudText>
                                    <MudText Typo="Typo.h5" Color="Color.Warning">@totalCommissions.ToString("N2")</MudText>
                                </MudStack>
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Large" Color="Color.Warning" />
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Policies List -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
                            Poliçeler (@selectedCurrencyCode)
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (mainPolicies.Any())
                    {
                        <MudDataGrid T="PolicyDto"
                                     Items="@mainPolicies"
                                     Hover="true"
                                     Striped="true"
                                     Dense="true">
                            <Columns>
                                <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="width: 60px;">
                                    <CellTemplate>
                                        @if (HasEndorsements(context.Item.Id))
                                        {
                                            <MudIconButton Icon="@(IsExpanded(context.Item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                           Size="Size.Small"
                                                           OnClick="@(() => ToggleExpand(context.Item.Id))"
                                                           Title="@(IsExpanded(context.Item.Id) ? "Zeyilleri Gizle" : "Zeyilleri Göster")" />
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.PolicyNumber" Title="Poliçe No" />
                                <TemplateColumn Title="Z.No">
                                    <CellTemplate>
                                        <div style="text-align: center;">
                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.Center">
                                                <MudText Typo="Typo.body2">@context.Item.InnerCode</MudText>
                                                @if (HasEndorsements(context.Item.Id))
                                                {
                                                    <MudChip Size="Size.Small" Color="Color.Info" T="int">@GetEndorsementCount(context.Item.Id) Zeyil</MudChip>
                                                }
                                            </MudStack>
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.InsuranceCompany!.Name" Title="Sigorta Şirketi" />
                                <PropertyColumn Property="x => x.PolicyType!.Name" Title="Poliçe Tipi" />
                                <TemplateColumn Title="Araç">
                                    <CellTemplate>
                                        @if (context.Item.Vehicle != null)
                                        {
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2"><strong>@context.Item.Vehicle.PlateNumber</strong></MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Vehicle.FullName</MudText>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Başlangıç">
                                    <CellTemplate>
                                        <div style="text-align: center;">
                                            @context.Item.StartDate.ToString("dd.MM.yyyy")
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Bitiş">
                                    <CellTemplate>
                                        <div style="text-align: center;">
                                            @context.Item.EndDate.ToString("dd.MM.yyyy")
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Prim">
                                    <CellTemplate>
                                        <div style="text-align: right;">
                                            @context.Item.PremiumAmount.ToString("N2")
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Komisyon">
                                    <CellTemplate>
                                        <div style="text-align: right;">
                                            @context.Item.CommissionAmount.ToString("N2")
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Durum">
                                    <CellTemplate>
                                        <div style="text-align: center;">
                                            <MudChip T="string" Size="Size.Small" Color="@GetPolicyStatusColor(context.Item.Status)">
                                                @GetPolicyStatusText(context.Item.Status)
                                            </MudChip>
                                        </div>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <ChildRowContent>
                                @if (IsExpanded(context.Item.Id) && HasEndorsements(context.Item.Id))
                                {
                                    <td colspan="11">
                                        <MudCard Elevation="0" Class="ma-2">
                                            <MudCardHeader>
                                                <CardHeaderContent>
                                                    <MudText Typo="Typo.subtitle2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                                                        Zeyilnameler (@GetEndorsementCount(context.Item.Id))
                                                    </MudText>
                                                </CardHeaderContent>
                                            </MudCardHeader>
                                            <MudCardContent>
                                                <MudTable Items="@GetEndorsements(context.Item.Id)" Hover="true" Dense="true" Elevation="0">
                                                    <HeaderContent>
                                                        <MudTh>Z.No</MudTh>
                                                        <MudTh>Başlangıç</MudTh>
                                                        <MudTh>Bitiş</MudTh>
                                                        <MudTh Style="text-align: right">Prim</MudTh>
                                                        <MudTh Style="text-align: right">Komisyon</MudTh>
                                                        <MudTh Style="text-align: center">Durum</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate Context="endorsement">
                                                        <MudTd DataLabel="Z.No">
                                                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudText Typo="Typo.body2">@endorsement.InnerCode</MudText>
                                                                <MudChip Size="Size.Small" Color="Color.Info" T="string">Zeyil</MudChip>
                                                            </MudStack>
                                                        </MudTd>
                                                        <MudTd DataLabel="Başlangıç">@endorsement.StartDate.ToString("dd.MM.yyyy")</MudTd>
                                                        <MudTd DataLabel="Bitiş">@endorsement.EndDate.ToString("dd.MM.yyyy")</MudTd>
                                                        <MudTd DataLabel="Prim" Style="text-align: right">@endorsement.PremiumAmount.ToString("N2")</MudTd>
                                                        <MudTd DataLabel="Komisyon" Style="text-align: right">@endorsement.CommissionAmount.ToString("N2")</MudTd>
                                                        <MudTd DataLabel="Durum" Style="text-align: center">
                                                            <MudChip T="string" Color="@GetPolicyStatusColor(endorsement.Status)" Size="Size.Small">
                                                                @GetPolicyStatusText(endorsement.Status)
                                                            </MudChip>
                                                        </MudTd>
                                                    </RowTemplate>
                                                </MudTable>
                                            </MudCardContent>
                                        </MudCard>
                                    </td>
                                }
                            </ChildRowContent>
                        </MudDataGrid>
                    }
                    else
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info">Bu müşteriye ait poliçe bulunamadı.</MudAlert>
                    }
                </MudCardContent>
            </MudCard>

            <!-- Policies by Type Breakdown -->
            @if (policyBreakdown.Any())
            {
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">
                                <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="mr-2" />
                                Poliçe Tipi Dağılımı
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Hover="true" Dense="true">
                            <thead>
                                <tr>
                                    <th>Poliçe Tipi</th>
                                    <th style="text-align: center">Adet</th>
                                    <th style="text-align: right">Toplam Prim (@selectedCurrencyCode)</th>
                                    <th style="text-align: right">Toplam Komisyon (@selectedCurrencyCode)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var breakdown in policyBreakdown)
                                {
                                    <tr>
                                        <td>@breakdown.PolicyType</td>
                                        <td style="text-align: center">@breakdown.Count</td>
                                        <td style="text-align: right">@breakdown.TotalPremium.ToString("N2")</td>
                                        <td style="text-align: right">@breakdown.TotalCommission.ToString("N2")</td>
                                    </tr>
                                }
                                <tr style="font-weight: bold; border-top: 2px solid;">
                                    <td>TOPLAM</td>
                                    <td style="text-align: center">@policyBreakdown.Sum(x => x.Count)</td>
                                    <td style="text-align: right">@policyBreakdown.Sum(x => x.TotalPremium).ToString("N2")</td>
                                    <td style="text-align: right">@policyBreakdown.Sum(x => x.TotalCommission).ToString("N2")</td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            }

            <!-- Customer Statement Section -->
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mr-2" />
                            Müşteri Hesap Özeti
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadCustomerStatement"
                                   Disabled="@loadingStatement"
                                   Size="Size.Small">
                            Hesap Özeti Getir
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" md="4">
                            <MudDatePicker Label="Başlangıç Tarihi"
                                           @bind-Date="statementStartDate"
                                           Variant="Variant.Outlined"
                                           Editable="true"
                                           DateFormat="dd.MM.yyyy" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker Label="Bitiş Tarihi"
                                           @bind-Date="statementEndDate"
                                           Variant="Variant.Outlined"
                                           Editable="true"
                                           DateFormat="dd.MM.yyyy" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect Label="Para Birimi (Opsiyonel)"
                                       Variant="Variant.Outlined"
                                       T="string"
                                       @bind-Value="statementCurrencyFilter"
                                       Clearable="true">
                                @if (currencies != null)
                                {
                                    @foreach (var currency in currencies)
                                    {
                                        <MudSelectItem Value="@currency.Code">
                                            @currency.Code - @currency.Name
                                        </MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    @if (loadingStatement)
                    {
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                            <MudText Typo="Typo.body1">Hesap özeti yükleniyor...</MudText>
                        </MudStack>
                    }
                    else if (customerStatement != null && customerStatement.CurrencyStatements != null && customerStatement.CurrencyStatements.Any())
                    {
                        @foreach (var currencyStatement in customerStatement.CurrencyStatements)
                        {
                            <MudPaper Class="pa-4 mb-4" Elevation="2">
                                <MudStack Spacing="3">
                                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.h6" Color="Color.Primary">
                                            @currencyStatement.CurrencyCode (@currencyStatement.CurrencySymbol) - @currencyStatement.CurrencyName
                                        </MudText>
                                        <MudChip T="string" Color="Color.Info">
                                            @currencyStatement.Transactions.Count İşlem
                                        </MudChip>
                                    </MudStack>

                                    <!-- Summary Cards -->
                                    <MudGrid>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudCard Outlined="true">
                                                <MudCardContent Class="pb-2">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Açılış Bakiyesi</MudText>
                                                        <MudText Typo="Typo.h6">@currencyStatement.OpeningBalance.ToString("N2") @currencyStatement.CurrencySymbol</MudText>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudCard Outlined="true">
                                                <MudCardContent Class="pb-2">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Toplam Borç</MudText>
                                                        <MudText Typo="Typo.h6" Color="Color.Error">@currencyStatement.TotalDebit.ToString("N2") @currencyStatement.CurrencySymbol</MudText>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudCard Outlined="true">
                                                <MudCardContent Class="pb-2">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Toplam Alacak</MudText>
                                                        <MudText Typo="Typo.h6" Color="Color.Success">@currencyStatement.TotalCredit.ToString("N2") @currencyStatement.CurrencySymbol</MudText>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudCard Outlined="true">
                                                <MudCardContent Class="pb-2">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Kapanış Bakiyesi</MudText>
                                                        <MudText Typo="Typo.h6" Color="@(currencyStatement.ClosingBalance >= 0 ? Color.Success : Color.Error)">
                                                            @currencyStatement.ClosingBalance.ToString("N2") @currencyStatement.CurrencySymbol
                                                        </MudText>
                                                    </MudStack>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                    </MudGrid>

                                    <!-- Transactions Table -->
                                    <MudTable Items="@currencyStatement.Transactions"
                                              Hover="true"
                                              Striped="true"
                                              Dense="true"
                                              Breakpoint="Breakpoint.Sm">
                                        <HeaderContent>
                                            <MudTh>DE-NO</MudTh>
                                            <MudTh>TARİH</MudTh>
                                            <MudTh Style="text-align: right">BORÇ</MudTh>
                                            <MudTh Style="text-align: right">ALACAK</MudTh>
                                            <MudTh Style="text-align: right">BAKİYE</MudTh>
                                            <MudTh>AÇIKLAMA</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="DE-NO">
                                                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.DocumentNumber</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="TARİH">
                                                <MudText Typo="Typo.body2">@context.TransactionDate.ToString("dd.MM.yyyy")</MudText>
                                            </MudTd>
                                            <MudTd DataLabel="BORÇ" Style="text-align: right">
                                                <MudText Typo="Typo.body2" Color="@(context.Debit > 0 ? Color.Error : Color.Default)">
                                                    @(context.Debit > 0 ? context.Debit.ToString("N2") : "")
                                                </MudText>
                                            </MudTd>
                                            <MudTd DataLabel="ALACAK" Style="text-align: right">
                                                <MudText Typo="Typo.body2" Color="@(context.Credit > 0 ? Color.Success : Color.Default)">
                                                    @(context.Credit > 0 ? context.Credit.ToString("N2") : "")
                                                </MudText>
                                            </MudTd>
                                            <MudTd DataLabel="BAKİYE" Style="text-align: right">
                                                <MudText Typo="Typo.body2" Style="font-weight: bold;" Color="@(context.Balance >= 0 ? Color.Success : Color.Error)">
                                                    @context.Balance.ToString("N2")
                                                </MudText>
                                            </MudTd>
                                            <MudTd DataLabel="AÇIKLAMA">
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.body2">@context.Description</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TransactionType</MudText>
                                                </MudStack>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                    else if (customerStatement != null)
                    {
                        <MudAlert Severity="Severity.Info">
                            Seçilen tarih aralığında işlem bulunamadı.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal">
                            Hesap özetini görüntülemek için yukarıdaki "Hesap Özeti Getir" butonuna tıklayın.
                        </MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Class="pa-8 no-print" Elevation="0">
                <MudStack AlignItems="AlignItems.Center" Spacing="4">
                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch"
                             Style="font-size: 6rem;"
                             Color="Color.Secondary" />
                    <MudText Typo="Typo.h5" Color="Color.Secondary">
                        Rapor görmek için bir müşteri seçin
                    </MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                        Yukarıdaki arama kutusundan müşteri adı yazarak müşteri arayabilirsiniz.
                    </MudText>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private CustomerDto? selectedCustomer;
    private string _selectedCurrencyCode = "TRY";
    private string selectedCurrencyCode
    {
        get => _selectedCurrencyCode;
        set
        {
            if (_selectedCurrencyCode != value)
            {
                _selectedCurrencyCode = value;
                if (selectedCustomer != null)
                {
                    // Recalculate statistics with new currency
                    InvokeAsync(async () =>
                    {
                        await CalculateStatistics();
                        StateHasChanged();
                    });
                }
            }
        }
    }
    private List<CurrencyDto> currencies = new();
    private List<PolicyDto> customerPolicies = new();
    private List<PolicyDto> filteredPolicies = new();
    private List<PolicyDto> allFilteredPolicies = new(); // All policies including endorsements
    private List<PolicyDto> mainPolicies = new(); // Only main policies for display
    private Dictionary<int, List<PolicyDto>> endorsementsByPolicy = new(); // Endorsements grouped by main policy ID
    private HashSet<int> expandedPolicies = new(); // Track which policies are expanded
    private bool loading = false;

    // Statistics
    private int activePolicyCount = 0;
    private decimal totalPremiums = 0;
    private decimal totalCommissions = 0;
    private List<PolicyTypeBreakdown> policyBreakdown = new();

    // Customer Statement
    private bool loadingStatement = false;
    private CustomerMultiCurrencyStatementDto? customerStatement = null;
    private DateTime? statementStartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? statementEndDate = DateTime.Today;
    private string? statementCurrencyFilter = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrenciesApi.GetActiveCurrenciesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                currencies = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading currencies: {ex.Message}");
            Snackbar.Add("Para birimleri yüklenirken hata oluştu", MudBlazor.Severity.Error);
        }
    }

    private async Task OnCustomerSelected(CustomerDto customer)
    {
        selectedCustomer = customer;
        if (customer != null)
        {
            await LoadCustomerReport();
        }
        else
        {
            ClearReport();
        }
    }

    private async Task LoadCustomerReport()
    {
        if (selectedCustomer == null) return;

        loading = true;
        StateHasChanged(); // Update UI to show loading state

        try
        {
            // Load customer policies
            var queryParams = new PolicyQueryParams
            {
                CustomerId = selectedCustomer.Id,
                PageSize = 1000,
                PageNumber = 1
            };

            var result = await PoliciesApi.GetPoliciesAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                customerPolicies = result.Data.Items.ToList();
                await CalculateStatistics();
            }
            else
            {
                customerPolicies = new List<PolicyDto>();
                ClearStatistics();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer report: {ex.Message}");
            Snackbar.Add("Müşteri raporu yüklenirken hata oluştu", MudBlazor.Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged(); // Update UI after loading completes
        }
    }

    private async Task CalculateStatistics()
    {
        // Filter policies by selected currency
        allFilteredPolicies = customerPolicies
            .Where(p => !string.IsNullOrEmpty(p.Currency) && p.Currency.Trim() == selectedCurrencyCode.Trim())
            .ToList();

        // Separate main policies from endorsements
        mainPolicies = allFilteredPolicies.Where(p => p.InnerCode == "000").ToList();

        // Group endorsements by their main policy ID
        endorsementsByPolicy.Clear();
        var endorsements = allFilteredPolicies.Where(p => p.InnerCode != "000" && p.OriginalPolicyId.HasValue).ToList();
        foreach (var endorsement in endorsements)
        {
            if (!endorsementsByPolicy.ContainsKey(endorsement.OriginalPolicyId.Value))
            {
                endorsementsByPolicy[endorsement.OriginalPolicyId.Value] = new List<PolicyDto>();
            }
            endorsementsByPolicy[endorsement.OriginalPolicyId.Value].Add(endorsement);
        }

        // Sort endorsements by InnerCode
        foreach (var key in endorsementsByPolicy.Keys.ToList())
        {
            endorsementsByPolicy[key] = endorsementsByPolicy[key].OrderBy(e => e.InnerCode).ToList();
        }

        // For backward compatibility, keep filteredPolicies containing all policies
        filteredPolicies = allFilteredPolicies;

        activePolicyCount = allFilteredPolicies.Count(p => p.Status == PolicyStatus.Active);

        totalPremiums = 0;
        totalCommissions = 0;

        foreach (var policy in allFilteredPolicies)
        {
            totalPremiums += policy.PremiumAmount;
            totalCommissions += policy.CommissionAmount;
        }

        // Calculate breakdown by policy type
        policyBreakdown.Clear();
        var grouped = allFilteredPolicies.GroupBy(p => p.PolicyType?.Name ?? "Bilinmeyen");
        foreach (var group in grouped)
        {
            var breakdown = new PolicyTypeBreakdown
            {
                PolicyType = group.Key,
                Count = group.Count()
            };

            foreach (var policy in group)
            {
                breakdown.TotalPremium += policy.PremiumAmount;
                breakdown.TotalCommission += policy.CommissionAmount;
            }

            policyBreakdown.Add(breakdown);
        }

        policyBreakdown = policyBreakdown.OrderByDescending(x => x.TotalPremium).ToList();
    }

    private async Task<IEnumerable<CustomerDto>> SearchCustomers(string searchText, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 2)
            return new List<CustomerDto>();

        try
        {
            var queryParams = new CustomerQueryParams
            {
                SearchTerm = searchText,
                PageSize = 50,
                PageNumber = 1
            };

            var result = await CustomersApi.GetCustomersAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                return result.Data.Items;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching customers: {ex.Message}");
        }

        return new List<CustomerDto>();
    }

    private void ClearReport()
    {
        customerPolicies.Clear();
        filteredPolicies.Clear();
        ClearStatistics();
    }

    private void ClearStatistics()
    {
        activePolicyCount = 0;
        totalPremiums = 0;
        totalCommissions = 0;
        policyBreakdown.Clear();
        filteredPolicies.Clear();
        allFilteredPolicies.Clear();
        mainPolicies.Clear();
        endorsementsByPolicy.Clear();
        expandedPolicies.Clear();
    }

    private async Task PrintReport()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yazdırma hatası: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private Color GetCustomerStatusColor()
    {
        return selectedCustomer?.Status switch
        {
            CustomerStatus.Active => Color.Success,
            CustomerStatus.Inactive => Color.Secondary,
            CustomerStatus.Suspended => Color.Warning,
            _ => Color.Default
        };
    }

    private string GetCustomerStatusText()
    {
        return selectedCustomer?.Status switch
        {
            CustomerStatus.Active => "Aktif",
            CustomerStatus.Inactive => "Pasif",
            CustomerStatus.Suspended => "Askıya Alınmış",
            _ => "Bilinmiyor"
        };
    }

    private Color GetPolicyStatusColor(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => Color.Success,
            PolicyStatus.Draft => Color.Info,
            PolicyStatus.Cancelled => Color.Error,
            PolicyStatus.Expired => Color.Warning,
            PolicyStatus.Suspended => Color.Secondary,
            _ => Color.Default
        };
    }

    private string GetPolicyStatusText(PolicyStatus status)
    {
        return status switch
        {
            PolicyStatus.Active => "Aktif",
            PolicyStatus.Draft => "Taslak",
            PolicyStatus.Cancelled => "İptal",
            PolicyStatus.Expired => "Süresi Dolmuş",
            PolicyStatus.Suspended => "Askıya Alınmış",
            _ => "Bilinmiyor"
        };
    }

    // Endorsement accordion methods
    private bool HasEndorsements(int policyId)
    {
        return endorsementsByPolicy.ContainsKey(policyId) && endorsementsByPolicy[policyId].Any();
    }

    private int GetEndorsementCount(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId].Count : 0;
    }

    private List<PolicyDto> GetEndorsements(int policyId)
    {
        return HasEndorsements(policyId) ? endorsementsByPolicy[policyId] : new List<PolicyDto>();
    }

    private bool IsExpanded(int policyId)
    {
        return expandedPolicies.Contains(policyId);
    }

    private void ToggleExpand(int policyId)
    {
        if (expandedPolicies.Contains(policyId))
        {
            expandedPolicies.Remove(policyId);
        }
        else
        {
            expandedPolicies.Add(policyId);
        }
    }

    private async Task LoadCustomerStatement()
    {
        if (selectedCustomer == null) return;

        loadingStatement = true;
        customerStatement = null;
        StateHasChanged();

        try
        {
            // Build query parameters
            var startParam = statementStartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
            var endParam = statementEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
            var currencyParam = !string.IsNullOrWhiteSpace(statementCurrencyFilter) ? $"&currencyCode={statementCurrencyFilter}" : "";

            var url = $"api/customers/{selectedCustomer.Id}/statement?startDate={startParam}&endDate={endParam}{currencyParam}";

            var response = await Http.GetFromJsonAsync<IAMS.Shared.Models.Result<CustomerMultiCurrencyStatementDto>>(url);

            if (response != null && response.IsSuccess && response.Data != null)
            {
                customerStatement = response.Data;
                Snackbar.Add("Hesap özeti başarıyla yüklendi", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Hesap özeti yüklenirken hata oluştu", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer statement: {ex.Message}");
            Snackbar.Add($"Hesap özeti yüklenirken hata oluştu: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            loadingStatement = false;
            StateHasChanged();
        }
    }

    private class PolicyTypeBreakdown
    {
        public string PolicyType { get; set; } = string.Empty;
        public int Count { get; set; }
        public decimal TotalPremium { get; set; }
        public decimal TotalCommission { get; set; }
    }
}
