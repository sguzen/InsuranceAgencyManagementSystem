@page "/reports/financial"
@layout Layout.MainLayout
@rendermode InteractiveServer

@attribute [Authorize]
@using IAMS.Application.DTOs.Currency
@using IAMS.Application.Services.Policies
@using IAMS.Application.Services.Currencies
@using IAMS.Infrastructure.Interfaces
@using IAMS.MultiTenancy.Interfaces

@using IAMS.Application.Services.Claims
@inject IPolicyService PolicyService
@inject IClaimService ClaimService
@inject ICurrencyService CurrencyService
@inject IReportingService ReportingService
@inject ITenantContextAccessor TenantContext
@inject ISnackbar Snackbar

<PageTitle>Mali Raporlar - IAMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />
            Mali Raporlar
        </MudText>
        <MudSelect T="string"
                   Label="Para Birimi"
                   Variant="Variant.Outlined"
                   @bind-Value="selectedCurrencyCode"
                   Style="min-width: 150px;">
            @if (currencies != null)
            {
                @foreach (var currency in currencies)
                {
                    <MudSelectItem Value="@currency.Code">
                        @currency.Code - @currency.Name
                    </MudSelectItem>
                }
            }
        </MudSelect>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <!-- Financial Summary Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Toplam Gelir (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@totalRevenue.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Toplam Komisyon (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@totalCommission.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Info" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Aylık Gelir (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@monthlyRevenue.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Yıllık Gelir (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@yearlyRevenue.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Secondary" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Report Selection Tabs -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @bind-ActivePanelIndex="activeTab">
            <!-- Commission Report Tab -->
            <MudTabPanel Icon="@Icons.Material.Filled.Payments" Text="Komisyon Raporu">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <!-- Commission Report Parameters -->
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Başlangıç Tarihi"
                                              @bind-Date="commissionStartDate"
                                              Variant="Variant.Outlined"
                                              DateFormat="dd.MM.yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Bitiş Tarihi"
                                              @bind-Date="commissionEndDate"
                                              Variant="Variant.Outlined"
                                              DateFormat="dd.MM.yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                          Color="Color.Primary"
                                          StartIcon="@Icons.Material.Filled.Refresh"
                                          OnClick="LoadCommissionReport"
                                          FullWidth="true">
                                    Raporu Oluştur
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        <!-- Commission Report Summary -->
                        <MudText Typo="Typo.h6" Class="mb-3">Komisyon Özeti</MudText>
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudSimpleTable Dense="true">
                                            <tbody>
                                                <tr>
                                                    <td><strong>Yeni Poliçeler</strong></td>
                                                    <td style="text-align: right;">
                                                        <MudChip Color="Color.Success" Size="Size.Small" T="String">
                                                            @commissionNewPolicies.ToString("N0")
                                                        </MudChip>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Yenilemeler</strong></td>
                                                    <td style="text-align: right;">
                                                        <MudChip Color="Color.Info" Size="Size.Small" T="String">
                                                            @commissionRenewals.ToString("N0")
                                                        </MudChip>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Toplam Prim (@selectedCurrencyCode)</strong></td>
                                                    <td style="text-align: right;">
                                                        <MudChip Color="Color.Primary" Size="Size.Small" T="String">
                                                            @commissionTotalPremium.ToString("N2")
                                                        </MudChip>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Toplam Komisyon (@selectedCurrencyCode)</strong></td>
                                                    <td style="text-align: right;">
                                                        <MudChip Color="Color.Success" Size="Size.Small" T="String">
                                                            @commissionTotalCommission.ToString("N2")
                                                        </MudChip>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.subtitle2">Komisyon Oranı</MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <div class="d-flex flex-column align-center justify-center" style="height: 150px;">
                                            <MudText Typo="Typo.h3" Color="Color.Success">
                                                @commissionRate.ToString("F2")%
                                            </MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">
                                                Ortalama Komisyon Oranı
                                            </MudText>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>

                        <!-- Export Buttons -->
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Error"
                                          StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                          OnClick="@(() => ExportCommissionReport("pdf"))"
                                          FullWidth="true"
                                          Disabled="exportingCommission">
                                    @if (exportingCommission && commissionExportFormat == "pdf")
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <span class="ml-2">Dışa Aktarılıyor...</span>
                                    }
                                    else
                                    {
                                        <span>PDF Olarak İndir</span>
                                    }
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Success"
                                          StartIcon="@Icons.Material.Filled.TableChart"
                                          OnClick="@(() => ExportCommissionReport("excel"))"
                                          FullWidth="true"
                                          Disabled="exportingCommission">
                                    @if (exportingCommission && commissionExportFormat == "excel")
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <span class="ml-2">Dışa Aktarılıyor...</span>
                                    }
                                    else
                                    {
                                        <span>Excel Olarak İndir</span>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <!-- Claims Summary Tab -->
            <MudTabPanel Icon="@Icons.Material.Filled.Report" Text="Hasar Raporu">
                <MudCard Elevation="0">
                    <MudCardContent>
                        <!-- Claims Report Parameters -->
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Başlangıç Tarihi"
                                              @bind-Date="claimsStartDate"
                                              Variant="Variant.Outlined"
                                              DateFormat="dd.MM.yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Bitiş Tarihi"
                                              @bind-Date="claimsEndDate"
                                              Variant="Variant.Outlined"
                                              DateFormat="dd.MM.yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex align-end">
                                <MudButton Variant="Variant.Filled"
                                          Color="Color.Primary"
                                          StartIcon="@Icons.Material.Filled.Refresh"
                                          OnClick="LoadClaimsReport"
                                          FullWidth="true">
                                    Raporu Oluştur
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        <!-- Claims Report Summary -->
                        <MudText Typo="Typo.h6" Class="mb-3">Hasar Özeti</MudText>
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" sm="6" md="3">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2" Color="Color.Default">Toplam Hasar</MudText>
                                        <MudText Typo="Typo.h5">@claimsTotalCount.ToString("N0")</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2" Color="Color.Default">Toplam Tutar (@selectedCurrencyCode)</MudText>
                                        <MudText Typo="Typo.h5">@claimsTotalAmount.ToString("N2")</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2" Color="Color.Default">Onaylanan</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Success">@claimsApproved.ToString("N0")</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="3">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2" Color="Color.Default">İncelenen</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Info">@claimsUnderReview.ToString("N0")</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>

                        <!-- Claims Status Breakdown -->
                        <MudText Typo="Typo.h6" Class="mb-3">Durum Dağılımı</MudText>
                        <MudGrid Class="mb-4">
                            <MudItem xs="12">
                                <MudCard Outlined="true">
                                    <MudCardContent>
                                        <MudSimpleTable Dense="true" Hover="true">
                                            <thead>
                                                <tr>
                                                    <th>Durum</th>
                                                    <th style="text-align: right;">Sayı</th>
                                                    <th style="text-align: right;">Toplam Tutar (@selectedCurrencyCode)</th>
                                                    <th style="text-align: right;">Ortalama (@selectedCurrencyCode)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><MudChip Color="Color.Default" Size="Size.Small" T="String">Başvuruldu</MudChip></td>
                                                    <td style="text-align: right;">@claimsSubmitted.ToString("N0")</td>
                                                    <td style="text-align: right;">@claimsSubmittedAmount.ToString("N2")</td>
                                                    <td style="text-align: right;">@GetAverageClaim(claimsSubmitted, claimsSubmittedAmount)</td>
                                                </tr>
                                                <tr>
                                                    <td><MudChip Color="Color.Info" Size="Size.Small" T="String">İnceleniyor</MudChip></td>
                                                    <td style="text-align: right;">@claimsUnderReview.ToString("N0")</td>
                                                    <td style="text-align: right;">@claimsUnderReviewAmount.ToString("N2")</td>
                                                    <td style="text-align: right;">@GetAverageClaim(claimsUnderReview, claimsUnderReviewAmount)</td>
                                                </tr>
                                                <tr>
                                                    <td><MudChip Color="Color.Success" Size="Size.Small" T="String">Onaylandı</MudChip></td>
                                                    <td style="text-align: right;">@claimsApproved.ToString("N0")</td>
                                                    <td style="text-align: right;">@claimsApprovedAmount.ToString("N2")</td>
                                                    <td style="text-align: right;">@GetAverageClaim(claimsApproved, claimsApprovedAmount)</td>
                                                </tr>
                                                <tr>
                                                    <td><MudChip Color="Color.Error" Size="Size.Small" T="String">Reddedildi</MudChip></td>
                                                    <td style="text-align: right;">@claimsRejected.ToString("N0")</td>
                                                    <td style="text-align: right;">@claimsRejectedAmount.ToString("N2")</td>
                                                    <td style="text-align: right;">@GetAverageClaim(claimsRejected, claimsRejectedAmount)</td>
                                                </tr>
                                                <tr>
                                                    <td><MudChip Color="Color.Success" Size="Size.Small" T="String">Ödendi</MudChip></td>
                                                    <td style="text-align: right;">@claimsSettled.ToString("N0")</td>
                                                    <td style="text-align: right;">@claimsSettledAmount.ToString("N2")</td>
                                                    <td style="text-align: right;">@GetAverageClaim(claimsSettled, claimsSettledAmount)</td>
                                                </tr>
                                            </tbody>
                                        </MudSimpleTable>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>

                        <!-- Export Buttons -->
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Error"
                                          StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                          OnClick="@(() => ExportClaimsReport("pdf"))"
                                          FullWidth="true"
                                          Disabled="exportingClaims">
                                    @if (exportingClaims && claimsExportFormat == "pdf")
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <span class="ml-2">Dışa Aktarılıyor...</span>
                                    }
                                    else
                                    {
                                        <span>PDF Olarak İndir</span>
                                    }
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Success"
                                          StartIcon="@Icons.Material.Filled.TableChart"
                                          OnClick="@(() => ExportClaimsReport("excel"))"
                                          FullWidth="true"
                                          Disabled="exportingClaims">
                                    @if (exportingClaims && claimsExportFormat == "excel")
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <span class="ml-2">Dışa Aktarılıyor...</span>
                                    }
                                    else
                                    {
                                        <span>Excel Olarak İndir</span>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private bool loading = true;
    private int activeTab = 0;

    // Currency
    private string _selectedCurrencyCode = "TRY";
    private string selectedCurrencyCode
    {
        get => _selectedCurrencyCode;
        set
        {
            if (_selectedCurrencyCode != value)
            {
                _selectedCurrencyCode = value;
                InvokeAsync(async () =>
                {
                    await RecalculateWithCurrency();
                    StateHasChanged();
                });
            }
        }
    }
    private List<CurrencyDto> currencies = new();
    private Dictionary<string, decimal> exchangeRates = new();

    // Financial Summary
    private decimal totalRevenue = 0;
    private decimal totalCommission = 0;
    private decimal monthlyRevenue = 0;
    private decimal yearlyRevenue = 0;

    // Commission Report
    private DateTime? commissionStartDate = DateTime.Now.AddMonths(-1);
    private DateTime? commissionEndDate = DateTime.Now;
    private bool exportingCommission = false;
    private string commissionExportFormat = "";
    private int commissionNewPolicies = 0;
    private int commissionRenewals = 0;
    private decimal commissionTotalPremium = 0;
    private decimal commissionTotalCommission = 0;
    private decimal commissionRate = 0;

    // Claims Report
    private DateTime? claimsStartDate = DateTime.Now.AddMonths(-1);
    private DateTime? claimsEndDate = DateTime.Now;
    private bool exportingClaims = false;
    private string claimsExportFormat = "";
    private int claimsTotalCount = 0;
    private decimal claimsTotalAmount = 0;
    private int claimsApproved = 0;
    private int claimsUnderReview = 0;
    private int claimsSubmitted = 0;
    private int claimsRejected = 0;
    private int claimsSettled = 0;
    private decimal claimsSubmittedAmount = 0;
    private decimal claimsUnderReviewAmount = 0;
    private decimal claimsApprovedAmount = 0;
    private decimal claimsRejectedAmount = 0;
    private decimal claimsSettledAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadFinancialSummary();
        await LoadCommissionReport();
        await LoadClaimsReport();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrencyService.GetActiveCurrenciesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                currencies = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading currencies: {ex.Message}");
        }
    }

    private async Task RecalculateWithCurrency()
    {
        exchangeRates.Clear();
        await LoadFinancialSummary();
        await LoadCommissionReport();
        await LoadClaimsReport();
    }

    private async Task<decimal> ConvertAmount(decimal amount, string fromCurrency)
    {
        if (fromCurrency == selectedCurrencyCode)
            return amount;

        var cacheKey = $"{fromCurrency}_{selectedCurrencyCode}";
        if (exchangeRates.ContainsKey(cacheKey))
        {
            return amount * exchangeRates[cacheKey];
        }

        try
        {
            var result = await CurrencyService.ConvertAmountAsync(amount, fromCurrency, selectedCurrencyCode);
            if (result.IsSuccess)
            {
                if (amount != 0)
                {
                    exchangeRates[cacheKey] = result.Data / amount;
                }
                return result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error converting amount: {ex.Message}");
        }

        return amount;
    }

    private async Task LoadFinancialSummary()
    {
        loading = true;
        StateHasChanged();

        try
        {
            var result = await PolicyService.GetPolicyStatisticsAsync();

            if (result.IsSuccess && result.Data != null)
            {
                // Note: These values come from backend and are summed without currency conversion
                // For now we display them, but ideally backend should handle currency conversion
                totalRevenue = result.Data.TotalPremiums;
                totalCommission = result.Data.TotalCommissions;
                monthlyRevenue = result.Data.MonthlyRevenue;
                yearlyRevenue = result.Data.YearlyRevenue;
            }
            else
            {
                Snackbar.Add(result.Message ?? "Mali özet yüklenirken hata oluştu", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCommissionReport()
    {
        try
        {
            // Get policies in date range
            var queryParams = new PolicyQueryParams
            {
                StartDateFrom = commissionStartDate,
                StartDateTo = commissionEndDate,
                PageSize = 10000,
                PageNumber = 1
            };

            var policiesResult = await PolicyService.GetPoliciesAsync(queryParams);

            if (policiesResult.IsSuccess && policiesResult.Data != null)
            {
                var policies = policiesResult.Data.Items.ToList();

                // Calculate commission metrics from real data with currency conversion
                commissionNewPolicies = policies.Count(p => !p.ParentPolicyId.HasValue);
                commissionRenewals = policies.Count(p => p.ParentPolicyId.HasValue);

                commissionTotalPremium = 0;
                commissionTotalCommission = 0;

                foreach (var policy in policies)
                {
                    commissionTotalPremium += await ConvertAmount(policy.PremiumAmount, policy.Currency);
                    commissionTotalCommission += await ConvertAmount(policy.CommissionAmount, policy.Currency);
                }

                commissionRate = commissionTotalPremium > 0
                    ? (commissionTotalCommission / commissionTotalPremium * 100)
                    : 0;

                Snackbar.Add("Komisyon raporu oluşturuldu", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add("Komisyon raporu yüklenirken hata oluştu", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadClaimsReport()
    {
        try
        {
            // Get all claims with paging
            var claimsResult = await ClaimService.GetClaimsPagedAsync(1, 10000, null);

            if (claimsResult != null && claimsResult.Items != null)
            {
                var claims = claimsResult.Items.ToList();

                // Filter by date range if specified
                if (claimsStartDate.HasValue)
                {
                    claims = claims.Where(c => c.ClaimDate >= claimsStartDate.Value).ToList();
                }
                if (claimsEndDate.HasValue)
                {
                    claims = claims.Where(c => c.ClaimDate <= claimsEndDate.Value).ToList();
                }

                // Calculate claims metrics from real data with currency conversion
                claimsTotalCount = claims.Count;
                claimsTotalAmount = 0;

                foreach (var claim in claims)
                {
                    claimsTotalAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }

                // Group by status
                claimsSubmitted = claims.Count(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Submitted);
                claimsUnderReview = claims.Count(c => c.Status == IAMS.Domain.Enums.ClaimStatus.UnderReview);
                claimsApproved = claims.Count(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Approved);
                claimsRejected = claims.Count(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Rejected);
                claimsSettled = claims.Count(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Settled);

                // Calculate amounts by status with currency conversion
                claimsSubmittedAmount = 0;
                claimsUnderReviewAmount = 0;
                claimsApprovedAmount = 0;
                claimsRejectedAmount = 0;
                claimsSettledAmount = 0;

                foreach (var claim in claims.Where(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Submitted))
                {
                    claimsSubmittedAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }
                foreach (var claim in claims.Where(c => c.Status == IAMS.Domain.Enums.ClaimStatus.UnderReview))
                {
                    claimsUnderReviewAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }
                foreach (var claim in claims.Where(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Approved))
                {
                    claimsApprovedAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }
                foreach (var claim in claims.Where(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Rejected))
                {
                    claimsRejectedAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }
                foreach (var claim in claims.Where(c => c.Status == IAMS.Domain.Enums.ClaimStatus.Settled))
                {
                    claimsSettledAmount += await ConvertAmount(claim.ClaimAmount, claim.Currency ?? "TRY");
                }

                Snackbar.Add("Hasar raporu oluşturuldu", MudBlazor.Severity.Success);
            }
            else
            {
                // No claims found
                claimsTotalCount = 0;
                claimsTotalAmount = 0;
                claimsSubmitted = 0;
                claimsUnderReview = 0;
                claimsApproved = 0;
                claimsRejected = 0;
                claimsSettled = 0;
                claimsSubmittedAmount = 0;
                claimsUnderReviewAmount = 0;
                claimsApprovedAmount = 0;
                claimsRejectedAmount = 0;
                claimsSettledAmount = 0;

                Snackbar.Add("Hasar kaydı bulunamadı", MudBlazor.Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task ExportCommissionReport(string format)
    {
        exportingCommission = true;
        commissionExportFormat = format;
        StateHasChanged();

        try
        {
            var parameters = new ReportParameters
            {
                StartDate = commissionStartDate,
                EndDate = commissionEndDate
            };

            var reportData = await ReportingService.ExportReportAsync("commission-report", parameters, format);

            if (reportData != null && reportData.Length > 0)
            {
                Snackbar.Add($"Komisyon raporu {format.ToUpper()} formatında dışa aktarıldı", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add("Rapor oluşturulurken hata oluştu", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            exportingCommission = false;
            commissionExportFormat = "";
            StateHasChanged();
        }
    }

