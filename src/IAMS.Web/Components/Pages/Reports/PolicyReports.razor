@page "/reports/policies"
@layout Layout.MainLayout
@rendermode InteractiveServer

@attribute [Authorize]
@using IAMS.Application.DTOs.Policy
@using IAMS.Application.DTOs.Currency
@using IAMS.Web.Services.ApiClient
@using IAMS.Infrastructure.Interfaces
@using IAMS.MultiTenancy.Interfaces
@using IAMS.Shared.QueryParams
@using IAMS.Web.Services.ApiClient

@inject IPoliciesApiClient PoliciesApi
@inject ICurrenciesApiClient CurrenciesApi
@inject IReportingApiClient ReportingApi
@inject ITenantContextAccessor TenantContext
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Poliçe Raporları - IAMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Class="mr-2" />
            Poliçe Raporları
        </MudText>
        <MudSelect T="string"
                   Label="Para Birimi"
                   Variant="Variant.Outlined"
                   @bind-Value="selectedCurrencyCode"
                   Style="min-width: 150px;">
            @if (currencies != null)
            {
                @foreach (var currency in currencies)
                {
                    <MudSelectItem Value="@currency.Code">
                        @currency.Code - @currency.Name
                    </MudSelectItem>
                }
            }
        </MudSelect>
    </MudStack>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <!-- Statistics Cards Row 1 -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Toplam Poliçe</MudText>
                                <MudText Typo="Typo.h5">@statistics?.TotalPolicies.ToString("N0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Aktif Poliçe</MudText>
                                <MudText Typo="Typo.h5">@statistics?.ActivePolicies.ToString("N0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Toplam Prim (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@totalPremiums.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Toplam Komisyon (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@totalCommissions.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Info" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Statistics Cards Row 2 -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Bu Ay Yeni</MudText>
                                <MudText Typo="Typo.h5">@statistics?.NewPoliciesThisMonth.ToString("N0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Bu Ay Yenileme</MudText>
                                <MudText Typo="Typo.h5">@statistics?.RenewalsThisMonth.ToString("N0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.Refresh" Color="Color.Info" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Süresi Dolan</MudText>
                                <MudText Typo="Typo.h5">@statistics?.ExpiredPolicies.ToString("N0")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Warning" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <div class="d-flex justify-space-between">
                            <div>
                                <MudText Typo="Typo.body2" Color="Color.Default">Ortalama Prim (@selectedCurrencyCode)</MudText>
                                <MudText Typo="Typo.h5">@averagePremium.ToString("N2")</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Secondary" Size="Size.Large" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Report Parameters -->
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Rapor Parametreleri</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="Başlangıç Tarihi"
                                      Date="startDate"
                                      DateChanged="OnStartDateChanged"
                                      Variant="Variant.Outlined"
                                      DateFormat="dd.MM.yyyy" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Label="Bitiş Tarihi"
                                      Date="endDate"
                                      DateChanged="OnEndDateChanged"
                                      Variant="Variant.Outlined"
                                      DateFormat="dd.MM.yyyy" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField Label="Süresi Dolacaklar (Gün)"
                                        Value="daysAhead"
                                        ValueChanged="@(async (int value) => await OnDaysAheadChanged(value))"
                                        Variant="Variant.Outlined"
                                        Min="1"
                                        Max="365" />
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  StartIcon="@Icons.Material.Filled.Refresh"
                                  OnClick="LoadStatistics"
                                  FullWidth="true">
                            Raporu Yenile
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <!-- Policy Statistics Details -->
        <MudGrid>
            <!-- Policies by Type -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Poliçe Tipi Dağılımı</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (revenueByType != null && revenueByType.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Poliçe Tipi</th>
                                        <th style="text-align: right;">Sayı</th>
                                        <th style="text-align: right;">Gelir (@selectedCurrencyCode)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var type in revenueByType)
                                    {
                                        <tr>
                                            <td>@type.Key</td>
                                            <td style="text-align: right;">@type.Value.Count.ToString("N0")</td>
                                            <td style="text-align: right;">@type.Value.Revenue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else
                        {
                            <MudText Color="Color.Default" Align="Align.Center" Class="py-4">
                                Veri bulunamadı
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Policies by Company -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Şirket Dağılımı</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (revenueByCompany != null && revenueByCompany.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Sigorta Şirketi</th>
                                        <th style="text-align: right;">Sayı</th>
                                        <th style="text-align: right;">Gelir (@selectedCurrencyCode)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in revenueByCompany)
                                    {
                                        <tr>
                                            <td>@company.Key</td>
                                            <td style="text-align: right;">@company.Value.Count.ToString("N0")</td>
                                            <td style="text-align: right;">@company.Value.Revenue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else
                        {
                            <MudText Color="Color.Default" Align="Align.Center" Class="py-4">
                                Veri bulunamadı
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Policy Status Breakdown -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Poliçe Durumu</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Dense="true">
                            <tbody>
                                <tr>
                                    <td>Taslak</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Default" Size="Size.Small" T="String">
                                            @statistics?.DraftPolicies.ToString("N0")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Askıda</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Warning" Size="Size.Small" T="String">
                                            @statistics?.SuspendedPolicies.ToString("N0")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>İptal Edilmiş</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Error" Size="Size.Small" T="String">
                                            @statistics?.CancelledPolicies.ToString("N0")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bu Ay İptal</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Error" Size="Size.Small" T="String">
                                            @statistics?.CancellationsThisMonth.ToString("N0")
                                        </MudChip>
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Revenue Statistics -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Gelir İstatistikleri</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Dense="true">
                            <tbody>
                                <tr>
                                    <td>Aylık Gelir (@selectedCurrencyCode)</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Success" Size="Size.Small" T="String">
                                            @monthlyRevenue.ToString("N2")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Yıllık Gelir (@selectedCurrencyCode)</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Success" Size="Size.Small" T="String">
                                            @yearlyRevenue.ToString("N2")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Toplam Prim (@selectedCurrencyCode)</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Primary" Size="Size.Small" T="String">
                                            @totalPremiums.ToString("N2")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Toplam Komisyon (@selectedCurrencyCode)</td>
                                    <td style="text-align: right;">
                                        <MudChip Color="Color.Info" Size="Size.Small" T="String">
                                            @totalCommissions.ToString("N2")
                                        </MudChip>
                                    </td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Export and Print Section -->
        <MudCard Elevation="2" Class="mt-4 no-print">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Raporu Dışa Aktar veya Yazdır</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Error"
                                  StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                  OnClick="@(() => ExportReport("pdf"))"
                                  FullWidth="true"
                                  Disabled="exporting">
                            @if (exporting && exportFormat == "pdf")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Dışa Aktarılıyor...</span>
                            }
                            else
                            {
                                <span>PDF Olarak İndir</span>
                            }
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Success"
                                  StartIcon="@Icons.Material.Filled.TableChart"
                                  OnClick="@(() => ExportReport("excel"))"
                                  FullWidth="true"
                                  Disabled="exporting">
                            @if (exporting && exportFormat == "excel")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Dışa Aktarılıyor...</span>
                            }
                            else
                            {
                                <span>Excel Olarak İndir</span>
                            }
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Outlined"
                                  Color="Color.Info"
                                  StartIcon="@Icons.Material.Filled.Description"
                                  OnClick="@(() => ExportReport("csv"))"
                                  FullWidth="true"
                                  Disabled="exporting">
                            @if (exporting && exportFormat == "csv")
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <span class="ml-2">Dışa Aktarılıyor...</span>
                            }
                            else
                            {
                                <span>CSV Olarak İndir</span>
                            }
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  StartIcon="@Icons.Material.Filled.Print"
                                  OnClick="PrintReport"
                                  FullWidth="true">
                            Yazdır
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    private PolicyStatisticsDto? statistics;
    private bool loading = true;
    private bool exporting = false;
    private string exportFormat = "";
    private DateTime? startDate = DateTime.Now.AddMonths(-1);
    private DateTime? endDate = DateTime.Now;
    private int daysAhead = 30;

    // Currency
    private string _selectedCurrencyCode = "TRY";
    private string selectedCurrencyCode
    {
        get => _selectedCurrencyCode;
        set
        {
            if (_selectedCurrencyCode != value)
            {
                _selectedCurrencyCode = value;
                InvokeAsync(async () =>
                {
                    await RecalculateWithCurrency();
                    StateHasChanged();
                });
            }
        }
    }
    private List<CurrencyDto> currencies = new();

    // Calculated statistics for filtered policies
    private decimal totalPremiums = 0;
    private decimal totalCommissions = 0;
    private decimal averagePremium = 0;
    private decimal monthlyRevenue = 0;
    private decimal yearlyRevenue = 0;
    private Dictionary<string, (int Count, decimal Revenue)> revenueByType = new();
    private Dictionary<string, (int Count, decimal Revenue)> revenueByCompany = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadStatistics();
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var result = await CurrenciesApi.GetActiveCurrenciesAsync();
            if (result.IsSuccess && result.Data != null)
            {
                currencies = result.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading currencies: {ex.Message}");
        }
    }

    private async Task RecalculateWithCurrency()
    {
        await LoadStatistics();
    }

    private async Task OnStartDateChanged(DateTime? value)
    {
        startDate = value;
        await LoadStatistics();
    }

    private async Task OnEndDateChanged(DateTime? value)
    {
        endDate = value;
        await LoadStatistics();
    }

    private async Task OnDaysAheadChanged(int value)
    {
        daysAhead = value;
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        loading = true;
        StateHasChanged();

        try
        {
            // Get policies with date filters applied
            var queryParams = new PolicyQueryParams
            {
                PageSize = 10000,
                PageNumber = 1
            };

            // Apply date range filters if set
            if (startDate.HasValue)
            {
                queryParams.StartDateFrom = startDate.Value;
            }

            if (endDate.HasValue)
            {
                queryParams.StartDateTo = endDate.Value;
            }

            // Note: daysAhead is used for display purposes to show "expiring soon" policies
            // It doesn't filter the backend query, but affects the statistics display
            // If you want to filter only expiring policies, you could add:
            // if (daysAhead > 0)
            // {
            //     queryParams.EndDateFrom = DateTime.Now;
            //     queryParams.EndDateTo = DateTime.Now.AddDays(daysAhead);
            // }

            var policiesResult = await PoliciesApi.GetPoliciesAsync(queryParams);

            if (policiesResult.IsSuccess && policiesResult.Data != null)
            {
                // Filter policies by selected currency
                var allPolicies = policiesResult.Data.Items.ToList();

                // Debug: Check currency distribution
                var currencyGroups = allPolicies.GroupBy(p => p.Currency ?? "NULL").ToDictionary(g => g.Key, g => g.Count());
                Console.WriteLine($"Currency distribution: {string.Join(", ", currencyGroups.Select(kvp => $"{kvp.Key}: {kvp.Value}"))}");
                Console.WriteLine($"Selected currency: {selectedCurrencyCode}");

                var policies = allPolicies.Where(p => !string.IsNullOrEmpty(p.Currency) && p.Currency.Trim() == selectedCurrencyCode.Trim()).ToList();

                Console.WriteLine($"Filtered policies count: {policies.Count}");

                // Calculate statistics from filtered policies
                statistics = new PolicyStatisticsDto
                {
                    TotalPolicies = policies.Count,
                    ActivePolicies = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Active),
                    NewPoliciesThisMonth = policies.Count(p => p.StartDate >= new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)),
                    RenewalsThisMonth = policies.Count(p => p.ParentPolicyId.HasValue && p.StartDate >= new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)),
                    ExpiredPolicies = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Expired || p.EndDate < DateTime.Now),
                    DraftPolicies = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Draft),
                    SuspendedPolicies = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Suspended),
                    CancelledPolicies = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Cancelled),
                    CancellationsThisMonth = policies.Count(p => p.Status == Domain.Enums.PolicyStatus.Cancelled && p.ModifiedOn >= new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1))
                };

                // Reset all calculated values
                totalPremiums = 0;
                totalCommissions = 0;
                monthlyRevenue = 0;
                yearlyRevenue = 0;
                revenueByType.Clear();
                revenueByCompany.Clear();

                // Date ranges for monthly and yearly calculations
                var now = DateTime.Now;
                var firstDayOfMonth = new DateTime(now.Year, now.Month, 1);
                var firstDayOfYear = new DateTime(now.Year, 1, 1);

                // Single pass through filtered policies for all calculations
                foreach (var policy in policies)
                {
                    // No conversion needed - all policies are in the selected currency
                    totalPremiums += policy.PremiumAmount;
                    totalCommissions += policy.CommissionAmount;

                    // Monthly revenue (policies started this month)
                    if (policy.StartDate >= firstDayOfMonth)
                    {
                        monthlyRevenue += policy.PremiumAmount;
                    }

                    // Yearly revenue (policies started this year)
                    if (policy.StartDate >= firstDayOfYear)
                    {
                        yearlyRevenue += policy.PremiumAmount;
                    }

                    // Revenue by type
                    var typeName = policy.PolicyType?.Name ?? "Bilinmeyen";
                    if (revenueByType.ContainsKey(typeName))
                    {
                        var (count, revenue) = revenueByType[typeName];
                        revenueByType[typeName] = (count + 1, revenue + policy.PremiumAmount);
                    }
                    else
                    {
                        revenueByType[typeName] = (1, policy.PremiumAmount);
                    }

                    // Revenue by company
                    var companyName = policy.InsuranceCompany?.Name ?? "Bilinmeyen";
                    if (revenueByCompany.ContainsKey(companyName))
                    {
                        var (count, revenue) = revenueByCompany[companyName];
                        revenueByCompany[companyName] = (count + 1, revenue + policy.PremiumAmount);
                    }
                    else
                    {
                        revenueByCompany[companyName] = (1, policy.PremiumAmount);
                    }
                }

                averagePremium = policies.Count > 0 ? totalPremiums / policies.Count : 0;
            }
            else
            {
                Snackbar.Add("Poliçe verileri yüklenirken hata oluştu", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task ExportReport(string format)
    {
        exporting = true;
        exportFormat = format;
        StateHasChanged();

        try
        {
            var parameters = new ReportParameters
            {
                StartDate = startDate,
                EndDate = endDate,
                CustomParameters = new Dictionary<string, object>
                {
                    { "DaysAhead", daysAhead }
                }
            };

            var reportData = await ReportingApi.ExportReportAsync("policy-expiry", parameters, format);

            if (reportData != null && reportData.Length > 0)
            {
                // In a real implementation, trigger browser download
                Snackbar.Add($"Rapor {format.ToUpper()} formatında dışa aktarıldı", MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add("Rapor oluşturulurken hata oluştu", MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            exporting = false;
            exportFormat = "";
            StateHasChanged();
        }
    }

    private async Task PrintReport()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yazdırma hatası: {ex.Message}", MudBlazor.Severity.Error);
        }
    }
}
