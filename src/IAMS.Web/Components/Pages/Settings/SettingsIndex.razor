@page "/settings"
@layout Layout.MainLayout
@attribute [Authorize]

@using IAMS.Application.Interfaces
@using IAMS.Application.Constants
@using IAMS.MultiTenancy.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ITenantContextAccessor TenantContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Ayarlar</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudText Typo="Typo.h4" GutterBottom="false">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-3" />
            Ayarlar
        </MudText>

        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Sistem ayarlarınızı buradan yönetebilirsiniz
        </MudText>

        <!-- Settings Cards -->
        <MudGrid>
            <!-- UI Preferences -->
            <MudItem xs="12" md="6">
                <MudCard Class="cursor-pointer" @onclick="@(() => NavigateTo("/settings/ui"))">
                    <MudCardContent>
                        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Large" Color="Color.Primary" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">Görünüm Tercihleri</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Liste görünümü ve kullanıcı arayüzü tercihleri
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- General Settings -->
            <MudItem xs="12" md="6">
                <MudCard Class="cursor-pointer" @onclick="@(() => NavigateTo("/settings/general"))">
                    <MudCardContent>
                        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Large" Color="Color.Primary" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">Genel Ayarlar</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Şirket bilgileri, e-posta ve bölgesel ayarlar
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- User Management -->
            <MudItem xs="12" md="6">
                <MudCard Class="cursor-pointer" @onclick="@(() => NavigateTo("/settings/users"))">
                    <MudCardContent>
                        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">Kullanıcı Yönetimi</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Kullanıcıları yönet, rol ve yetkiler ata
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Module Management -->
            <MudItem xs="12" md="6">
                <MudCard Class="cursor-pointer" @onclick="@(() => NavigateTo("/settings/modules"))">
                    <MudCardContent>
                        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Extension" Size="Size.Large" Color="Color.Primary" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">Modül Yönetimi</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Uygulama modüllerini etkinleştir veya devre dışı bırak
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Integration Settings (SuperAdmin Only) -->
            @if (IsSuperAdmin)
            {
                <MudItem xs="12" md="6">
                    <MudCard Class="cursor-pointer" @onclick="@(() => NavigateTo("/settings/integrations"))">
                        <MudCardContent>
                            <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.IntegrationInstructions" Size="Size.Large" Color="Color.Primary" />
                                <MudStack Spacing="1">
                                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.h6">Entegrasyon Ayarları</MudText>
                                        <MudChip T="String" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">Yalnızca SuperAdmin</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Üçüncü parti servisler ile entegrasyonları yönet
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }

        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private bool IsSuperAdmin { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Check if user has SuperAdmin role
        IsSuperAdmin = user.IsInRole(RoleNames.SuperAdmin);
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}
