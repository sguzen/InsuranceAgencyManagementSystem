@using IAMS.Application.Interfaces
@using IAMS.Shared.DTOs.Identity
@using IAMS.Application.Helpers
@inject IUsersApiClient UsersApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 70vh; overflow-y: auto;">
            <MudForm @ref="form" @bind-IsValid="@isValid">
                <MudStack Spacing="3">
                    <!-- Personal Information -->
                    <MudText Typo="Typo.h6" Class="mb-2">Kişisel Bilgiler</MudText>

                    <MudTextField @bind-Value="model.FirstName"
                                  Label="Ad"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Ad gereklidir" />

                    <MudTextField @bind-Value="model.LastName"
                                  Label="Soyad"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Soyad gereklidir" />

                    <MudTextField @bind-Value="model.Email"
                                  Label="E-posta"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  RequiredError="E-posta gereklidir" />

                    <MudTextField @bind-Value="model.PhoneNumber"
                                  Label="Telefon"
                                  Variant="Variant.Outlined" />

                    <!-- Password -->
                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Şifre Bilgileri</MudText>

                    <MudTextField @bind-Value="model.Password"
                                  Label="Şifre"
                                  Variant="Variant.Outlined"
                                  InputType="@passwordInputType"
                                  Required="true"
                                  RequiredError="Şifre gereklidir"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility" />

                    <MudTextField @bind-Value="model.ConfirmPassword"
                                  Label="Şifre Tekrar"
                                  Variant="Variant.Outlined"
                                  InputType="@passwordInputType"
                                  Required="true"
                                  RequiredError="Şifre tekrar gereklidir" />

                    @if (!string.IsNullOrEmpty(model.Password) && !string.IsNullOrEmpty(model.ConfirmPassword) && model.Password != model.ConfirmPassword)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">Şifreler eşleşmiyor</MudAlert>
                    }

                    <!-- Roles -->
                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Roller</MudText>

                    @if (availableRoles == null)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else if (!availableRoles.Any())
                    {
                        <MudAlert Severity="MudBlazor.Severity.Warning">Rol bulunamadı</MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var role in availableRoles)
                            {
                                var isSelected = model.Roles.Contains(role);
                                <MudCheckBox Value="@isSelected"
                                             Label="@role"
                                             Color="Color.Primary"
                                             ValueChanged="@((bool val) => OnRoleChanged(role, val))" />
                            }
                        </MudStack>
                    }

                    <!-- Status -->
                    <MudCheckBox @bind-Value="model.IsActive"
                                 Label="Aktif kullanıcı"
                                 Color="Color.Primary" />
                </MudStack>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!isValid || saving)">
            @if (saving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Kaydediliyor...</MudText>
            }
            else
            {
                <MudText>Kaydet</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private CreateUserDto model = new() { IsActive = true };
    private MudForm form = null!;
    private bool isValid;
    private bool saving;
    private List<string>? availableRoles;

    private bool showPassword = false;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        var result = await UsersApi.GetAllRolesAsync();
        if (result.IsSuccess && result.Data != null)
        {
            availableRoles = result.Data;
        }
        else
        {
            Snackbar.Add("Roller yüklenirken hata oluştu", MudBlazor.Severity.Error);
            availableRoles = new List<string>();
        }
    }

    private void OnRoleChanged(string role, bool isSelected)
    {
        if (isSelected)
        {
            if (!model.Roles.Contains(role))
            {
                model.Roles.Add(role);
            }
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        passwordInputType = showPassword ? InputType.Text : InputType.Password;
        passwordIcon = showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!isValid)
        {
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            Snackbar.Add("Şifreler eşleşmiyor", MudBlazor.Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var result = await UsersApi.CreateUserAsync(model);
            if (result.IsSuccess)
            {
                Snackbar.Add("Kullanıcı başarıyla oluşturuldu", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(result.Data));
            }
            else
            {
                if (result.Errors?.Any() == true)
                {
                    foreach (var error in result.Errors)
                    {
                        Snackbar.Add(error, MudBlazor.Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Kullanıcı oluşturulurken hata oluştu", MudBlazor.Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Beklenmeyen hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
