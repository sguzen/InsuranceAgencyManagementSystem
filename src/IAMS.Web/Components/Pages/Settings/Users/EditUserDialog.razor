@using IAMS.Application.Interfaces
@using IAMS.Shared.DTOs.Identity
@inject IUsersApiClient UsersApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 70vh; overflow-y: auto;">
            <MudForm @ref="form" @bind-IsValid="@isValid">
                <MudStack Spacing="3">
                    <!-- Personal Information -->
                    <MudText Typo="Typo.h6" Class="mb-2">Kişisel Bilgiler</MudText>

                    <MudTextField @bind-Value="model.FirstName"
                                  Label="Ad"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Ad gereklidir" />

                    <MudTextField @bind-Value="model.LastName"
                                  Label="Soyad"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Soyad gereklidir" />

                    <MudTextField @bind-Value="model.Email"
                                  Label="E-posta"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  RequiredError="E-posta gereklidir" />

                    <MudTextField @bind-Value="model.PhoneNumber"
                                  Label="Telefon"
                                  Variant="Variant.Outlined" />

                    <!-- Roles -->
                    <MudText Typo="Typo.h6" Class="mb-2 mt-4">Roller</MudText>

                    @if (availableRoles == null)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else if (!availableRoles.Any())
                    {
                        <MudAlert Severity="MudBlazor.Severity.Warning">Rol bulunamadı</MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var role in availableRoles)
                            {
                                var isSelected = model.Roles.Contains(role);
                                <MudCheckBox Value="@isSelected"
                                             Label="@role"
                                             Color="Color.Primary"
                                             ValueChanged="@((bool val) => OnRoleChanged(role, val))" />
                            }
                        </MudStack>
                    }

                    <!-- Status -->
                    <MudCheckBox @bind-Value="model.IsActive"
                                 Label="Aktif kullanıcı"
                                 Color="Color.Primary" />

                    <!-- Password Change -->
                    <MudDivider Class="my-4" />
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="Şifre Değiştir" IsExpanded="false">
                            <MudStack Spacing="3">
                                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                                    Şifreyi değiştirmek istemiyorsanız bu alanları boş bırakın
                                </MudAlert>

                                <MudTextField @bind-Value="newPassword"
                                              Label="Yeni Şifre"
                                              Variant="Variant.Outlined"
                                              InputType="@passwordInputType"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@passwordIcon"
                                              OnAdornmentClick="TogglePasswordVisibility" />

                                <MudTextField @bind-Value="confirmPassword"
                                              Label="Şifre Tekrar"
                                              Variant="Variant.Outlined"
                                              InputType="@passwordInputType" />

                                @if (!string.IsNullOrEmpty(newPassword) && !string.IsNullOrEmpty(confirmPassword) && newPassword != confirmPassword)
                                {
                                    <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">Şifreler eşleşmiyor</MudAlert>
                                }
                            </MudStack>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudStack>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!isValid || saving)">
            @if (saving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Kaydediliyor...</MudText>
            }
            else
            {
                <MudText>Kaydet</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public UserDto User { get; set; } = null!;

    private UpdateUserDto model = new();
    private MudForm form = null!;
    private bool isValid;
    private bool saving;
    private List<string>? availableRoles;

    private string? newPassword;
    private string? confirmPassword;
    private bool showPassword = false;
    private InputType passwordInputType = InputType.Password;
    private string passwordIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        // Initialize model from User parameter
        model = new UpdateUserDto
        {
            Id = User.Id,
            Email = User.Email,
            FirstName = User.FirstName,
            LastName = User.LastName,
            IsActive = User.IsActive,
            Roles = new List<string>(User.Roles)
        };

        await LoadRoles();
    }

    private async Task LoadRoles()
    {
        var result = await UsersApi.GetAllRolesAsync();
        if (result.IsSuccess && result.Data != null)
        {
            availableRoles = result.Data;
        }
        else
        {
            Snackbar.Add("Roller yüklenirken hata oluştu", MudBlazor.Severity.Error);
            availableRoles = new List<string>();
        }
    }

    private void OnRoleChanged(string role, bool isSelected)
    {
        if (isSelected)
        {
            if (!model.Roles.Contains(role))
            {
                model.Roles.Add(role);
            }
        }
        else
        {
            model.Roles.Remove(role);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        passwordInputType = showPassword ? InputType.Text : InputType.Password;
        passwordIcon = showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!isValid)
        {
            return;
        }

        // Only validate password if user is trying to change it
        if (!string.IsNullOrEmpty(newPassword) || !string.IsNullOrEmpty(confirmPassword))
        {
            if (string.IsNullOrEmpty(newPassword))
            {
                Snackbar.Add("Yeni şifre boş olamaz", MudBlazor.Severity.Warning);
                return;
            }

            if (string.IsNullOrEmpty(confirmPassword))
            {
                Snackbar.Add("Şifre tekrar boş olamaz", MudBlazor.Severity.Warning);
                return;
            }

            if (newPassword != confirmPassword)
            {
                Snackbar.Add("Şifreler eşleşmiyor", MudBlazor.Severity.Warning);
                return;
            }
        }

        saving = true;
        try
        {
            // Update user information
            var result = await UsersApi.UpdateUserAsync(model.Id, model);
            if (!result.IsSuccess)
            {
                if (result.Errors?.Any() == true)
                {
                    foreach (var error in result.Errors)
                    {
                        Snackbar.Add(error, MudBlazor.Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add(result.Message ?? "Kullanıcı güncellenirken hata oluştu", MudBlazor.Severity.Error);
                }
                saving = false;
                return;
            }

            // Change password only if provided
            if (!string.IsNullOrEmpty(newPassword))
            {
                var changePasswordDto = new ChangePasswordDto { NewPassword = newPassword };
                var passwordResult = await UsersApi.ChangePasswordAsync(model.Id, changePasswordDto);
                if (!passwordResult.IsSuccess)
                {
                    Snackbar.Add("Kullanıcı güncellendi ancak şifre değiştirilemedi", MudBlazor.Severity.Warning);
                }
                else
                {
                    Snackbar.Add("Kullanıcı ve şifre başarıyla güncellendi", MudBlazor.Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                    return;
                }
            }

            Snackbar.Add("Kullanıcı başarıyla güncellendi", MudBlazor.Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Beklenmeyen hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
