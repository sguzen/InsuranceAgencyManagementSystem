@* IAMS.Web/Components/Shared/ConfirmationDialog.razor *@
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Warning"
                         Color="@Color"
                         Style="font-size: 2rem;" />
                <MudText Typo="Typo.h6">Onay Gerekiyor</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">
                @ContentText
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="@Color"
                   Variant="Variant.Filled"
                   OnClick="Submit">
            @ButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string ContentText { get; set; } = "Bu işlemi gerçekleştirmek istediğinizden emin misiniz?";
    [Parameter] public string ButtonText { get; set; } = "Onayla";
    [Parameter] public Color Color { get; set; } = Color.Primary;

    void Submit() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}