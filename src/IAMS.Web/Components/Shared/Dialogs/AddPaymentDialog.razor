@using IAMS.Application.DTOs.Payment
@using IAMS.Application.DTOs.Policy
@using IAMS.Application.Interfaces
@using IAMS.Web.Services.ApiClient
@using IAMS.Domain.Enums
@using IAMS.Shared.QueryParams
@inject IPaymentsApiClient PaymentsApi
@inject IPoliciesApiClient PoliciesApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (EditMode && Payment != null)
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                    Ödeme düzenleme modu - Poliçe: @PolicyNumber
                </MudAlert>
            }
            else if (PolicyId.HasValue)
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                    Poliçe: @PolicyNumber
                </MudAlert>
            }

@*             @if (!PolicyId.HasValue)
            {
                <MudAutocomplete T="PolicyDto"
                                 Label="Poliçe Seçin"
                                 SearchFunc="@SearchPolicies"
                                 ToStringFunc="@(p => p?.PolicyNumber ?? "")"
                                 Required="true"
                                 RequiredError="Poliçe seçimi zorunludur"
                                 Variant="Variant.Outlined"
                                 Clearable="true">
                    <ItemTemplate Context="policy">
                        <MudStack Row Justify="Justify.SpaceBetween">
                            <MudText>@policy.PolicyNumber</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @policy.Customer?.FirstName @policy.Customer?.LastName
                            </MudText>
                        </MudStack>
                    </ItemTemplate>
                </MudAutocomplete>
            } *@

            <MudNumericField @bind-Value="model.Amount"
                             Label="Tutar"
                             Required="true"
                             RequiredError="Tutar zorunludur"
                             Min="0.01m"
                             Variant="Variant.Outlined"
                             Format="N2"
                             Adornment="Adornment.Start"
                             AdornmentText="@currencySymbol" />

            <MudDatePicker @bind-Date="paymentDate"
                           Label="Ödeme Tarihi"
                           Required="true"
                           RequiredError="Ödeme tarihi zorunludur"
                           Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy" />

            <MudDatePicker @bind-Date="dueDate"
                           Label="Vade Tarihi (İsteğe Bağlı)"
                           Variant="Variant.Outlined"
                           DateFormat="dd.MM.yyyy"
                           Clearable="true" />

            <MudSelect T="PaymentMethod"
                       @bind-Value="model.PaymentMethod"
                       Label="Ödeme Yöntemi"
                       Required="true"
                       Variant="Variant.Outlined">
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.Cash">Nakit</MudSelectItem>
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.CreditCard">Kredi Kartı</MudSelectItem>
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.BankTransfer">Banka Havalesi</MudSelectItem>
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.Cheque">Çek</MudSelectItem>
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.DebitCard">Banka Kartı</MudSelectItem>
                <MudSelectItem T="PaymentMethod" Value="PaymentMethod.OnlinePayment">Online Ödeme</MudSelectItem>
            </MudSelect>

            <MudSelect T="PaymentStatus"
                       @bind-Value="model.Status"
                       Label="Durum"
                       Required="true"
                       Variant="Variant.Outlined">
                <MudSelectItem T="PaymentStatus" Value="PaymentStatus.Pending">Bekliyor</MudSelectItem>
                <MudSelectItem T="PaymentStatus" Value="PaymentStatus.Completed">Tamamlandı</MudSelectItem>
                <MudSelectItem T="PaymentStatus" Value="PaymentStatus.Failed">Başarısız</MudSelectItem>
                <MudSelectItem T="PaymentStatus" Value="PaymentStatus.PartiallyPaid">Kısmi Ödendi</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="model.Reference"
                          Label="Referans Numarası (İsteğe Bağlı)"
                          Variant="Variant.Outlined"
                          MaxLength="100" />

            <MudTextField @bind-Value="model.Notes"
                          Label="Notlar (İsteğe Bağlı)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="1000" />

            @if (isSaving)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="isSaving">İptal</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="isSaving || !IsValid()">
            @(EditMode ? "Güncelle" : "Kaydet")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int? PolicyId { get; set; }
    [Parameter] public string? PolicyNumber { get; set; }
    [Parameter] public int? CurrencyId { get; set; }
    [Parameter] public string? CurrencySymbol { get; set; }
    [Parameter] public PolicyPaymentDto? Payment { get; set; }

    private CreatePolicyPaymentDto model = new();
    private PolicyDto? selectedPolicy;
    private DateTime? paymentDate = DateTime.Today;
    private DateTime? dueDate;
    private bool isSaving = false;
    private bool EditMode => Payment != null;
    private string currencySymbol = "₺";

    protected override void OnParametersSet()
    {
        // Set currency symbol from parameter or default
        if (!string.IsNullOrEmpty(CurrencySymbol))
        {
            currencySymbol = CurrencySymbol;
        }

        if (Payment != null)
        {
            // Edit mode - populate from existing payment
            model = new CreatePolicyPaymentDto
            {
                PolicyId = Payment.PolicyId,
                Amount = Payment.Amount,
                PaymentDate = Payment.PaymentDate,
                DueDate = Payment.DueDate,
                PaymentMethod = Payment.PaymentMethod,
                Status = Payment.Status,
                Reference = Payment.Reference,
                Notes = Payment.Notes,
                CurrencyId = CurrencyId ?? 0
            };

            paymentDate = Payment.PaymentDate;
            dueDate = Payment.DueDate;
        }
        else
        {
            // Create mode - initialize with defaults if model is not set
            if (model.PolicyId == 0 && PolicyId.HasValue)
            {
                model.PolicyId = PolicyId.Value;
            }

            // Set currency ID if provided
            if (CurrencyId.HasValue && model.CurrencyId == 0)
            {
                model.CurrencyId = CurrencyId.Value;
            }
        }
    }

    private async Task<IEnumerable<PolicyDto>> SearchPolicies(string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 2)
            return new List<PolicyDto>();

        try
        {
            var queryParams = new PolicyQueryParams
            {
                SearchTerm = searchText,
                PageSize = 10,
                Status = PolicyStatus.Active
            };

            //var result = await PoliciesApi.GetPoliciesAsync(1, 10, searchText);
            var result = await PoliciesApi.GetPoliciesAsync(queryParams);
            if (result.IsSuccess && result.Data != null)
            {
                return result.Data.Items;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching policies: {ex.Message}");
        }

        return new List<PolicyDto>();
    }

    private bool IsValid()
    {
        return (PolicyId.HasValue || selectedPolicy != null) &&
               model.Amount > 0 &&
               paymentDate.HasValue;
    }

    private async Task Submit()
    {
        if (!IsValid())
            return;

        isSaving = true;

        try
        {
            // Set policy ID and currency from selected policy if not already set
            if (!PolicyId.HasValue && selectedPolicy != null)
            {
                model.PolicyId = selectedPolicy.Id;
                model.CurrencyId = selectedPolicy.CurrencyId;
            }

            model.PaymentDate = paymentDate!.Value;
            model.DueDate = dueDate;

            if (EditMode && Payment != null)
            {
                // Update existing payment
                var updateDto = new UpdatePolicyPaymentDto
                {
                    Id = Payment.Id,
                    Amount = model.Amount,
                    PaymentDate = model.PaymentDate,
                    DueDate = model.DueDate,
                    PaymentMethod = model.PaymentMethod,
                    Status = model.Status,
                    Notes = model.Notes,
                    Reference = model.Reference
                };

                await PaymentsApi.UpdateAsync(updateDto);
                Snackbar.Add("Ödeme başarıyla güncellendi", MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                // Create new payment
                var result = await PaymentsApi.CreateAsync(model);
                if (result != null)
                {
                    Snackbar.Add("Ödeme başarıyla oluşturuldu", MudBlazor.Severity.Success);
                    MudDialog.Close(DialogResult.Ok(result));
                }
                else
                {
                    Snackbar.Add("Ödeme oluşturulurken hata oluştu", MudBlazor.Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
